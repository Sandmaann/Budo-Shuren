@using Microsoft.AspNetCore.Identity
@using BudoShurenWebsite.Data

@inject SignInManager<ApplicationUser> SignInManager
<div class="relative">
    @* <div class="z-10 font-yuji absolute start-0 top-12 w-full bg-white md:top-0"> *@
    <div class="font-yuji absolute start-0 top-12 w-full bg-white md:top-0">
        <div class="flex-1 items-center justify-center">
            <ul class="flex flex-row flex-wrap items-center justify-center px-4 py-2 transition">
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member" Match="NavLinkMatch.All">Profil</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Galerie" Match="NavLinkMatch.All">Galerie</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Kalender" Match="NavLinkMatch.All">Kalender</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Neuigkeiten" Match="NavLinkMatch.All">Neuigkeiten</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Aktuelles" Match="NavLinkMatch.All">Aktuelles</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Mitglieder" Match="NavLinkMatch.All">Mitglieder</NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Themen" Match="NavLinkMatch.All">Themen</NavLink>
                </li>

                <AuthorizeView Roles="Admin, Abteilungsleiter">
                    <Authorized>
                        <li class="nav-item px-3 py-1">
                            <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/NeueMitglieder" Match="NavLinkMatch.All">Neue Mitglieder</NavLink>
                        </li>
                    </Authorized>
                    <NotAuthorized>

                    </NotAuthorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized>
                        <li class="nav-item px-3 py-1">
                            <NavLink class="nav-link underline-offset-4 hover:underline" href="Account/Member/Admin" Match="NavLinkMatch.All">Admin</NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>

            </ul>
        </div>
    </div>
</div>

<style>
    .nav-item {
    }

    .nav-link {
    }

    .nav-item .nav-link.active {
        text-decoration: underline;
    }
</style>


@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
