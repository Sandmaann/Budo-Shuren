@page "/Account/ResetPasswordConfirmation"
<PageTitle>Passwort zurückgesetzt</PageTitle>

<div class="default-container">
    <Überschrift Titel="メンバーエリア" Untertitel="Bestätigt" />
    <SectionBanner Titel="Passwort zurückgesetzt" />

    <section>
        <div class="default-grid">
            <div id="local-container">
                <p>Ihr Passwort wurde erfolgreich zurückgesetzt.</p>
                <p>Bitte <a href="Account/Login">klicken Sie hier um sich einzuloggen</a>.</p>
            </div>
        </div>
    </section>
</div>

<style>
    #local-container {
        grid-column-start: 3;
        grid-column-end: 11;
    }
</style>