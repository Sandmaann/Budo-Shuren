@page "/Account/Password"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject ILogger<LoginPassword> Logger
@inject NavigationManager NavigationManager
@inject SignInManager<ApplicationUser> SignInManager
@inject SessionService SessionService


<PageTitle>Login</PageTitle>
<HeadContent>
    <meta name="description" content="Bestätige deinen Zugang mit Eingabe deines Passwortes um Zugriff auf den Mitgliederbereich zu erhalten.">
</HeadContent>

<Headline Titel="メンバーエリア" Untertitel="Login" />

<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="Mitgliederbereich" />
        <StatusMessage ShowAsError="true" Message="@errorMessage" />

        <div>
            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="loginUsername">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="password" class="font-ptsans tracking-[0.375rem] text-right text-sm font-normal leading-tight text-black">Passwort</label>
                <div class="mb-3">
                    <div id="capsLockWarning" style="display: none;">
                        <div class="text-error">
                            <Standardtext Text="Feststelltaste ist aktiv!" />
                        </div>
                    </div>
                    <InputText type="password" @bind-Value="Input.Password" class="font-ptsans w-full border border-black px-3 py-4 text-sm font-normal tracking-widest" autocomplete="current-password" aria-required="true" placeholder="Bitte gib dein Passwort ein." />
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="h-6 w-6" />
                        <span class="ml-2 mt-0.5">Eingeloggt bleiben</span>
                    </label>
                </div>

                <div class="mt-8 flex flex-wrap justify-between gap-y-2">
                    <button disabled="@LoginIsBusy" type="submit" class="font-yuji h-10 w-32 transform bg-black px-5 text-center text-sm font-normal leading-tight tracking-widest text-white transition duration-150 ease-in-out hover:bg-primary active:scale-90">
                        @if (LoginIsBusy)
                        {
                            <div class="flex flex-row items-center justify-between">
                                <div class="border-4 text-surface inline-block h-6 w-6 animate-spin rounded-full border-solid border-current border-e-transparent motion-reduce:animate-[spin_1.5s_linear_infinite] dark:text-white"
                                     role="status">
                                    <span class="!border-0 !absolute !-m-px !h-px !w-px !overflow-hidden !whitespace-nowrap !p-0 ![clip:rect(0,0,0,0)]">Sekunde ...</span>
                                </div>
                                <span class="ml-2">Lade</span>
                            </div>
                        }
                        else
                        {
                            <span class="flex-1 mx-3 text-center text-white">Login</span>
                        }
                    </button>
                    <div class="font-yuji flex h-10 transform items-center border border-black bg-white px-5 text-center text-sm font-normal leading-tight tracking-widest text-black transition duration-150 ease-in-out hover:bg-primary hover:text-white active:scale-90">
                        <a href="Account/ForgotPassword">Passwort vergessen?</a>
                    </div>
                </div>
                <div class="mt-10">
                    <p class="font-yuji text-sm leading-tight tracking-widest text-black hover:text-primary">
                        <a href="Account/Login">Zurück zum Login</a>
                    </p>
                </div>
            </EditForm>
        </div>
    </section>
</div>


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string errorMessage = string.Empty;
    private bool LoginIsBusy = false;
    private string Username { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        try
        {
            // Setze den Benutzernamen in der Sitzung
            Username = SessionService.GetUsername() ?? "";

            if (string.IsNullOrWhiteSpace(Username))
            {
                HandleBack();
            }
        }
        catch (NavigationException navi)
        {
            //Die NavigationException muss geworfen werden, damit der Redirect funktioniert
            throw navi;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load username from session");
            HandleBack();
        }
    }

    public async Task LoginUser()
    {
        if (LoginIsBusy)
            return;
        try
        {
            LoginIsBusy = true;

            var result = await SignInManager.PasswordSignInAsync(Username, Input.Password, Input.RememberMe, lockoutOnFailure: true);
            LoginIsBusy = false;

            if (result.Succeeded)
            {
                Logger.LogInformation("User logged in.");
                NavigationManager.NavigateTo("Account/Member");
            }
            else if (result.IsLockedOut)
            {
                Logger.LogWarning("User account locked out.");
                NavigationManager.NavigateTo("Account/Lockout");
            }
            else
            {
                Logger.LogInformation("Invalid login attempt.");
                errorMessage = "Wir konnten dich leider nicht anmelden. Ist dein Passwort korrekt?";
            }
        }
        catch (NavigationException navi)
        {
            //Die NavigationException muss geworfen werden, damit der Redirect funktioniert
            throw navi;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Anmelden");
            errorMessage = "Ein Fehler ist aufgetreten. Bitte versuche es später erneut.";
        }
        finally
        {
            LoginIsBusy = false;
        }
        await InvokeAsync(() => StateHasChanged());
    }

    private void HandleBack()
    {
        NavigationManager.NavigateTo("/Account/Login");
    }

    private sealed class InputModel
    {
        // [Required(ErrorMessage = Messages.EmailRequiredErrorMessage)]
        // [EmailAddress(ErrorMessage = Messages.EmailFormatErrorMessage)]
        // public string Email { get; set; } = "";

        [Required(ErrorMessage = Messages.PasswordRequiredErrorMessage)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Eingeloggt bleiben??")]
        public bool RememberMe { get; set; }
    }
}
