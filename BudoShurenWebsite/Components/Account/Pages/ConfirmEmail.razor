@page "/Account/ConfirmEmail"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BudoShurenWebsite.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory
@inject EmailSender EmailSender
@inject NavigationManager NavigationManager

<PageTitle>E-Mail best&auml;tigen</PageTitle>

<Überschrift Titel="メール確認" Untertitel="Bestätigen" />
<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="E-Mail Adresse bestätigen" />
        <div>
            @if (isSuccess)
            {
                <StatusMessage Message="Ihre E-Mail Adresse wurde erfolgreich bestätigt!" />
                <br />

                @if (isVerified)
                {
                    <Fließtext Text="Sie können sich jetzt einloggen." />
                }
                else
                {
                    <Fließtext Text="Ihr Zugang muss jetzt noch von einem Abteilungsleiter bestätigt werden!" />
                }
            }
            else
            {
                <StatusMessage ShowAsError="true" Message="Ihr E-Mail Adresse konnte leider nicht bestätigt werden!" />
            }
        </div>

    </section>
</div>

@code {
    private string? statusMessage;
    private bool isSuccess;
    private bool isVerified;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            statusMessage = $"Error loading user with ID {UserId}";
        }
        else
        {
            var previouslyConfirmed = await UserManager.IsEmailConfirmedAsync(user);

            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            isSuccess = result.Succeeded;
            isVerified = user.Verified;

            if (isSuccess && previouslyConfirmed)
            {
                //Info an den Abteilungsleiter schicken dass er einen Zugang aktivieren sollte
                using var context = ContextFactory.CreateDbContext();
                var abteilung = await context.Abteilungen.FirstOrDefaultAsync(x => x.ID == user.Abteilung);
                if (abteilung != null)
                {
                    string name = abteilung?.Abteilungsleiter?.Split(" ")[0] ?? "unbekannter Abteilungsleiter";

                    string infoAnAbteilungsleiter = $"Hallo {name}," +
                    Environment.NewLine +
                    "für deine Abteilung hat sich ein neuer Benutzer an der Budo-Shuren-Dojo Webseite registriert." +
                    Environment.NewLine +
                    $"Bitte prüfe doch, ob der zu deinen Leuten gehört und aktiviere seinen Zugang im Mitgliederbereich der Webseite." +
                    Environment.NewLine +
                    "Hier gehts zur Website: " + NavigationManager.BaseUri +
                    Environment.NewLine +
                    Environment.NewLine +
                    "よろしくお願いします";
                    //E-Mail an Abteilungsleiter senden
                    await EmailSender.SendPlainTextEmailAsync(abteilung.Email, "Neuer Benutzer in deiner Abteilung!", infoAnAbteilungsleiter);
                }
            }
        }
    }
}