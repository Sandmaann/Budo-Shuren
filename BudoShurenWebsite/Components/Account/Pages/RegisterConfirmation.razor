@page "/Account/RegisterConfirmation"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BudoShurenWebsite.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<RegisterConfirmation> Logger

@if (hasError == true)
{
    <PageTitle>Fehler</PageTitle>
    <Headline Titel="すみません" Untertitel="Fehler" />
}
else
{
    <PageTitle>Registrierung erfolgreich</PageTitle>
    <Headline Titel="有難うございます" Untertitel="Bestätigt" />
}

<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        @if (hasError == true)
        {
            <SectionBanner Titel="Es ist ein Fehler aufgetreten." />
        }
        else
        {
            <SectionBanner Titel="Dein Zugang wurde erstellt." />
        }

        <StatusMessage Message="@statusMessage" />
        @if (hasError == false)
        {
            <p class="font-ptsans text-sm tracking-wider">Wir haben dir eine <b>E-Mail</b> mit einem <b>Bestätigungslink</b> geschickt. </p>
            <p class="font-ptsans text-sm tracking-wider">Bitte überprüfe dein E-Mail Postfach und klicke auf diesen Link, um deine E-Mail Adresse zu verifizieren.</p>
            <p class="font-ptsans text-sm tracking-wider">Erst dann kann dein Zugang aktiviert werden!</p>
        }
    </section>
</div>

@code {
    // private string? emailConfirmationLink;
    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private bool isVerified { get; set; }
    private bool hasError { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Ermitteln ob der User erstellt wurde. Wenn nicht Fehler anzeigen. Ansonsten einfache Info dass eine E-Mail versendet wurde.
            if (Email is null)
            {
                RedirectManager.RedirectTo("");
            }

            var user = await UserManager.FindByEmailAsync(Email);
            if (user is null)
            {
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
                hasError = true;
                statusMessage = "Bei der Registrierung ist ein Fehler aufgetreten. Bitte versuche es erneut, oder wende dich direkt an deinen Abteilungsleiter.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Initialisieren der Registrierungsbestätigung.");
            hasError = true;
            statusMessage = "Bei der Registrierung ist ein Fehler aufgetreten. Bitte versuche es erneut, oder wende dich direkt an deinen Abteilungsleiter.";
        }
    }
}
