@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BudoShurenWebsite.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager


<PageTitle>E-Mail bestätigen</PageTitle>

@if (HasError)
{
    <Headline Titel="すみません" Untertitel="Bestätigen" />
}
else
{
    <Headline Titel="メール確認" Untertitel="Bestätigen" />
}


<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="E-Mail Adresse bestätigen" />
        <StatusMessage ShowAsError="@HasError" Message="@message" />
    </section>
</div>

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private bool HasError { get; set; } = false;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Entschuldigung, aber der Link zur Bestätigung der E-Mail Änderung ist ungültig.", HttpContext);
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            HasError = true;
            message = "Dein Benutzer konnte leider nicht gefunden werden!";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            HasError = true;
            message = "Es tut uns leid, aber bei der Änderung deiner E-Mail Adresse ist ein Problem aufgetreten.";
            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            HasError = true;
            message = "Es tut uns leid, aber bei der Änderung deines Benutzernamens ist ein Problem aufgetreten.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        HasError = false;
        message = "Vielen Dank dafür, dass du deine E-Mail Änderung bestätigt hast.";
        // message = "Thank you for confirming your email change.";
    }
}
