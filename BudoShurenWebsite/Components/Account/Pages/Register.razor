@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using BudoShurenWebsite.Data

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IDataService DataService

<PageTitle>Neuen Zugang erstellen</PageTitle>

<div class="default-container">
    @*     <div class="default-grid">
    <div class="grid-test-item">193</div>
    <div class="grid-test-item">302</div>
    <div class="grid-test-item">438</div>
    <div class="grid-test-item">518</div>
    <div class="grid-test-item">592</div>
    <div class="grid-test-item">759</div>
    <div class="grid-test-item">834</div>
    <div class="grid-test-item">928</div>
    <div class="grid-test-item">1008</div>
    <div class="grid-test-item">1138</div>
    <div class="grid-test-item">1248</div>
    <div class="grid-test-item">1440</div>
    </div> *@

    <Überschrift Titel="メンバーエリア" Untertitel="Registrierung" />
    <SectionBanner Titel="Neuen Zugang erstellen" />

    <section>
        <div class="default-grid">
            <div id="local-container">
                <StatusMessage Message="@Message" />
                <EditForm Model="Input" asp-route-returnUrl="@ReturnUrl" method="post" OnValidSubmit="RegisterUser" FormName="register">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" role="alert" />
                    <label for="email" class="form-label">E-Mail</label>
                    <p class="form-label">Bitte geben Sie die gleiche E-Mail Adresse wie bei Ihrer Anmeldung beim Verein an!</p>
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-Mail Adresse" />
                        <ValidationMessage For="() => Input.Email" class="text-danger" />
                    </div>

                    <label for="abteilung" class="form-label">Abteilung</label>
                    <div class="form-floating mb-3">
                        <InputSelect @bind-Value="Input.Abteilung" class="form-control" aria-required="true" placeholder="Abteilung">
                            @foreach(var abteilung in LocalData)
                            {
                                <option value="@abteilung.Name">@abteilung.Name - @abteilung.Abteilungsleiter</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Input.Abteilung" class="text-danger" />
                    </div>

                    <label for="password" class="form-label">Passwort</label>
                    <div class="form-floating mb-3">
                        <InputText type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Passwort" />
                        <ValidationMessage For="() => Input.Password" class="text-danger" />
                    </div>

                    <label class="form-label" for="confirm-password">Passwort best&auml;tigen</label>
                    <div class="form-floating mb-3">
                        <InputText type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Passwort best&auml;tigen" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
                    </div>
                    <button type="submit" class="default-button local-button">Zugang erstellen</button>
                </EditForm>
            </div>
        </div>
    </section>
</div>



<style>

