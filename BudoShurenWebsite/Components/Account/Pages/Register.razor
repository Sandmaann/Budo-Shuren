        padding: 1rem .75rem;
        width: 380px;
        font-family: "PT Sans";
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 1.4px;
    }

    label {
        display: inline-block;
    }

    .form-label {
        margin-bottom: .5rem;
        font-family: "PT Sans";
        font-size: 14px;
