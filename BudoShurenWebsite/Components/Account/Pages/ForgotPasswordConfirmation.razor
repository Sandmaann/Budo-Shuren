@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Passwort vergessen</PageTitle>


<div class="default-container">
    <Überschrift Titel="メンバーエリア" Untertitel="Passwort zurücksetzen" />
    <SectionBanner Titel="Passwort wird zurückgesetzt" />

    <section>
        <div class="default-grid">
            <div id="local-container">
                <p>Bitte überprüfen Sie Ihr E-Mail Postfach.</p>
                <p>Wenn Ihre Adresse korrekt war, haben wir Ihnen eine E-Mail mit allen weiteren Details zugesendet.</p>
            </div>
        </div>
    </section>
</div>

<style>
    #local-container {
        grid-column-start: 3;
        grid-column-end: 11;
    }
</style>