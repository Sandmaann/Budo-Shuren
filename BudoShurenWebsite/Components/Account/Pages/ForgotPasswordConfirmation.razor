@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Passwort vergessen</PageTitle>
<Headline Titel="パスワード" Untertitel="Passwort zurücksetzen" />
<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="Passwort wird zurückgesetzt" />
        <div>
            <div>
                <Standardtext Text="Dein Passwort wird zurückgesetzt." />
            </div>
            <div class="mt-2">
                <Standardtext Text="Bitte schau in dein E-Mail Postfach, wenn deine E-Mail Adresse korrekt war, haben wir dir eine E-Mail mit allen weiteren Details zugeschickt." />
            </div>
        </div>
    </section>
</div>

<style>
    #local-container {
        grid-column-start: 3;
        grid-column-end: 11;
    }
</style>