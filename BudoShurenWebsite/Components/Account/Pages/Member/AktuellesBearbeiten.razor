@page "/Account/Member/Aktuelles/Editor"
@page "/Account/Member/Aktuelles/Editor/{Id:int}"
@rendermode InteractiveServer

@using BudoShurenWebsite.Models
@using BudoShurenWebsite.Models.Enums
@using BudoShurenWebsite.Services
@using BudoShurenWebsite.Data
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@attribute [Authorize]

@inject IAktuellesService AktuellesService
@inject SlugService SlugService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ApplicationDbContext DbContext

<div class="container mx-auto max-w-screen-md">
    <div class="mx-10">
        <SectionBanner Titel="@(Id.HasValue ? "Beitrag bearbeiten" : "Neuen Beitrag erstellen")" />

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <StatusMessage ShowAsError="@_isError" Message="@_statusMessage" />
        }

        @if (_isLoading)
        {
            <Standardtext Text="Laden..." />
        }
        else
        {
            <div class="space-y-6">

                <!-- Metadaten -->
                <div class="rounded border border-gray-200 p-5">
                    <h4 class="font-ptsans mb-4 text-sm font-bold tracking-wider">Metadaten</h4>

                    <div class="space-y-4">
                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">Titel *</label>
                            <input type="text"
                                   value="@_beitrag.Titel"
                                   @oninput="OnTitelChanged"
                                   class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm"
                                   placeholder="Titel des Beitrags" />
                        </div>

                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">
                                URL-Slug *
                                <span class="ml-1 font-normal text-gray-500">(wird als /aktuelles/<em>slug</em> angezeigt)</span>
                            </label>
                            <div class="flex gap-2">
                                <input type="text"
                                       @bind="_beitrag.Slug"
                                       class="font-ptsans flex-1 rounded border border-gray-300 p-2 text-sm"
                                       placeholder="url-freundlicher-slug" />
                                <button type="button" @onclick="RegenerateSlug"
                                        class="font-ptsans rounded border border-gray-400 px-3 py-1 text-xs hover:bg-gray-100"
                                        title="Slug aus Titel neu generieren">
                                    ↺ Aus Titel
                                </button>
                            </div>
                        </div>

                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">Datum *</label>
                            <input type="date"
                                   value="@_beitrag.Datum.ToString("yyyy-MM-dd")"
                                   @onchange="OnDatumChanged"
                                   class="font-ptsans w-48 rounded border border-gray-300 p-2 text-sm" />
                        </div>

                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">Abteilung</label>
                            <select @bind="_beitrag.AbteilungId"
                                    class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm">
                                <option value="">Alle / Gesamtverein</option>
                                @foreach (var abt in _abteilungen)
                                {
                                    <option value="@abt.ID">@abt.Name</option>
                                }
                            </select>
                        </div>

                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">
                                SEO-Titel
                                <span class="ml-1 font-normal text-gray-500">(erscheint im Browser-Tab)</span>
                            </label>
                            <input type="text"
                                   @bind="_beitrag.MetaTitel"
                                   class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm"
                                   placeholder="Seitentitel für Suchmaschinen (empfohlen: 50–60 Zeichen)" />
                            <p class="font-ptsans mt-1 text-xs text-gray-400">@(_beitrag.MetaTitel?.Length ?? 0)/60 Zeichen</p>
                        </div>

                        <div>
                            <label class="font-ptsans mb-1 block text-xs font-bold">
                                SEO-Beschreibung
                                <span class="ml-1 font-normal text-gray-500">(erscheint in Suchergebnissen)</span>
                            </label>
                            <textarea @bind="_beitrag.MetaBeschreibung"
                                      class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm"
                                      rows="3"
                                      placeholder="Kurze Beschreibung des Beitrags (empfohlen: 150–160 Zeichen)"></textarea>
                            <p class="font-ptsans mt-1 text-xs text-gray-400">@(_beitrag.MetaBeschreibung?.Length ?? 0)/160 Zeichen</p>
                        </div>

                        <div class="flex items-center gap-3">
                            <input type="checkbox" id="veroeffentlicht" @bind="_beitrag.Veroeffentlicht" />
                            <label for="veroeffentlicht" class="font-ptsans cursor-pointer text-sm">
                                Beitrag veröffentlichen
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Block-Editor -->
                <div>
                    <div class="mb-3 flex items-center justify-between">
                        <h4 class="font-ptsans text-sm font-bold tracking-wider">Inhaltsblöcke</h4>
                        @if (_beitrag.Bloecke.Any())
                        {
                            <span class="font-ptsans text-xs text-gray-500">@_beitrag.Bloecke.Count Block(s)</span>
                        }
                    </div>

                    @if (!_beitrag.Bloecke.Any())
                    {
                        <div class="rounded border border-dashed border-gray-300 p-8 text-center">
                            <p class="font-ptsans text-sm text-gray-500">Noch keine Blöcke vorhanden. Füge unten einen Block hinzu.</p>
                        </div>
                    }

                    @foreach (var (block, index) in _beitrag.Bloecke.OrderBy(b => b.Sortierung).Select((b, i) => (b, i)))
                    {
                        <div class="mb-4" @key="block">
                            <!-- Block-Header -->
                            <div class="mb-0 flex items-center justify-between rounded-t border border-b-0 border-gray-300 bg-gray-50 px-3 py-2">
                                <span class="font-ptsans text-xs font-bold text-gray-600">
                                    @(block.Typ == AktuellesBlockTyp.MarkdownText ? "📝 Markdown-Text" : "🖼️ Bilder-Galerie")
                                </span>
                                <div class="flex gap-1">
                                    <button type="button" @onclick="() => MoveBlockUp(block)"
                                            disabled="@(index == 0)"
                                            class="rounded border border-gray-300 px-2 py-1 text-xs hover:bg-gray-200 disabled:opacity-30"
                                            title="Block nach oben">↑</button>
                                    <button type="button" @onclick="() => MoveBlockDown(block)"
                                            disabled="@(index == _beitrag.Bloecke.Count - 1)"
                                            class="rounded border border-gray-300 px-2 py-1 text-xs hover:bg-gray-200 disabled:opacity-30"
                                            title="Block nach unten">↓</button>
                                    <button type="button" @onclick="() => RemoveBlock(block)"
                                            class="rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50"
                                            title="Block entfernen">✕</button>
                                </div>
                            </div>
                            <!-- Block-Editor-Komponente -->
                            @switch (block.Typ)
                            {
                                case AktuellesBlockTyp.MarkdownText:
                                    <AktuellesMarkdownEditor Block="block" />
                                    break;
                                case AktuellesBlockTyp.BilderGalerie:
                                    <AktuellesBilderGalerieEditor Block="block" />
                                    break;
                            }
                        </div>
                    }

                    <!-- Block hinzufügen -->
                    <div class="mt-4">
                        <div class="mb-2">
                            <span class="font-ptsans text-xs font-semibold text-black">Block hinzufügen</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" @onclick="() => AddBlock(AktuellesBlockTyp.MarkdownText)"
                                    class="font-ptsans flex flex-col items-start rounded border border-gray-600 bg-white px-3 py-2 text-left text-xs hover:bg-gray-50">
                                <span class="font-semibold">+ 📝 Markdown-Text</span>
                                <span class="mt-0.5 font-normal text-gray-500">Formatierter Fließtext (Markdown)</span>
                            </button>
                            <button type="button" @onclick="() => AddBlock(AktuellesBlockTyp.BilderGalerie)"
                                    class="font-ptsans flex flex-col items-start rounded border border-gray-600 bg-white px-3 py-2 text-left text-xs hover:bg-gray-50">
                                <span class="font-semibold">+ 🖼️ Bilder-Galerie</span>
                                <span class="mt-0.5 font-normal text-gray-500">Bildergalerie mit optionaler Beschriftung</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Aktionsbuttons -->
                <div class="flex flex-wrap gap-3 border-t border-gray-200 pt-6 pb-12">
                    <button type="button" @onclick="Speichern"
                            disabled="@_isSaving"
                            class="font-ptsans rounded border border-black px-5 py-2 text-sm tracking-wider hover:bg-gray-100 disabled:opacity-50">
                        @(_isSaving ? "Speichern..." : "💾 Speichern")
                    </button>

                    @if (Id.HasValue && !string.IsNullOrWhiteSpace(_beitrag.Slug))
                    {
                        <button type="button" @onclick="VorschauOeffnen"
                                class="font-ptsans rounded border border-blue-400 px-5 py-2 text-sm tracking-wider text-blue-700 hover:bg-blue-50">
                            👁 Vorschau
                        </button>
                    }

                    <a href="/Account/Member/Aktuelles"
                       class="font-ptsans rounded border border-gray-400 px-5 py-2 text-sm tracking-wider hover:bg-gray-50">
                        Abbrechen
                    </a>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private AktuellesBeitrag _beitrag = new();
    private List<Abteilung> _abteilungen = new();
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _statusMessage = string.Empty;
    private bool _isError = false;
    private bool _slugManuallyEdited = false;

    protected override async Task OnInitializedAsync()
    {
        _abteilungen = await DbContext.Abteilungen.OrderBy(a => a.SortOrder).ToListAsync();

        if (Id.HasValue)
        {
            var existing = await AktuellesService.GetById(Id.Value);
            if (existing != null)
            {
                _beitrag = existing;
                _slugManuallyEdited = true;
            }
            else
            {
                _statusMessage = "Beitrag nicht gefunden.";
                _isError = true;
            }
        }
        else
        {
            _beitrag.Datum = DateTime.Now;
            _beitrag.Bloecke = new List<AktuellesBlock>();
        }

        _isLoading = false;
    }

    private void OnTitelChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _beitrag.Titel = e.Value?.ToString() ?? string.Empty;
        if (!_slugManuallyEdited || !Id.HasValue)
            _beitrag.Slug = SlugService.GenerateSlug(_beitrag.Titel);
    }

    private async Task RegenerateSlug()
    {
        var baseSlug = SlugService.GenerateSlug(_beitrag.Titel);
        var slug = baseSlug;
        var counter = 2;
        while (await AktuellesService.SlugExists(slug, Id))
        {
            slug = $"{baseSlug}-{counter}";
            counter++;
        }
        _beitrag.Slug = slug;
        _slugManuallyEdited = false;
    }

    private void OnDatumChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
            _beitrag.Datum = d;
    }

    private void AddBlock(AktuellesBlockTyp typ)
    {
        var maxSortierung = _beitrag.Bloecke.Any() ? _beitrag.Bloecke.Max(b => b.Sortierung) + 1 : 0;
        _beitrag.Bloecke.Add(new AktuellesBlock
        {
            Typ = typ,
            Sortierung = maxSortierung,
            BilderProReihe = 3,
            Bilder = new List<AktuellesBild>()
        });
    }

    private void RemoveBlock(AktuellesBlock block)
    {
        _beitrag.Bloecke.Remove(block);
        NormalizeSortierung();
    }

    private void MoveBlockUp(AktuellesBlock block)
    {
        var ordered = _beitrag.Bloecke.OrderBy(b => b.Sortierung).ToList();
        var index = ordered.IndexOf(block);
        if (index <= 0) return;
        var prev = ordered[index - 1];
        (block.Sortierung, prev.Sortierung) = (prev.Sortierung, block.Sortierung);
    }

    private void MoveBlockDown(AktuellesBlock block)
    {
        var ordered = _beitrag.Bloecke.OrderBy(b => b.Sortierung).ToList();
        var index = ordered.IndexOf(block);
        if (index >= ordered.Count - 1) return;
        var next = ordered[index + 1];
        (block.Sortierung, next.Sortierung) = (next.Sortierung, block.Sortierung);
    }

    private void NormalizeSortierung()
    {
        var ordered = _beitrag.Bloecke.OrderBy(b => b.Sortierung).ToList();
        for (int i = 0; i < ordered.Count; i++)
            ordered[i].Sortierung = i;
    }

    private async Task Speichern()
    {
        if (string.IsNullOrWhiteSpace(_beitrag.Titel))
        {
            _statusMessage = "Bitte gib einen Titel ein.";
            _isError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(_beitrag.Slug))
            _beitrag.Slug = SlugService.GenerateSlug(_beitrag.Titel);

        if (await AktuellesService.SlugExists(_beitrag.Slug, Id))
        {
            _statusMessage = "Dieser Slug wird bereits verwendet. Bitte einen anderen wählen.";
            _isError = true;
            return;
        }

        _isSaving = true;
        _statusMessage = string.Empty;

        try
        {
            NormalizeSortierung();
            await AktuellesService.Speichern(_beitrag);

            if (!Id.HasValue)
            {
                NavigationManager.NavigateTo($"/Account/Member/Aktuelles/Editor/{_beitrag.Id}");
                return;
            }

            _statusMessage = "Beitrag erfolgreich gespeichert.";
            _isError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Fehler beim Speichern: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task VorschauOeffnen()
    {
        if (Id.HasValue && !string.IsNullOrWhiteSpace(_beitrag.Slug))
            await JSRuntime.InvokeVoidAsync("open", $"/aktuelles/{_beitrag.Slug}", "_blank");
    }
}
