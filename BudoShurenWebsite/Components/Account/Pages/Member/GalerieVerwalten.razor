@if (SidebarOpenedOnce)
{
    <div>
        <SfSidebar Width="24rem" IsOpen="@SidebarIsVisible" Position="SidebarPosition.Right" Animate="true" ShowBackdrop="true">
            <ChildContent>
                <EditGalerie Einträge="@SelectedEinträge" OnClose="CloseSidebar" IsOpen="@SidebarIsVisible" />
            </ChildContent>
        </SfSidebar>
    </div>
}
<div class="container mx-auto">
    <div class="mx-auto max-w-screen-md">
        <div class="mx-10">
            <SectionBanner Titel="Galerie verwalten" />
        </div>
    </div>

    <div class="sticky top-16 z-50 bg-white pb-5">
        <div class="mx-auto max-w-screen-md">
            <div class="mx-10 flex flex-col">
                <div class="flex flex-row">
                    <div class="relative grow">
                        <button @onclick="Suche" aria-label="Suchen" class="absolute inset-y-0 left-0 flex transform items-center pl-3 transition duration-150 ease-in-out active:scale-90">
                            <span class="material-symbols-outlined">search</span>
                        </button>

                        @*                                                 <div class="!outline-none w-44 truncate border border-white bg-white px-9 py-2 pl-10 text-sm font-semibold text-black transition-all duration-1000 ease-out placeholder:tracking-widest focus:border focus:w-full focus:border-primary focus:ring-transparent sm:bg-transparent sm:pr-6">
                        <SfAutoComplete Width="auto" TValue="string" TItem="string" @bind-Value="@Suchtext" DataSource="@suchdata" Placeholder="Suche">
                        <AutoCompleteEvents TItem="string" TValue="string" ValueChange="@Suche"></AutoCompleteEvents>
                        </SfAutoComplete>
                        </div> *@

                        <InputText @bind-Value="Suchtext"
                                   @oninput="Suche"
                                   class="!outline-none w-44 truncate border border-white bg-white px-9 py-2 pl-10 text-sm font-semibold text-black transition-all duration-1000 ease-out placeholder:tracking-widest focus:border focus:w-full focus:border-primary focus:ring-transparent sm:bg-transparent sm:pr-6"
                                   placeholder="Suchen..." />
                    </div>
                    <div class="flex items-center justify-end">
                        <div class="w-28">
                            <SfMenu @ref="MenuObj" TValue="MenuItem" HamburgerMode="true" Title="@filterTetxt">
                                <MenuItems>
                                    <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                    <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                    <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                    <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                    <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                    <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                    <MenuItem Separator="true"></MenuItem>
                                    <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                </MenuItems>
                                <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                            </SfMenu>
                        </div>

                        @if (SelectionMode)
                        {
                            <div>
                                <SfMenu @ref="MenuObj2" TValue="MenuItem" HamburgerMode="true" Title="Bearbeiten">
                                    <MenuItems>
                                        <MenuItem Text="Ändern" IconCss="e-icons e-settings"></MenuItem>
                                        <MenuItem Text="Löschen" IconCss="e-icons e-cut"></MenuItem>
                                        <MenuItem Text="hochladen" IconCss="e-icons e-upload-1"></MenuItem>
                                    </MenuItems>
                                    <MenuEvents TValue="MenuItem" OnOpen="onOpen" ItemSelected="functionItemSelected"></MenuEvents>

                                    @* <MenuEvents TValue="MenuItem" OnClose="onClose" ItemSelected="itemSelected"></MenuEvents> *@
                                </SfMenu>
                            </div>

                            @*                             <button @onclick="BilderBearbeiten" aria-label="Ausgewählte Bilder ändern" class="font-yuji flex h-10 flex-row items-center justify-between px-5 text-center text-sm font-normal leading-tight tracking-widest text-black">
                        <span class="material-symbols-outlined mr-2">settings</span>
                        <span class="hidden md:inline-block">Ändern</span>
                        </button>
                        <button @onclick="BilderLöschen" aria-label="Bilder löschen" class="font-yuji flex h-10 flex-row items-center justify-between px-5 text-center text-sm font-normal leading-tight tracking-widest text-black">
                        <span class="material-symbols-outlined mr-2">delete_forever</span>
                        <span class="hidden md:inline-block">Löschen</span>
                        </button> *@
                        }
                        else
                        {
                            <button @onclick="BilderErstellen" aria-label="Bilder hochladen" class="font-yuji flex h-10 transform flex-row items-center justify-between px-5 text-center text-sm font-normal leading-tight tracking-widest text-black transition duration-150 ease-in-out active:scale-90">
                                <span class="material-symbols-outlined mr-2">upload</span>
                                <span class="hidden md:inline-block">hochladen</span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="z-10 mx-5 mt-5 2xl:-mx-40 3xl:-mx-72 4xl:-mx-112">
        <div>
            <Virtualize Items="Gruppen">
                <ItemContent>
                    <ImageGroup @key="context.ID" Gruppe="@context" OnSelectionChanged="SelectionChanged" />
                </ItemContent>
                <Placeholder>
                    <div class="flex justify-center">
                        <span class="m text-gray-400">Das ist ein Platzhalter.</span>
                    </div>
                </Placeholder>
                <EmptyContent>
                    <div class="flex justify-center">
                        @if (IsLoading)
                        {
                            <div class="flex flex-row items-center justify-center">
                                <div role="status" class="mr-5">
                                    <svg aria-hidden="true" class="h-8 w-8 animate-spin fill-blue-600 text-gray-200 dark:text-gray-600" viewBox="0 0 100 101" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" fill="currentColor" />
                                        <path d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" fill="currentFill" />
                                    </svg>
                                    <span class="sr-only">Loading...</span>
                                </div>
                                <span class="">Einen Moment, die Bilder werden geladen ...</span>
                            </div>
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <StatusMessage ShowAsError="true" Message="@errorMessage" />
                            }
                            else
                            {
                                <span class="m text-gray-400">Keine Einträge gefunden.</span>
                            }
                        }
                    </div>
                </EmptyContent>
            </Virtualize>
        </div>
    </div>
</div>


<style>
    .e-sidebar {
        background-color: #f8f8f8;
        color: black;
    }
</style>

@code {
    SfMenu<MenuItem> MenuObj;
    SfMenu<MenuItem> MenuObj2;

    string suchtext = string.Empty;
    private string errorMessage { get; set; } = string.Empty;
    private string Suchtext { get => suchtext; set { if (value != suchtext) { suchtext = value; Suche(); } } }

    private bool IsLoading { get; set; } = false;
    private bool SidebarIsVisible { get; set; } = false;

    //Sidebar ist offen beim Start, auch wenn false. Dieser Wert wird beim ersten setzen auf Visible auf true gesetzt.
    private bool SidebarOpenedOnce { get; set; } = false;

    private bool SelectionMode { get; set; } = false;

    private IEnumerable<GalerieEintrag> SelectedEinträge { get; set; } = new List<GalerieEintrag>();

    private List<GalerieEintrag> Einträge { get; set; } = new List<GalerieEintrag>();
    private ICollection<GalerieGruppe> Gruppen { get; set; } = new List<GalerieGruppe>();

    string menuItemName = string.Empty;

    private bool aikido { get; set; } = false;
    private bool bujinkan { get; set; } = false;
    private bool genbukan { get; set; } = false;
    private bool iaido { get; set; } = false;
    private bool jodo { get; set; } = false;
    private bool home { get; set; } = false;

    private bool hasfilter => aikido || bujinkan || genbukan || iaido || jodo || home;

    private string filterTetxt => hasfilter ? "Filter*" : "Filter";

    private string aikidoCssImage => aikido ? "e-icons e-check-large" : "e-icons";
    private string bujinkanCssImage => bujinkan ? "e-icons e-check-large" : "e-icons";
    private string genbukanCssImage => genbukan ? "e-icons e-check-large" : "e-icons";
    private string iaidoCssImage => iaido ? "e-icons e-check-large" : "e-icons";
    private string jodoCssImage => jodo ? "e-icons e-check-large" : "e-icons";
    private string homeCssImage => home ? "e-icons e-check-large" : "e-icons";

    bool cancelDropDownClose = false;

    bool iJustClosedYou_1 = false;

    private void onOpen(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (iJustClosedYou_1)
        {
            iJustClosedYou_1 = false;
            args.Cancel = true;
        }
    }
    private void onClose(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (cancelDropDownClose)
        {
            args.Cancel = true;
            cancelDropDownClose = false;
        }
    }

    private async void functionItemSelected(MenuEventArgs<MenuItem> args)
    {
        var selectedItem = args.Item.Text;

        if (selectedItem != "Filter")
        {
            switch (selectedItem)
            {
                case "Ändern":
                    await BilderBearbeiten();
                    await MenuObj2.CloseAsync();
                    break;
                case "Löschen":
                    await BilderLöschen();
                    await MenuObj2.CloseAsync();
                    break;
                case "hochladen":
                    await BilderErstellen();
                    await MenuObj2.CloseAsync();
                    break;
            }
        }
    }
    private void itemSelected(MenuEventArgs<MenuItem> args)
    {
        //Selected menu item
        var selectedItem = args.Item.Text;

        if (selectedItem != "Filter")
        {
            switch (selectedItem)
            {
                case "Aikido":
                    cancelDropDownClose = true;
                    aikido = !aikido;
                    Suche();
                    break;
                case "Bujinkan":
                    cancelDropDownClose = true;
                    bujinkan = !bujinkan;
                    Suche();
                    break;
                case "Genbukan":
                    cancelDropDownClose = true;
                    genbukan = !genbukan;
                    Suche();
                    break;
                case "Iaido":
                    cancelDropDownClose = true;
                    iaido = !iaido;
                    Suche();
                    break;
                case "Jodo":
                    cancelDropDownClose = true;
                    jodo = !jodo;
                    Suche();
                    break;
                case "Home":
                    cancelDropDownClose = true;
                    home = !home;
                    Suche();
                    break;
                case "Keine":
                    aikido = false;
                    bujinkan = false;
                    genbukan = false;
                    iaido = false;
                    jodo = false;
                    home = false;
                    cancelDropDownClose = false;
                    break;
                default:
                    cancelDropDownClose = false;
                    return;
            }
        }
        else
            cancelDropDownClose = false;
    }

    private async void CloseSidebar(bool result)
    {
        SidebarIsVisible = false;

        if (result)
        {
            //Daten neu laden um die neuen Bilder anzuzeigen
            await LoadData();
        }
    }

    private void SelectionChanged()
    {
        var preValue = SelectionMode;
        SelectionMode = Einträge?.Any(x => x.IsSelected) == true;

        if (SelectionMode != preValue)
        {
            Einträge?.ForEach(x => x.SelectionMode = SelectionMode);
        }
    }

    private async Task BilderBearbeiten()
    {
        var selectedEinträge = Einträge.Where(x => x.IsSelected)?.ToList();
        if (selectedEinträge?.Any() == true)
        {
            SelectedEinträge = selectedEinträge;
            SidebarOpenedOnce = true;
            SidebarIsVisible = true;
        }
    }

    private async Task BilderErstellen()
    {
        SelectedEinträge = new List<GalerieEintrag>();
        SidebarOpenedOnce = true;
        SidebarIsVisible = true;
    }

    private async Task BilderLöschen()
    {
        var selectedItems = Einträge.Where(x => x.IsSelected).ToList();
        if (selectedItems.Count == 0)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Keine Bilder ausgewählt.");
            return;
        }

        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Möchten Sie die ausgewählten Bilder wirklich löschen?");
        bool error = false;
        if (confirm)
        {
            foreach (var item in selectedItems)
            {
                var dbItem = await DbContext.Galerie.FindAsync(item.ID);
                if (dbItem != null)
                {
                    try
                    {
                        DbContext.Galerie.Remove(dbItem);
                        await DbContext.SaveChangesAsync();

                        //Datei löschen!
                        if (!string.IsNullOrWhiteSpace(dbItem.ImagePath) && File.Exists(dbItem.ImagePath))
                            File.Delete(dbItem.ImagePath);
                    }
                    catch (Exception e)
                    {
                        //TODO Logging
                        error = true;
                    }
                }
            }
            await LoadData();
            if (error)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Einige Bilder konnten nicht gelöscht werden.");
            }
        }
    }

    private void Suche()
    {
        IEnumerable<GalerieEintrag> gefilterteEinträge;
        if (string.IsNullOrWhiteSpace(Suchtext) &&
        !aikido && bujinkan && !genbukan && !iaido && !jodo && !home)
        {
            gefilterteEinträge = Einträge;
            // // Wenn der Suchtext leer ist, zeigen Sie alle Einträge an
            // Gruppen = Einträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
        }
        else
        {
            // Wenn der Suchtext nicht leer ist, filtern Sie die Einträge

            // bool aikido = Suchtext.Contains("aikido", StringComparison.OrdinalIgnoreCase);
            gefilterteEinträge = new List<GalerieEintrag>();

            if (!string.IsNullOrWhiteSpace(suchtext))
            {
                gefilterteEinträge = Einträge.Where(x =>
                x.Titel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                x.Untertitel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                x.Beschreibung?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true);
            }
            if (aikido)
            {
                gefilterteEinträge = Einträge.Where(x => x.Aikido);
            }
            if (bujinkan)
            {
                gefilterteEinträge = Einträge.Where(x => x.Bujinkan);
            }
            if (genbukan)
            {
                gefilterteEinträge = Einträge.Where(x => x.Genbukan);
            }
            if (iaido)
            {
                gefilterteEinträge = Einträge.Where(x => x.Iaido);
            }
            if (jodo)
            {
                gefilterteEinträge = Einträge.Where(x => x.Jodo);
            }
            if (home)
            {
                gefilterteEinträge = Einträge.Where(x => x.Home);
            }
        }

        var groups = gefilterteEinträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
        var gruppen = new List<GalerieGruppe>();
        foreach (var group in groups.OrderByDescending(x => x.Key))
        {
            var neueGruppe = new GalerieGruppe
                {
                    Datum = group.Key,
                    Items = group.ToList()
                };
            gruppen.Add(neueGruppe);
        }
        Gruppen = gruppen;
    }

    private async Task LoadData()
    {
        try
        {
            if (IsLoading)
                return;

            IsLoading = true;

            await Task.Delay(10);

            var einträge = await DbContext.Galerie.ToListAsync();
            einträge.ForEach(x => x.EnvironmentPath = environment.ContentRootPath);

            var groups = einträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
            var gruppen = new List<GalerieGruppe>();
            foreach (var group in groups.OrderByDescending(x => x.Key))
            {
                var neueGruppe = new GalerieGruppe
                    {
                        Datum = group.Key,
                        Items = group.ToList()
                    };
                gruppen.Add(neueGruppe);
            }

            Einträge = einträge;
            Gruppen = gruppen;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden der Daten: {ex.Message}";
            // Handle other exceptions here
        }
        finally
        {
            IsLoading = false;
            SelectionChanged();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        SidebarIsVisible = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadData();

            var scrollPosition = await SessionStorage.GetAsync<int>("scrollPosition");
            if (scrollPosition.Success)
            {
                await JSRuntime.InvokeVoidAsync("setScrollPosition", scrollPosition.Value);
            }

            await JSRuntime.InvokeVoidAsync("saveScrollPositionOnUnload", DotNetObjectReference.Create(this));

            var lDotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("GLOBAL.SetDotnetReference", lDotNetReference);
        }

        // if (!firstRender)
        // {
        //     var scrollPosition = await JSRuntime.InvokeAsync<int>("getScrollPosition");
        //     await SessionStorage.SetAsync("scrollPosition", scrollPosition);
        // }
    }

    public string[] suchdata = { "Aikido", "Bujinkan", "Genbukan", "Iaido", "Jodo", "Home" };


    [JSInvokable]
    public async Task SaveScrollPosition(int scrollPosition)
    {
        await SessionStorage.SetAsync("scrollPosition", scrollPosition);
    }

    [JSInvokable("HamburgerMenu")]
    public void documentClick()
    {
        if (MenuObj != null)
        {
            iJustClosedYou_1 = true;
            MenuObj.CloseAsync();
            MenuObj2.CloseAsync();
            StateHasChanged();
        }
    }
}