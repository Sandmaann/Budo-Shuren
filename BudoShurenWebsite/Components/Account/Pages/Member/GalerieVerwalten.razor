                                                        </MenuItems>
                                                    </MenuItem>
                                                </MenuItems>
                                                <MenuEvents TValue="MenuItem" OnOpen="onOpen" ItemSelected="functionItemSelected"></MenuEvents>
                                            </SfMenu>
                                        }
                                    </div>

                                    <div class="flex flex-row items-center md:hidden">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Öffentlich" IconCss="@öffentlichCssImage"></MenuItem>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                        @if (CanEdit)
                                        {
                                            <SfMenu TValue="MenuItem" HamburgerMode="false" Title="" ShowItemOnClick="true">
                                                <MenuItems>
                                                    <MenuItem Text="" IconCss="e-icons e-menu">
                                                        <MenuItems>
                                                            <MenuItem Text="Ändern" IconCss="e-icons e-settings"></MenuItem>
                                                            <MenuItem Text="Löschen" IconCss="e-icons e-cut"></MenuItem>
                                                            <MenuItem Text="hochladen" IconCss="e-icons e-upload-1"></MenuItem>
                                                        </MenuItems>
                                                    </MenuItem>
                                                </MenuItems>
                                                <MenuEvents TValue="MenuItem" OnOpen="onOpen" ItemSelected="functionItemSelected"></MenuEvents>
                                            </SfMenu>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="hidden flex-row items-center md:flex">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="@filterText" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Öffentlich" IconCss="@öffentlichCssImage"></MenuItem>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>
                                    <div class="flex flex-row items-center md:hidden">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Öffentlich" IconCss="@öffentlichCssImage"></MenuItem>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>
                                    @if (CanEdit)
                                    {
                                        <button @onclick="BilderErstellen"
                                                aria-label="Bilder hochladen"
                                                class="font-yuji flex h-10 transform flex-row items-center justify-between px-4 text-center text-sm font-normal leading-tight tracking-widest text-black transition duration-150 ease-in-out active:scale-90">
                                            <span class="material-symbols-outlined mr-2">upload</span>
                                            <span class="hidden md:inline-block">hochladen</span>
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="z-10 mx-10 mt-5">
                <div>
                    <Virtualize Items="Gruppen">
                        <ItemContent>
                            <ImageGroup @key="context.ID" Gruppe="@context" OnSelectionChanged="SelectionChanged" IsScrolling="isScrolling" />
                        </ItemContent>
                        <Placeholder>
                            <div class="flex justify-center">
                                <span class="m text-gray-400">Das ist ein Platzhalter.</span>
                            </div>
                        </Placeholder>
                        <EmptyContent>
                            <div class="flex justify-center">
                                @if (IsLoading)
                                {
                                    <Spinner Text="Einen Moment, die Bilder werden geladen ..." />
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                                    {
                                        <StatusMessage ShowAsError="true" Message="@errorMessage" />
                                    }
                                    else
                                    {
                                        <span class="m text-gray-400">Keine Einträge gefunden.</span>
                                    }
                                }
                            </div>
                        </EmptyContent>
                    </Virtualize>
                </div>
            </div>
        </div>
    </div>

    <div id="slideover-container" class="invisible fixed inset-0 z-50 h-full w-full">
        <div id="slideover-bg" class="opacity-0 absolute inset-0 h-full w-full bg-gray-900 transition-all duration-500 ease-out"></div>
        <div onclick="" id="slideover" class="absolute right-0 h-full w-96 translate-x-full overflow-auto bg-white transition-all duration-300 ease-out">
            <EditGalerie @ref="editGalerie" Einträge="@SelectedEinträge" OnClose="CloseSidebar" IsOpen="@SidebarIsVisible" />
        </div>
    </div>
</div>

<style>
    .e-menu-item {
        font-size: 1rem;
    }

    .e-menu-container .e-ul .e-menu-item {
        margin-top: 0.25rem;
        margin-bottom: 0.25rem;
        font-size: 1rem;
    }
</style>


@code {
    [AllowNull]
    EditGalerie editGalerie;

    string suchtext = string.Empty;
    private string errorMessage { get; set; } = string.Empty;
    private string Suchtext { get => suchtext; set { if (value != suchtext) { suchtext = value; Suche(); } } }

    private bool IsLoading { get; set; } = false;
    private bool SidebarIsVisible { get; set; } = false;

    private bool SelectionMode { get; set; } = false;
    int selectedEinträgeCount { get; set; }

    private IEnumerable<GalerieEintrag> SelectedEinträge { get; set; } = new List<GalerieEintrag>();

    private List<GalerieEintrag> Einträge { get; set; } = new List<GalerieEintrag>();
    private ICollection<GalerieGruppe> Gruppen { get; set; } = new List<GalerieGruppe>();

    string menuItemName = string.Empty;

    private bool isScrolling { get; set; } = false;


    private bool aikido { get; set; } = false;
    private bool bujinkan { get; set; } = false;
    private bool genbukan { get; set; } = false;
    private bool iaido { get; set; } = false;
    private bool jodo { get; set; } = false;
    private bool home { get; set; } = false;
    private bool öffentlich { get; set; } = false;

    private bool hasfilter => aikido || bujinkan || genbukan || iaido || jodo || home || öffentlich;

    private string filterText => hasfilter ? "Filter*" : "Filter";

    private string aikidoCssImage => aikido ? "e-icons e-check-large" : "e-icons";
    private string bujinkanCssImage => bujinkan ? "e-icons e-check-large" : "e-icons";
    private string genbukanCssImage => genbukan ? "e-icons e-check-large" : "e-icons";
    private string iaidoCssImage => iaido ? "e-icons e-check-large" : "e-icons";
    private string jodoCssImage => jodo ? "e-icons e-check-large" : "e-icons";
    private string homeCssImage => home ? "e-icons e-check-large" : "e-icons";
    private string öffentlichCssImage => öffentlich ? "e-icons e-check-large" : "e-icons";

    private bool CanEdit { get; set; } = false;

    bool cancelDropDownClose = false;

    bool iJustClosedYou_1 = false;

    private async Task SetPermissions()
    {
        try
        {
            await UserService.InitializeAsync();
            var user = UserService.CurrentUser;
            if (Global.Roles.IsEditor(user.Roles) || Global.Roles.IsAbteilungsleiter(user.Roles) || Global.Roles.IsAdmin(user.Roles))
            {
                CanEdit = true;
            }
            else
            {
                CanEdit = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim setzen der Berechtigungen");
            CanEdit = false;
        }
    }

    private void onOpen(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (iJustClosedYou_1)
        {
            iJustClosedYou_1 = false;
            args.Cancel = true;
        }
    }
    private void onClose(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (cancelDropDownClose)
        {
            args.Cancel = true;
            cancelDropDownClose = false;
        }
    }

    private async void functionItemSelected(MenuEventArgs<MenuItem> args)
    {
        if (CanEdit == false)
            return;
        var selectedItem = args.Item.Text;

        if (selectedItem != "Filter")
        {
            switch (selectedItem)
            {
                case "Ändern":
                    await BilderBearbeiten();
                    break;
                case "Löschen":
                    await BilderLöschen();
                    break;
                case "hochladen":
                    await BilderErstellen();
                    break;
            }
        }
    }
    private void itemSelected(MenuEventArgs<MenuItem> args)
    {
        //Selected menu item
        var selectedItem = args.Item.Text;

        if (selectedItem != "Filter")
        {
            switch (selectedItem)
            {
                case "Aikido":
                    cancelDropDownClose = true;
                    aikido = !aikido;
                    Suche();
                    break;
                case "Bujinkan":
                    cancelDropDownClose = true;
                    bujinkan = !bujinkan;
                    Suche();
                    break;
                case "Genbukan":
                    cancelDropDownClose = true;
                    genbukan = !genbukan;
                    Suche();
                    break;
                case "Iaido":
                    cancelDropDownClose = true;
                    iaido = !iaido;
                    Suche();
                    break;
                case "Jodo":
                    cancelDropDownClose = true;
                    jodo = !jodo;
                    Suche();
                    break;
                case "Home":
                    cancelDropDownClose = true;
                    home = !home;
                    Suche();
                    break;
                case "Öffentlich":
                    cancelDropDownClose = true;
                    öffentlich = !öffentlich;
                    Suche();
                    break;
                case "Keine":
                    aikido = false;
                    bujinkan = false;
                    genbukan = false;
                    iaido = false;
                    jodo = false;
                    home = false;
                    öffentlich = false;
                    cancelDropDownClose = false;
                    Suche();
                    break;
                default:
                    cancelDropDownClose = false;
                    return;
            }
        }
        else
            cancelDropDownClose = false;
    }

    private async void CloseSidebar(bool result)
    {
        try
        {

            // SidebarIsVisible = !SidebarIsVisible;
            await toggleSlideoverBlazor();
            // SidebarIsVisible = false;
            if (result)
            {
                //Daten neu laden um die neuen Bilder anzuzeigen
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Schließen des Slideover");
        }
    }

    private void SelectionChanged()
    {
        var preValue = SelectionMode;
        selectedEinträgeCount = Einträge?.Where(x => x.IsSelected)?.Count() ?? 0;
        SelectionMode = selectedEinträgeCount > 0;

        if (SelectionMode != preValue)
        {
            Einträge?.ForEach(x => x.SelectionMode = SelectionMode);
        }
    }

    private async Task BilderBearbeiten()
    {
        try
        {

            var selectedEinträge = Einträge.Where(x => x.IsSelected)?.ToList();
            if (selectedEinträge?.Any() == true)
            {
                SelectedEinträge = selectedEinträge;
                await toggleSlideoverBlazor();
                await editGalerie.Clear();
                editGalerie.SetData(SelectedEinträge);

            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Bearbeiten der Bilder");
        }
    }

    private async Task BilderErstellen()
    {
        try
        {
            if (CanEdit == false)
                return;

            SelectedEinträge = new List<GalerieEintrag>();
            await toggleSlideoverBlazor();
            await editGalerie.Clear();
            editGalerie.SetData(SelectedEinträge);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Erstellen der Bilder");
        }
    }



    private async Task BilderLöschen()
    {
        try
        {

            var selectedItems = Einträge.Where(x => x.IsSelected).ToList();
            if (selectedItems.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Keine Bilder ausgewählt.");
                return;
            }

            var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Möchtest du alle {selectedItems.Count} ausgewählten Bilder wirklich löschen?");
            bool error = false;
            if (confirm)
            {
                foreach (var item in selectedItems)
                {
                    var dbItem = await DbContext.Galerie.FindAsync(item.ID);
                    if (dbItem != null)
                    {
                        var dbImage = await DbContext.Images.FindAsync(dbItem.DbImageId);
                        try
                        {
                            DbContext.Galerie.Remove(dbItem);
                            if (dbImage != null)
                            {
                                DbContext.Images.Remove(dbImage);
                                var relatedRecords = DbContext.Neuigkeiten.Where(n => n.DbImageId == dbImage.Id);
                                DbContext.Neuigkeiten.RemoveRange(relatedRecords);
                            }

                            await DbContext.SaveChangesAsync();

                            // //Datei löschen!
                            // if (!string.IsNullOrWhiteSpace(dbItem.ImagePath) && File.Exists(dbItem.ImagePath))
                            //     File.Delete(dbItem.ImagePath);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, $"Fehler beim Löschen des Bildes {dbItem.ID}");
                            error = true;
                        }
                    }
                }
                await LoadData();
                if (error)
                {
                    await JSRuntime.InvokeVoidAsync("alert", "Einige Bilder konnten nicht gelöscht werden.");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Löschen der Bilder");
        }
    }

    private void auswahlAufheben()
    {
        Einträge?.ForEach(x => x.IsSelected = false);
        SelectionChanged();
    }

    private void Suche()
    {
        try
        {

            IEnumerable<GalerieEintrag> gefilterteEinträge;
            if (string.IsNullOrWhiteSpace(Suchtext) &&
            !aikido && bujinkan && !genbukan && !iaido && !jodo && !home && !öffentlich)
            {
                gefilterteEinträge = Einträge;
            }
            else
            {
                // Wenn der Suchtext nicht leer ist, filtern Sie die Einträge
                gefilterteEinträge = Einträge;

                if (!string.IsNullOrWhiteSpace(suchtext))
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x =>
                    x.Titel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                    x.Untertitel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                    x.Beschreibung?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true);
                }
                if (aikido)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Aikido);
                }
                if (bujinkan)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Bujinkan);
                }
                if (genbukan)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Genbukan);
                }
                if (iaido)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Iaido);
                }
                if (jodo)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Jodo);
                }
                if (home)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Home);
                }
                if (öffentlich)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Öffentlich);
                }
            }

            var groups = gefilterteEinträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
            var gruppen = new List<GalerieGruppe>();
            foreach (var group in groups.OrderByDescending(x => x.Key))
            {
                var neueGruppe = new GalerieGruppe
                    {
                        Datum = group.Key,
                        Items = group.ToList()
                    };
                gruppen.Add(neueGruppe);
            }
            Gruppen = gruppen;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden der Daten: {ex.Message}";
            // Handle other exceptions here
        }
        finally
        {
            SelectionChanged();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        try
        {
            if (IsLoading)
                return;

            IsLoading = true;

            await Task.Delay(10);

            var einträge = await DbContext.Galerie.ToListAsync();
            await BildVarianten.KachelMasseSetzenAsync(einträge);
            // einträge.ForEach(x => x.EnvironmentPath = environment.ContentRootPath);

            var groups = einträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
            var gruppen = new List<GalerieGruppe>();
            foreach (var group in groups.OrderByDescending(x => x.Key))
            {
                var neueGruppe = new GalerieGruppe
                    {
                        Datum = group.Key,
                        Items = group.ToList()
                    };
                gruppen.Add(neueGruppe);
            }

            Einträge = einträge;
            Gruppen = gruppen;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Laden der Bilder");
            errorMessage = $"Fehler beim Laden der Daten: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            SelectionChanged();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SetPermissions();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadData();

            try
            {
                var scrollPosition = await SessionStorage.GetAsync<int>("scrollPosition");
                if (scrollPosition.Success)
                {
                    await JSRuntime.InvokeVoidAsync("setScrollPosition", scrollPosition.Value);
                }

                await JSRuntime.InvokeVoidAsync("saveScrollPositionOnUnload", DotNetObjectReference.Create(this));
            }
            catch
            {
                // ignored
            }

            await JSRuntime.InvokeVoidAsync("registerScrolling", DotNetObjectReference.Create(this));
        }
        if (!firstRender)
        {
            try
            {
                var scrollPosition = await JSRuntime.InvokeAsync<int>("getScrollPosition");
                await SessionStorage.SetAsync("scrollPosition", scrollPosition);
            }
            catch
            {
                // ignored
            }
