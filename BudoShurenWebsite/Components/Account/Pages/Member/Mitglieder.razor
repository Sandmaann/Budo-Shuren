@page "/Account/Member/Mitglieder"
@rendermode InteractiveServer

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IdentityUserAccessor UserAccessor
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<Mitglieder> Logger
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject EmailSender EmailSender

@using BudoShurenWebsite.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore;

@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor

<div class="container mx-auto max-w-screen-lg">
    <div class="mx-10">
        <SectionBanner Titel="Mitglieder verwalten" />

        <div class="-mx-8 md:mx-0">

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <StatusMessage ShowAsError="true" Message="@errorMessage" />
            }

            <SfGrid TValue="UserWithRoles" AllowSorting="true" AllowPaging="true" Toolbar="@(new List<string>() { "Edit", "Delete", "Search" })" Height="100%" Width="100%">
                <SfDataManager AdaptorInstance="@typeof(MitgliederAdaptor)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridEditSettings AllowEditOnDblClick="@AllowEditing" AllowEditing="@AllowEditing" AllowDeleting="@AllowDeletion" Mode="@EditMode.Dialog" ShowDeleteConfirmDialog="true" />
                <GridEvents TValue="UserWithRoles" OnActionFailure="OnActionFailureHandler" OnLoad="OnLoadHandler" DataBound="DataBoundHandler"></GridEvents>

                <GridTemplates>
                    <EmptyRecordTemplate>
                        @if (IsLoading)
                        {
                            <Standardtext Text="Es wird nach Mitgliedern gesucht..." />
                        }
                        else
                        {
                            <Standardtext Text="Hopla, wo sind denn alle hin?" />
                        }
                    </EmptyRecordTemplate>
                </GridTemplates>

                <GridColumns>
                    <GridColumn Visible="AllowEditing" Field=@nameof(UserWithRoles.Verified) HeaderText="" Width="120" AllowEditing="false">
                        <Template>
                            @{
                                UserWithRoles user = (context as UserWithRoles)!;
                                <button @onclick="(args) => userDeaktivierenClick(args,user)" class="font-yuji h-8 transform bg-transparent px-2 text-center font-normal leading-tight tracking-widest text-white transition duration-150 ease-in-out hover:bg-error active:scale-90">
                                    <span class="text-center text-xs text-black">Deaktivieren</span>
                                </button>
                            }
                        </Template>
                        <EditTemplate>
                        </EditTemplate>
                    </GridColumn>

                    <GridColumn Field=@nameof(UserWithRoles.Vorname) HeaderText="Vorname" AllowSearching="true" Width="120"></GridColumn>
                    <GridColumn Field=@nameof(UserWithRoles.Name) HeaderText="Nachname" AllowSearching="true" Width="150"></GridColumn>
                    <GridColumn Field=@nameof(UserWithRoles.UserName) AllowEditing="false" AllowSearching="true" IsPrimaryKey="true" HeaderText="E-Mail Adresse" Width="150"></GridColumn>
                    <GridColumn Field=@nameof(UserWithRoles.Abteilung) HeaderText="Abteilung" AllowSearching="true" Width="100" EditType="EditType.DropDownEdit">
                        <EditTemplate>
                            <SfDropDownList ID="Abteilung" TValue="string" TItem="string"
                                            Placeholder="Abteilung"
                                            FloatLabelType="FloatLabelType.Always"
                                            DataSource="@AbteilungenText" @bind-Value="@((context as UserWithRoles).Abteilung)">
                                <DropDownListFieldSettings Value="Abteilung"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field=@nameof(UserWithRoles.Rolle) HeaderText="Rolle" AllowSearching="true" Width="120">
                        <EditTemplate>
                            <SfDropDownList ID="Rolle" TValue="string" TItem="string" Enabled="@AllowRoles"
                                            Placeholder="Rolle"
                                            FloatLabelType="FloatLabelType.Always"
                                            DataSource="@Rollen" @bind-Value="@((context as UserWithRoles).Rolle)">
                                <DropDownListFieldSettings Value="Rolle"></DropDownListFieldSettings>
                            </SfDropDownList>
                        </EditTemplate>
                    </GridColumn>
                    <GridColumn Field="@nameof(UserWithRoles.EmailConfirmed)" HeaderText="E-Mail bestätigt" Width="135" AllowEditing="false" />
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

@code {
    private UserWithRoles? currentUser = default!;
    SfButton EditBtnResolved;

    private IEnumerable<Abteilung> Abteilungen = Array.Empty<Abteilung>();
    private IEnumerable<string> AbteilungenText => Abteilungen?.Select(x => x.Name ?? string.Empty) ?? Array.Empty<string>();
    private IEnumerable<string> Rollen => Global.Roles.AllRoles;
    private IEnumerable<string> AktiviertAuswahl => new List<string> { "Ja", "Nein" };

    private bool AllowEditing { get; set; } = false;
    private bool AllowDeletion { get; set; } = false;
    private bool AllowRoles { get; set; } = false;
    private bool IsAdmin { get; set; } = false;

    private bool IsLoading { get; set; } = false;
    private string errorMessage { get; set; } = string.Empty;




    private async void userDeaktivierenClick(Microsoft.AspNetCore.Components.Web.MouseEventArgs args, UserWithRoles userWithRoles)
    {
        try
        {
            if (currentUser == null)
            {
                errorMessage = "Internes Problem...";
                return;
            }

            if (currentUser.UserName == userWithRoles.UserName)
            {
                errorMessage = "Du kannst dich nicht selbst deaktivieren.";
                return;
            }

            //ggf. nochmal Berechtigungen prüfen
            if (currentUser.Abteilung != userWithRoles.Abteilung)
            {
                errorMessage = "Du bist nicht berechtigt, diesen Benutzer zu deaktivieren.";
                Logger.LogWarning($"User {currentUser.UserName} darf andere User nicht deaktivieren (Abteilung)");
                return;
            }

            if (Roles.IsAbteilungsleiter(currentUser.Roles) == false &&
                Roles.IsAdmin(currentUser.Roles) == false)
            {
                errorMessage = "Du bist nicht berechtigt, diesen Benutzer zu deaktivieren.";
                Logger.LogWarning($"User {currentUser.UserName} darf andere User nicht deaktivieren (Benutzerrolle)");
                return;
            }

            //Kurz nachfragen ob wirklich aktiviert werden soll
            bool confirm = await JSRuntime.InvokeAsync<bool>("confirm",
                $"Möchtest wirklich den Zugriff auf den Mitgliederbereich für {userWithRoles.Vorname} {userWithRoles.Name}, {userWithRoles.UserName} entfernen? Der User kann sich dann nicht mehr einloggen!");
            if (confirm)
            {
                var user = userWithRoles.User;

                user.Verified = false;
                user.VerifiedBy = string.Empty;
                user.VerifiedAt = null;

                await UserManager.UpdateAsync(user);
                var roles = await UserManager.GetRolesAsync(user);

                foreach (var role in roles)
                {
                    await UserManager.RemoveFromRoleAsync(user, role);
                }

                await UserManager.AddToRoleAsync(user, Roles.Gast);
                NavigationManager.NavigateTo(NavigationManager.Uri, true);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Aktivieren des Benutzers");
            errorMessage = "Der Benutzer konnte nicht aktiviert werden: " + ex.Message;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            using var context = DbContextFactory.CreateDbContext();
            Abteilungen = await context.Abteilungen.ToListAsync();

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var userPrincipal = authState.User;
            if (userPrincipal != null && userPrincipal?.Identity?.IsAuthenticated == true)
            {
                var user = await UserManager.GetUserAsync(userPrincipal);
                if (user != null)
                {
                    var roles = await UserManager.GetRolesAsync(user);

                    currentUser = new UserWithRoles { User = user, Roles = roles };

                    if (Roles.IsAdmin(roles))
                    {
                        AllowEditing = true;
                        AllowDeletion = true;
                        AllowRoles = true;
                        IsAdmin = true;
                    }
                    else if (Roles.IsAbteilungsleiter(roles))
                    {
                        AllowEditing = true;
                        AllowDeletion = false;
                        AllowRoles = false;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Laden der Abteilungen");
        }
    }

    public void DataBoundHandler()
    {
        IsLoading = false;
    }
    public void OnLoadHandler()
    {
        IsLoading = true;
    }

    public void OnActionFailureHandler(Syncfusion.Blazor.Grids.FailureEventArgs args)
    {
        errorMessage = args.Error?.Message ?? "Unbekannter Fehler";
        // var s = JsonConvert.DeserializeObject<Dictionary<string, object>>(JsonConvert.SerializeObject(args.Error));  //get details
    }
}


