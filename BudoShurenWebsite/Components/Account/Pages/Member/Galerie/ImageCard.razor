<div class="m-6 border shadow-lg">
    <div class="relative h-56 w-full">
        <img class="z-0 absolute inset-0 h-56 w-full object-cover" src="@Eintrag.DisplayPath" title="@Eintrag.Titel" alt="@Eintrag.Titel" onerror="this.src='/images/missingimage.jpg'" />
        <div class="opacity-0 z-10 absolute inset-0 flex items-start justify-end duration-300 hover:opacity-100">
            <div class="m-2 flex items-center rounded-full bg-gray-400">
                <span class="material-symbols-outlined m-0.5 text-white">done</span>
            </div>
        </div>
    </div>
    <div class="p-6">
        <h3 class="mt-1 truncate text-xl">@Eintrag.Titel</h3>
    </div>
</div>

@code {
    [Parameter]
    public GalerieEintrag Eintrag { get; set; } = new GalerieEintrag
        {
            Titel = "Unbekannt"
        };
}