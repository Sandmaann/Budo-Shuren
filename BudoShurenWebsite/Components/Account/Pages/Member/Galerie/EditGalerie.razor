@inject IHttpClientFactory ClientFactory
@inject HttpClient Http
@inject ILogger<EditGalerie> Logger
@inject IHostEnvironment environment
@inject ApplicationDbContext DbContext;

@using System.Net.Http.Headers
@using System.Text.Json

<div class="mx-5 flex h-screen flex-col">
    <div>
        <div class="mb-5 mr-5 mt-10 flex flex-row items-center justify-between">
            <div class="grow">
                @if (IsNew)
                {
                    <div class="flex flex-col items-center justify-center">
                        <h3 class="text-2xl">Neue Bilder anlegen</h3>
                    </div>
                }
                else
                {
                    <div class="flex flex-col items-center justify-center">
                        <h3 class="text-2xl">Einträge bearbeiten</h3>
                    </div>
                }
            </div>
            <div>
                <button @onclick="CloseSidebar">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <StatusMessage ShowAsError="true" Message="@errorMessage" />
        }
    </div>
    <div class="overflow-auto p-4">
        <div>
            <SfUploader @ref="uploadObj" ID="UploadFiles" AllowedExtensions=".png, .jpg, .jpeg" MaxFileSize=5242880>
                <UploaderAsyncSettings SaveUrl="Account/Member/Filesave/Save" RemoveUrl="Account/Member/Filesave/Remove"></UploaderAsyncSettings>
                <UploaderEvents OnFailure="@OnFailureHandler" OnActionComplete="@OnActionCompleteHandler" BeforeUpload="@BeforeUploadHandler"></UploaderEvents>
            </SfUploader>
        </div>
        <div class="flex flex-col">
            <div class="mt-5">
                <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Titel*</label>
                <InputText @bind-Value="SelectedEintrag.Titel" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
            </div>

            <div class="mt-2">
                <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Untertitel</label>
                <InputText @bind-Value="SelectedEintrag.Untertitel" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
            </div>

            <div class="mt-2">
                <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Beschreibung</label>
                <InputText @bind-Value="SelectedEintrag.Beschreibung" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
            </div>

            <div class="mt-2">
                <div>
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Abteilung*</label>
                    <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                        <InputCheckbox @bind-Value="SelectedEintrag.Home" class="h-4 w-4" />
                        <span class="ml-2 mt-0.5">Home</span>
                    </label>
                    <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                        <InputCheckbox @bind-Value="SelectedEintrag.Aikido" class="h-4 w-4" />
                        <span class="ml-2 mt-0.5">Aikido</span>
                    </label>
                    <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                        <InputCheckbox @bind-Value="SelectedEintrag.Bujinkan" class="h-4 w-4" />
                        <span class="ml-2 mt-0.5">Bujinkan</span>
                    </label>
                    <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                        <InputCheckbox @bind-Value="SelectedEintrag.Genbukan" class="h-4 w-4" />
                        <span class="ml-2 mt-0.5">Genbukan</span>
                    </label>
                </div>
            </div>

            <div class="mt-2">
                <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Datum*</label>
                <InputDate @bind-Value="SelectedEintrag.ImageDate" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
            </div>

            <div class="mt-2">
                <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Fotograf</label>
                <InputText @bind-Value="SelectedEintrag.ImageCreatedBy" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
            </div>
        </div>
    </div>
    <div class="p-4">
        <button @onclick="onSave" class="h-10 w-full bg-black px-5 text-center text-white hover:bg-primary">
            <div class="flex flex-row items-center justify-start">
                <span class="material-symbols-outlined">save</span>
                <span class="font-yuji px-5 text-sm font-normal leading-tight tracking-widest">Speichern</span>
            </div>
        </button>
    </div>
</div>

@code {
    private SfUploader uploadObj { get; set; }

    [Parameter]
    public IEnumerable<GalerieEintrag> Einträge { get; set; } = new List<GalerieEintrag>();
    [Parameter]
    public EventCallback<bool> OnClose { get; set; }

    [Parameter]
    public bool IsOpen { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            // Clear temporary data
            errorMessage = string.Empty;
            if (Einträge?.Count() > 0)
            {
                SelectedEintrag = new InputModel
                    {
                        Aikido = Einträge.First().Aikido,
                        Beschreibung = Einträge.First().Beschreibung,
                        Bujinkan = Einträge.First().Bujinkan,
                        Genbukan = Einträge.First().Genbukan,
                        Home = Einträge.First().Home,
                        ImageCreatedBy = Einträge.First().ImageCreatedBy,
                        ImageDate = Einträge.First().ImageDate,
                        Titel = Einträge.First().Titel,
                        Untertitel = Einträge.First().Untertitel
                    };
            }
            else
            {
                SelectedEintrag = new InputModel();
                if (uploadObj != null)
                    await uploadObj.ClearAllAsync();
            }
        }
        else
        {
            if (uploadObj != null)
            {
                //Aufräumen sollte die Sidebar nicht korrekt geschlossen worden sein.
                var files = await uploadObj.GetFilesDataAsync();
                if (files.Any())
                {
                    foreach (var file in files)
                    {
                        await uploadObj.RemoveAsync(new FileInfo[] { file });
                    }
                    await uploadObj.ClearAllAsync();
                }
            }
        }
    }

    // private GalerieEintrag SelectedEintrag { get; set; } = new GalerieEintrag { ImageDate = DateTime.Today.Date };
    private InputModel SelectedEintrag { get; set; } = new InputModel();

    private bool IsNew => Einträge == null || Einträge?.Count() == 0;
    private bool CanSave { get; set; }

    private async void SetCanSave(bool ausSave = false)
    {
        if (isUploading == true)
        {
            errorMessage = "Bitte warten, bis alle Bilder hochgeladen wurden.";
            CanSave = false;
        }
        else
        {
            if (ausSave)
            {
                if (string.IsNullOrWhiteSpace(SelectedEintrag.Titel))
                {
                    errorMessage = "Bitte gib noch einen Titel an!";
                    CanSave = false;
                    return;
                }
                var files = await uploadObj.GetFilesDataAsync();
                if(files.Any() == false)
                {
                    errorMessage = "Bitte lade mindestens 1 Bild für die Gallerie hoch!";
                    CanSave = false;
                    return;
                }
                if (files.Any(x => x.StatusCode == "2") == false)
                {
                    errorMessage = "Kein einziges gültiges Bild auswählt!";
                    CanSave = false;
                    return;
                }
            }

            errorMessage = string.Empty;
            CanSave = true;
        }
    }

    private bool filesUploaded = false;
    private string errorMessage = string.Empty;
    private bool isUploading { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    private async Task CloseSidebar()
    {
        errorMessage = string.Empty;

        if (uploadObj != null)
        {
            //Aufräumen wenn die Sidebar geschlossen wird.
            var files = await uploadObj.GetFilesDataAsync();
            if (files.Any())
            {
                foreach (var file in files)
                {
                    await uploadObj.RemoveAsync(new FileInfo[] { file });
                }
                await uploadObj.ClearAllAsync();
            }
        }

        await OnClose.InvokeAsync(false);
    }

    private void BeforeUploadHandler(BeforeUploadEventArgs args)
    {
        // You can prevent uploading by setting "args.Cancel" to true.
        isUploading = true;
        SetCanSave();
    }

    private void OnFailureHandler(Syncfusion.Blazor.Inputs.FailureEventArgs args)
    {
        // Here, you can customize your code.

    }
    private void OnActionCompleteHandler(Syncfusion.Blazor.Inputs.ActionCompleteEventArgs args)
    {
        // Here, you can customize your code.
        isUploading = false;
        SetCanSave();

        // if (args.FileData?.Any(x => x.StatusCode == "2") != true)
        // {
        //     filesUploaded = false;
        // }
        // else
        // {
        //     filesUploaded = true;
        // }
    }

    private async Task onSave()
    {
        try
        {
            SetCanSave(true);
            if (CanSave == false)
                return;
            if (SelectedEintrag.IsValid == false)
                return;

            List<string> errors = new();

            var files = await uploadObj.GetFilesDataAsync();
            foreach (var file in files)
            {
                var neuerEintrag = new GalerieEintrag
                    {
                        Titel = SelectedEintrag.Titel,
                        Untertitel = SelectedEintrag.Untertitel,
                        Beschreibung = SelectedEintrag.Beschreibung,
                        ImageDate = SelectedEintrag.ImageDate,
                        ImageCreatedBy = SelectedEintrag.ImageCreatedBy,
                        Home = SelectedEintrag.Home,
                        Aikido = SelectedEintrag.Aikido,
                        Bujinkan = SelectedEintrag.Bujinkan,
                        Genbukan = SelectedEintrag.Genbukan
                    };

                //Environment-Pfad mit einbeziehen!

                string tempFilePath = Path.Combine(environment.ContentRootPath, "wwwroot",
                    environment.EnvironmentName, "unsafe_uploads",
                    file.Name);

                if (File.Exists(tempFilePath))
                {
                    //Datei in Galerie-Ordner kopieren
                    string destination = Path.Combine(environment.ContentRootPath, "wwwroot", environment.EnvironmentName, "galery");
                    string newFileName = Path.ChangeExtension(Path.GetRandomFileName(), Path.GetExtension(file.Name));
                    string newFilePath = Path.Combine(destination, newFileName);

                    await CopyFileAsync(tempFilePath, newFilePath);

                    if (File.Exists(newFilePath))
                    {
                        //Eintarg im FileUploader löschen!
                        await uploadObj.RemoveAsync(new FileInfo[] { file });
                        //Temp-Datei löschen wenn sie noch vorhanden ist (sollte redundant sein?!)
                        if (File.Exists(tempFilePath))
                            File.Delete(tempFilePath);

                        neuerEintrag.ImagePath = newFilePath;

                        //Eintrag in DB anlegen
                        await DbContext.Galerie.AddAsync(neuerEintrag);
                        await DbContext.SaveChangesAsync();
                    }
                    else
                    {
                        //ErrorHandling
                    }
                }
                else
                {
                    //Fehler...
                    errors.Add($"Die Datei {file.Name} wurde nicht gefunden! Versuche bitte das Bild zu entfernen und einmal neu hinzuzufügen.");
                }
            }

            if (errors.Any())
            {
                errorMessage = string.Join(Environment.NewLine, errors);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Bei der Erstellung der neuen Einträge ist ein Fehler aufgetreten: " + ex.Message;
        }
    }

    public async Task CopyFileAsync(string sourceFile, string destinationFile)
    {
        using (var sourceStream = new FileStream(sourceFile, FileMode.Open, FileAccess.Read, FileShare.Read, 4096, FileOptions.Asynchronous | FileOptions.SequentialScan))
        using (var destinationStream = new FileStream(destinationFile, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, FileOptions.Asynchronous | FileOptions.SequentialScan))
            await sourceStream.CopyToAsync(destinationStream);
    }


    public sealed class InputModel
    {
        public bool IsValid { get; set; } = false;

        private string titel = string.Empty;
        public string Titel
        {
            get => titel;
            set
            {
                titel = value;
                Validate();
            }
        }

        private string untertitel = string.Empty;
        public string Untertitel
        {
            get => untertitel;
            set
            {
                untertitel = value;
                Validate();
            }
        }

        private string beschreibung = string.Empty;
        public string Beschreibung
        {
            get => beschreibung;
            set
            {
                beschreibung = value;
                Validate();
            }
        }

        private string imageCreatedBy = string.Empty;
        public string ImageCreatedBy
        {
            get => imageCreatedBy;
            set
            {
                imageCreatedBy = value;
                Validate();
            }
        }

        private DateTime? imageDate = DateTime.Today.Date;
        public DateTime? ImageDate
        {
            get => imageDate;
            set
            {
                imageDate = value;
                Validate();
            }
        }

        private bool home = false;
        public bool Home
        {
            get => home;
            set
            {
                home = value;
                Validate();
            }
        }

        private bool aikido = false;
        public bool Aikido
        {
            get => aikido;
            set
            {
                aikido = value;
                Validate();
            }
        }

        private bool bujinkan = false;
        public bool Bujinkan
        {
            get => bujinkan;
            set
            {
                bujinkan = value;
                Validate();
            }
        }

        private bool genbukan = false;
        public bool Genbukan
        {
            get => genbukan;
            set
            {
                genbukan = value;
                Validate();
            }
        }

        private void Validate()
        {
            // Do some validation

            if (string.IsNullOrWhiteSpace(Titel))
                IsValid = false;
            else
                IsValid = true;
        }
    }
}
