@page "/Account/Member/Neuigkeiten"
@rendermode InteractiveServer

@inject ImageService ImageService
@inject UserService UserService
@inject IdentityUserAccessor UserAccessor
@inject ILogger<Neuigkeit> Logger

@using BudoShurenWebsite.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore;
@using System.Net.Http.Headers
@using System.Text.Json

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Calendars

<div class="container mx-auto max-w-screen-md">
    <div class="mx-10">
        <SectionBanner Titel="Neuigkeiten verwalten" />
        <div class="mb-10">
            <Standardtext Text="Bitte ladet nur Bilder hoch, an denen ihr die Rechte besitzt und bei denen die abgebildeten Personen der Veröffentlichung zugestimmt haben!" />
        </div>
        <div class="-mx-8 md:mx-0">

            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <StatusMessage ShowAsError="true" Message="@errorMessage" />
            }

            <SfGrid TValue="Neuigkeit" AllowSorting="true" AllowPaging="false" Toolbar="@(new List<string>() { "Add", "Edit", "Delete", "Search" })" Height="100%" Width="100%">
                <SfDataManager AdaptorInstance="@typeof(NeuigkeitenAdaptor)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>
                <GridEvents TValue="Neuigkeit" OnActionFailure="OnActionFailureHandler" OnActionBegin="OnActionBeginHandler" OnLoad="OnLoadHandler" DataBound="DataBoundHandler"></GridEvents>
                <GridTemplates>
                    <EmptyRecordTemplate>
                        @if (IsLoading)
                        {
                            <Standardtext Text="Geduld, die Infos müssen erst von einem Ninja gesammelt werden ..." />
                        }
                        else
                        {
                            <Standardtext Text="Anscheinend gibt es gerade keine Neuigkeiten!" />
                        }
                    </EmptyRecordTemplate>
                </GridTemplates>
                <GridEditSettings AllowAdding="@AllowEditing"
                                  AllowEditing="@AllowEditing"
                                  AllowDeleting="@AllowDeletion"
                                  AllowEditOnDblClick="@AllowEditing"
                                  Mode="@EditMode.Dialog"
                                  ShowDeleteConfirmDialog="true">
                    <Template>
                        @{
                            var neuigkeit = context as Neuigkeit;
                        }
                        <div>
                            <SfTextBox Placeholder="Titel"
                                       FloatLabelType="FloatLabelType.Always"
                                       @bind-Value="@neuigkeit.Titel"></SfTextBox>
                            <ValidationMessage For="@(() => neuigkeit.Titel)" />

                            <div class="">
                                <SfTextBox Placeholder="Beschreibung"
                                           FloatLabelType="FloatLabelType.Always"
                                           Multiline=true
                                           @bind-Value="@neuigkeit.Beschreibung"></SfTextBox>
                                <ValidationMessage For="@(() => neuigkeit.Beschreibung)" />
                            </div>
                            <div>
                                <SfTextBox Placeholder="Ort"
                                           FloatLabelType="FloatLabelType.Always"
                                           @bind-Value="@neuigkeit.Ort"></SfTextBox>
                            </div>
                            <div>
                                <SfTextBox Placeholder="Link"
                                           FloatLabelType="FloatLabelType.Always"
                                           @bind-Value="@neuigkeit.Link"></SfTextBox>
                            </div>
                            <div>
                                <SfTextBox Placeholder="Linktext (Anzeigetext)"
                                           FloatLabelType="FloatLabelType.Always"
                                           @bind-Value="@neuigkeit.Linktext"></SfTextBox>
                            </div>
                            <div>
                                <SfDateTimePicker Placeholder="Datum"
                                                  FloatLabelType="FloatLabelType.Always"
                                                  @bind-Value="@neuigkeit.Datum"></SfDateTimePicker>
                            </div>
                            <div>
                                <SfNumericTextBox Placeholder="Sortierung"
                                                  FloatLabelType="FloatLabelType.Always"
                                                  TValue="int"
                                                  @bind-Value="@neuigkeit.Sortierung"></SfNumericTextBox>
                            </div>
                            @if (IsAddNew)
                            {
                                <div class="mt-10">
                                    <SfUploader @ref="sfUploader" ID="UploadFiles" AllowedExtensions=".png, .jpg, .jpeg, .webp" MaxFileSize=5242880 AllowMultiple=false>
                                        <UploaderAsyncSettings SaveUrl="Account/Member/Filesave/Save" RemoveUrl="Account/Member/Filesave/Remove"></UploaderAsyncSettings>
                                        <UploaderEvents FileSelected="SelectHandler" Success="SuccessHandler" OnFailure="@OnFailureHandler" OnActionComplete="@OnActionCompleteHandler" BeforeUpload="@BeforeUploadHandler"></UploaderEvents>
                                    </SfUploader>
                                </div>
                            }
                        </div>
                    </Template>
                </GridEditSettings>

                <GridColumns>
                    <GridColumn Field=@nameof(Neuigkeit.ID) HeaderText="ID" IsPrimaryKey="true" AllowSearching="false" Width="25" Visible="false"></GridColumn>

                    <GridColumn HeaderText="Vorschau" TextAlign="TextAlign.Center" Width="120" AllowEditing=false>
                        <Template>
                            @{
                                var neuigkeit = context as Neuigkeit;
                                <div class="image">
                                    <img src="@GetImageUrl(neuigkeit?.DbImageId)" alt="@neuigkeit?.Titel" />
                                </div>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field=@nameof(Neuigkeit.Titel) HeaderText="Titel" AllowSearching="true" Width="120" ValidationRules="@(new Syncfusion.Blazor.Grids.ValidationRules{ Required= true })"></GridColumn>
                    <GridColumn Field=@nameof(Neuigkeit.Beschreibung) HeaderText="Inhalt" AllowSearching="true" ValidationRules="@(new Syncfusion.Blazor.Grids.ValidationRules{ Required= true })"></GridColumn>
                    <GridColumn Field=@nameof(Neuigkeit.Ort) HeaderText="Ort" AllowSearching="true" Width="100"></GridColumn>
                    <GridColumn Field=@nameof(Neuigkeit.Datum) HeaderText="Datum" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Format="dd.MM.yyyy" AllowSearching="true" Width="85"></GridColumn>
                    <GridColumn Field=@nameof(Neuigkeit.Sortierung) HeaderText="Sort" AllowSearching="true" Width="55"></GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
</div>

@code {
    [AllowNull]
    private SfUploader sfUploader { get; set; }

    private UserWithRoles? user = default!;

    private bool AllowEditing { get; set; } = false;
    private bool AllowDeletion { get; set; } = false;
    // private FileInfo? UploadedImage { get; set; }
    private UploadedFile? _uploadedFile { get; set; }
    private string errorMessage { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = false;

    private Neuigkeit? SelectedEditNeuigkeit;

    public bool IsAddNew { get; set; } = false;

    // private bool isUploading = false;

    protected override async Task OnInitializedAsync()
    {
        // if (userPrincipal != null && userPrincipal?.Identity?.IsAuthenticated == true)

        await base.OnInitializedAsync();
        try
        {
            await UserService.InitializeAsync();
            user = UserService.CurrentUser;

            if (user != null)
            {
                if (Roles.IsAdmin(user.Roles))
                {
                    AllowEditing = true;
                    AllowDeletion = true;
                }
                else if (Roles.IsAbteilungsleiter(user.Roles))
                {
                    AllowEditing = true;
                    AllowDeletion = true;
                }
                else
                {
                    AllowEditing = false;
                    AllowDeletion = false;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Laden der Benutzerdaten");
        }
    }

    public void OnActionFailureHandler(Syncfusion.Blazor.Grids.FailureEventArgs args)
    {
        errorMessage = args.Error?.Message ?? "Unbekannter Fehler";
        // var s = JsonConvert.DeserializeObject<Dictionary<string, object>>(JsonConvert.SerializeObject(args.Error));  //get details
    }

    private async void OnActionBeginHandler(Syncfusion.Blazor.Grids.ActionEventArgs<Neuigkeit> args)
    {
        //Das muss passieren, bevor IsAddNew gesetz wird, damit ich weiß ob es vorher ein Add war. Erst danach IsAddNew aktualisieren.
        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Cancel)
        {
            if (IsAddNew)
            {
                //wenn eine Datei hochgeladen wurde, diese löschen.
                var files = await sfUploader.GetFilesDataAsync();
                await sfUploader.RemoveAsync(files.ToArray());
            }
        }

        IsAddNew = args.RequestType == Syncfusion.Blazor.Grids.Action.Add;
        if (IsAddNew)
        {
            if (sfUploader != null)
            {
                await sfUploader.ClearAllAsync();
            }
            SelectedEditNeuigkeit = args.Data;
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {

        }
    }
    public void DataBoundHandler()
    {
        IsLoading = false;
    }
    public void OnLoadHandler()
    {
        IsLoading = true;
    }

    private string GetImageUrl(int? dbImageId)
    {
        return dbImageId.HasValue ? $"/Account/Member/Filesave/GetImage/{dbImageId.Value}" : "/images/missingimage.jpg";
    }

    #region FileUploader

    public void SelectHandler(SelectedEventArgs args)
    {
        string selectedfile = args.FilesData[0].Name;

        foreach (var file in args.FilesData)
        {
            if (file?.Name == _uploadedFile?.FileName)
            {
                this.errorMessage = "Dieses Bild wurde bereits hochgeladen!";
                return;
            }
        }
        this.errorMessage = string.Empty;
    }
    public async void SuccessHandler(SuccessEventArgs args)
    {
        try
        {
            if (args.Operation == "upload")
            {
                var jsonResponse = args.Response.ResponseText;
                var options = new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    };
                var uploadResponse = JsonSerializer.Deserialize<UploadResponse>(jsonResponse, options);

                if (uploadResponse != null && uploadResponse.Success)
                {
                    foreach (var file in uploadResponse.Files)
                    {
                        // Hier kannst du auf die hochgeladenen Dateien zugreifen
                        // Console.WriteLine($"Datei hochgeladen: {file.FileName}, ID: {file.Id}");
                        if (uploadResponse.Files.FirstOrDefault(x => x.FileName == args.File.Name) is UploadedFile uploadedFile)
                        {
                            //Hat es Id?
                            _uploadedFile = uploadedFile;
                        }
                        else
                        {
                            Logger.LogWarning($"Die Datei {args.File.Name} wurde nicht in der Liste der hochgeladenen Dateien gefunden!");
                        }
                    }
                }
                else
                {
                    errorMessage = "Der Upload war nicht erfolgreich.";
                    Console.WriteLine("Upload war nicht erfolgreich.");
                }
            }
            else if (args.Operation == "remove")
            {
                //Datei wurde gelöscht - aus der Liste entfernen?
                if (_uploadedFile?.Id > 0)
                {
                    //Image löschen
                    await ImageService.RemoveImageAsync(_uploadedFile.Id);
                    _uploadedFile = null;
                    if (SelectedEditNeuigkeit != null)
                        SelectedEditNeuigkeit.DbImageId = null;
                }
            }
            else
            {
                errorMessage = $"Die Operation '{args.Operation}' ist hier noch nicht implementiert!";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Speichern des Bildes im SfUploader");
            errorMessage = ex.Message;
        }
        // UploadedImage = args.File;
    }
    private void OnFailureHandler(Syncfusion.Blazor.Inputs.FailureEventArgs args)
    {
        try
        {
            _uploadedFile = null;
            using (JsonDocument doc = JsonDocument.Parse(args.Response.ResponseText))
            {
                JsonElement root = doc.RootElement;
                if (root.TryGetProperty("message", out JsonElement messageElement))
                {
                    errorMessage = messageElement.GetString() ?? "Unbekannter Fehler";
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Parsen der JSON-Antwort");
            errorMessage = "Ein unbekannter Fehler ist aufgetreten.";
        }
    }
    private async void OnActionCompleteHandler(Syncfusion.Blazor.Inputs.ActionCompleteEventArgs args)
    {
        if (SelectedEditNeuigkeit != null)
        {
            var files = await sfUploader.GetFilesDataAsync();
            var file = files.FirstOrDefault();
            if (file != null && _uploadedFile?.Id > 0 && _uploadedFile.FileName == file.Name)
            {
                SelectedEditNeuigkeit.DbImageId = _uploadedFile.Id;
                // var tempPath = FileService.GetTempFilePath(file);
                // SelectedEditNeuigkeit.TempFilePath = tempPath;
            }
        }
        StateHasChanged();
    }
    private void BeforeUploadHandler(BeforeUploadEventArgs args)
    {
        // You can prevent uploading by setting "args.Cancel" to true.
        // isUploading = true;
    }


    #endregion
}

@* Für die Icons im SfGrid - damit der Text weg ist *@
<style>
    .e-grid .e-toolbar .e-tbar-btn-text,
    .e-grid .e-toolbar .e-toolbar-items .e-toolbar-item .e-tbar-btn-text {
        display: none;
    }
</style>