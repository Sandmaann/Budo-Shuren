@page "/Account/Member/Neuigkeiten"
@rendermode InteractiveServer
@implements IAsyncDisposable

@inject UserService UserService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IEntwurfSpeicher Entwuerfe
@inject IBildUpload BildUpload
@inject ILogger<NeuigkeitenVerwalten> Logger

@using BudoShurenWebsite.Data
@using BudoShurenWebsite.Services.Entwuerfe
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Data
@using Syncfusion.Blazor.Navigations

<div class="container mx-auto max-w-screen-lg">
    <div class="mx-10">
        <SectionBanner Titel="Neuigkeiten verwalten" />
        <div class="mb-10">
            <Standardtext Text="Bitte ladet nur Bilder hoch, an denen ihr die Rechte besitzt und bei denen die abgebildeten Personen der Veröffentlichung zugestimmt haben!" />
        </div>

        @if (_eingabe is not null)
        {
            @* Eigenes Formular statt des Dialogs im Grid: sein Stand lässt sich als Entwurf sichern und wiederherstellen *@
            <div class="mx-auto max-w-screen-md">
                <h4 class="font-ptsans mb-4 text-sm font-bold tracking-wider">@(_eingabe.Id.HasValue ? "Neuigkeit bearbeiten" : "Neue Neuigkeit")</h4>

                <EntwurfHinweis VomUtc="_entwurfVomUtc" OnVerwerfen="AbbrechenAsync" />

                <EditForm Model="_eingabe" OnValidSubmit="SpeichernAsync" FormName="neuigkeit-bearbeiten">
                    <DataAnnotationsValidator />
                    <div class="space-y-4">
                        <div>
                            <label class="@Label" for="neuigkeit-titel">Titel *</label>
                            <InputText id="neuigkeit-titel" @bind-Value="_eingabe.Titel" class="@Feld" />
                        </div>
                        <div>
                            <label class="@Label" for="neuigkeit-beschreibung">Beschreibung *</label>
                            <InputTextArea id="neuigkeit-beschreibung" @bind-Value="_eingabe.Beschreibung" rows="6" class="@Feld" />
                        </div>
                        <div>
                            <label class="@Label" for="neuigkeit-ort">Ort</label>
                            <InputText id="neuigkeit-ort" @bind-Value="_eingabe.Ort" class="@Feld" />
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label class="@Label" for="neuigkeit-linktext">Linktext (Anzeigetext)</label>
                                <InputText id="neuigkeit-linktext" @bind-Value="_eingabe.Linktext" class="@Feld" />
                            </div>
                            <div>
                                <label class="@Label" for="neuigkeit-link">Link</label>
                                <InputText id="neuigkeit-link" @bind-Value="_eingabe.Link" class="@Feld" />
                            </div>
                        </div>
                        <div>
                            <label class="@Label" for="neuigkeit-quelle">Quellenangabe (Bild)</label>
                            <InputText id="neuigkeit-quelle" @bind-Value="_eingabe.Quellenangabe" class="@Feld" />
                        </div>
                        <div class="grid gap-4 md:grid-cols-2">
                            <div>
                                <label class="@Label" for="neuigkeit-datum">Datum</label>
                                <InputDate id="neuigkeit-datum" Type="InputDateType.DateTimeLocal" @bind-Value="_eingabe.Datum" class="@Feld" />
                            </div>
                            <div>
                                <label class="@Label" for="neuigkeit-sortierung">Sortierung</label>
                                <InputNumber id="neuigkeit-sortierung" @bind-Value="_eingabe.Sortierung" class="@Feld" />
                            </div>
                        </div>
                        <label class="font-ptsans flex cursor-pointer items-center gap-2 text-sm">
                            <InputCheckbox @bind-Value="_eingabe.IstStandardneuigkeit" />
                            Standardneuigkeit (kein Ablaufdatum)
                        </label>
                        @if (!_eingabe.IstStandardneuigkeit)
                        {
                            <div>
                                <label class="@Label" for="neuigkeit-ablauf">Ablaufdatum (optional)</label>
                                <InputDate id="neuigkeit-ablauf" Type="InputDateType.DateTimeLocal" @bind-Value="_eingabe.Ablaufdatum" class="@($"{Feld} md:w-1/2")" />
                            </div>
                        }

                        <div>
                            <span class="@Label">Bild @(_eingabe.Id.HasValue ? "" : "*")</span>
                            @if (_eingabe.DbImageId is { } bildId)
                            {
                                <div class="flex items-center gap-3">
                                    <img src="@GetImageUrl(bildId)" alt="Vorschau" class="h-32 w-auto rounded border" />
                                    @if (!_eingabe.Id.HasValue)
                                    {
                                        <button type="button" @onclick="BildEntfernenAsync" class="rounded border border-red-300 px-2 py-1 text-xs text-red-600 hover:bg-red-50">
                                            Bild entfernen
                                        </button>
                                    }
                                </div>
                            }
                            else if (!_eingabe.Id.HasValue)
                            {
                                @* Format: siehe BildZuschnitt *@
                                <BildAuswahl OnHochgeladen="bild => _eingabe.DbImageId = bild.Id"
                                             Hinweis="Auf der Startseite erscheint das Bild im Format 4:3 (Querformat) oder 3:4 (Hochformat). Was darüber hinausgeht, wird an den Rändern abgeschnitten." />
                            }
                        </div>

                        <ValidationSummary class="font-ptsans text-sm text-red-700" />
                        @if (!string.IsNullOrWhiteSpace(_formularFehler))
                        {
                            <StatusMessage ShowAsError="true" Message="@_formularFehler" />
                        }
                        <div class="flex flex-wrap gap-3 border-t border-gray-200 pb-12 pt-6">
                            <button type="submit" disabled="@_speichert"
                                    class="font-ptsans rounded border border-black px-5 py-2 text-sm tracking-wider hover:bg-gray-100 disabled:opacity-50">
                                @(_speichert ? "Speichern..." : "Speichern")
                            </button>
                            <button type="button" @onclick="AbbrechenAsync" disabled="@_speichert"
                                    class="font-ptsans rounded border border-gray-400 px-5 py-2 text-sm tracking-wider hover:bg-gray-50">
                                Abbrechen
                            </button>
                        </div>
                    </div>
                </EditForm>
            </div>
        }
        else
        {
            <div class="-mx-8 md:mx-0">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <StatusMessage ShowAsError="true" Message="@errorMessage" />
                }
                <SfGrid @ref="grid"
                        TValue="Neuigkeit"
                        AllowSorting="true"
                        AllowPaging="false"
                        Toolbar="@Werkzeuge"
                        Height="100%"
                        Width="100%">
                    <SfDataManager AdaptorInstance="@typeof(NeuigkeitenAdaptor)" Adaptor="Adaptors.CustomAdaptor"></SfDataManager>
                    <GridEvents TValue="Neuigkeit" OnActionFailure="OnActionFailureHandler" OnLoad="OnLoadHandler" DataBound="DataBoundHandler"
                                OnToolbarClick="WerkzeugGeklicktAsync" OnRecordDoubleClick="DoppelklickAsync"></GridEvents>
                    <GridTemplates>
                        <EmptyRecordTemplate>
                            @if (IsLoading)
                            {
                                <Standardtext Text="Geduld, die Infos müssen erst von einem Ninja gesammelt werden ..." />
                            }
                            else
                            {
                                <Standardtext Text="Anscheinend gibt es gerade keine Neuigkeiten!" />
                            }
                        </EmptyRecordTemplate>
                    </GridTemplates>
                    @* Anlegen und Bearbeiten laufen über das Formular oben, das Grid löscht nur noch *@
                    <GridEditSettings AllowAdding="false"
                                      AllowEditing="false"
                                      AllowDeleting="@AllowEditing"
                                      ShowDeleteConfirmDialog="true">
                    </GridEditSettings>

                    <GridColumns>
                        <GridColumn Field=@nameof(Neuigkeit.ID) HeaderText="ID" IsPrimaryKey="true" AllowSearching="false" Width="25" Visible="false"></GridColumn>

                        <GridColumn HeaderText="Vorschau" TextAlign="TextAlign.Center" Width="120" AllowEditing=false>
                            <Template>
                                @{
                                    var neuigkeit = context as Neuigkeit;
                                    <div class="image">
                                        <img src="@GetImageUrl(neuigkeit?.DbImageId)" alt="@neuigkeit?.Titel" />
                                    </div>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Titel) HeaderText="Titel" AllowSearching="true" Width="120"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Beschreibung) HeaderText="Inhalt" AllowSearching="true"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Ort) HeaderText="Ort" AllowSearching="true" Width="100"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Datum) HeaderText="Datum" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Format="dd.MM.yyyy" AllowSearching="true" Width="85"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Ablaufdatum) HeaderText="Ablaufdatum" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Format="dd.MM.yyyy" AllowSearching="false" Width="95"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.IstStandardneuigkeit) HeaderText="Standard" DisplayAsCheckBox="true" AllowSearching="false" Width="70"></GridColumn>
                        <GridColumn Field=@nameof(Neuigkeit.Sortierung) HeaderText="Sort" AllowSearching="true" Width="55"></GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        }
    </div>
</div>

@code {
    private const string Label = "font-ptsans mb-1 block text-xs font-bold";
    private const string Feld = "font-ptsans w-full rounded border border-gray-300 p-2 text-sm disabled:bg-gray-100";
    private const string EntwurfSchluessel = "neuigkeiten";

    [AllowNull]
    private SfGrid<Neuigkeit> grid { get; set; }

    private bool AllowEditing { get; set; } = false;
    private string errorMessage { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = false;

    /// <summary>Das offene Formular; null = die Liste wird gezeigt.</summary>
    private NeuigkeitEingabe? _eingabe;
    private string? _formularFehler;
    private bool _speichert;

    // Ungespeicherte Eingaben überstehen ein Neuladen der Seite (Tab-Wechsel auf dem Handy)
    private EntwurfSicherung<NeuigkeitEingabe>? _sicherung;
    private DateTime? _entwurfVomUtc;

    private List<object> Werkzeuge => AllowEditing
        ? [
            new ItemModel { Id = "neuigkeit-neu", Text = "Hinzufügen", TooltipText = "Hinzufügen", PrefixIcon = "e-add" },
            new ItemModel { Id = "neuigkeit-bearbeiten", Text = "Bearbeiten", TooltipText = "Bearbeiten", PrefixIcon = "e-edit" },
            "Delete",
            "Search"
        ]
        : ["Search"];

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            await UserService.InitializeAsync();
            var user = UserService.CurrentUser;
            AllowEditing = user != null && (Roles.IsAdmin(user.Roles) || Roles.IsAbteilungsleiter(user.Roles) || Roles.IsEditor(user.Roles));

            if (AllowEditing && user?.User?.Id is { } benutzerId)
                await EntwurfUebernehmenAsync(benutzerId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Laden der Benutzerdaten");
        }
    }

    /// <summary>War beim letzten Mal ein Formular offen und ungespeichert, öffnet es sich wieder.</summary>
    private async Task EntwurfUebernehmenAsync(string benutzerId)
    {
        _sicherung = new(Entwuerfe, Logger, benutzerId, EntwurfSchluessel, () => _eingabe,
            e => e.Id is null && e.DbImageId is { } bildId ? [bildId] : []);

        if (await _sicherung.LadenAsync() is { } entwurf)
        {
            if (entwurf.Daten.DbImageId is { } bildId && (await Entwuerfe.FehlendeBilderAsync([bildId])).Count > 0)
                entwurf.Daten.DbImageId = null;
            _eingabe = entwurf.Daten;
            _entwurfVomUtc = entwurf.GeaendertUtc;
        }

        _sicherung.AusgangMerken();
        // Beim Prerendering gibt es noch nichts zu sichern
        if (RendererInfo.IsInteractive)
            _sicherung.Starten(InvokeAsync);
    }

    private void FormularOeffnen(NeuigkeitEingabe eingabe)
    {
        errorMessage = string.Empty;
        _formularFehler = null;
        _entwurfVomUtc = null;
        _eingabe = eingabe;
        // Gesichert wird erst, wenn sich daran etwas ändert
        _sicherung?.AusgangMerken();
    }

    private async Task WerkzeugGeklicktAsync(Syncfusion.Blazor.Navigations.ClickEventArgs args)
    {
        if (!AllowEditing)
            return;

        if (args.Item.Id == "neuigkeit-neu")
        {
            FormularOeffnen(new NeuigkeitEingabe());
        }
        else if (args.Item.Id == "neuigkeit-bearbeiten")
        {
            if ((await grid.GetSelectedRecordsAsync()).FirstOrDefault() is { } auswahl)
                FormularOeffnen(NeuigkeitEingabe.Aus(auswahl));
            else
                errorMessage = "Bitte zuerst eine Neuigkeit auswählen.";
        }
    }

    private void DoppelklickAsync(RecordDoubleClickEventArgs<Neuigkeit> args)
    {
        if (AllowEditing && args.RowData is { } neuigkeit)
            FormularOeffnen(NeuigkeitEingabe.Aus(neuigkeit));
    }

    private async Task SpeichernAsync()
    {
        if (_eingabe is null || !AllowEditing)
            return;

        _speichert = true;
        _formularFehler = null;
        try
        {
            await using var kontext = await DbFactory.CreateDbContextAsync();
            _formularFehler = await _eingabe.SpeichernAsync(kontext, UserService.CurrentUser?.UserName ?? "unbekannt");
            if (_formularFehler is null)
                await FormularSchliessenAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Speichern der Neuigkeit");
            _formularFehler = "Fehler beim Speichern der Neuigkeit: " + ex.Message;
        }
        finally
        {
            _speichert = false;
        }
    }

    /// <summary>Verwirft die Eingaben (auch den Entwurf) und ein für eine neue Neuigkeit hochgeladenes Bild.</summary>
    private async Task AbbrechenAsync()
    {
        if (_eingabe is { Id: null, DbImageId: { } bildId })
            await BildUpload.VerwerfenAsync([bildId]);
        await FormularSchliessenAsync();
    }

    private async Task FormularSchliessenAsync()
    {
        if (_sicherung is not null)
            await _sicherung.LoeschenAsync();
        _eingabe = null;
        _entwurfVomUtc = null;
        _formularFehler = null;
    }

    private async Task BildEntfernenAsync()
    {
        if (_eingabe is { Id: null, DbImageId: { } bildId })
        {
            await BildUpload.VerwerfenAsync([bildId]);
            _eingabe.DbImageId = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_sicherung is not null)
            await _sicherung.DisposeAsync();
    }

    public void OnActionFailureHandler(Syncfusion.Blazor.Grids.FailureEventArgs args)
    {
        errorMessage = args.Error?.Message ?? "Unbekannter Fehler";
    }

    public void DataBoundHandler()
    {
        IsLoading = false;
    }

    public void OnLoadHandler()
    {
        IsLoading = true;
    }

    private string GetImageUrl(int? dbImageId)
    {
        return dbImageId.HasValue ? $"/Account/Member/Filesave/GetImage/{dbImageId.Value}" : "/images/missingimage.jpg";
    }
}

@* Für die Icons im SfGrid - damit der Text weg ist *@
<style>
    .e-grid .e-toolbar .e-tbar-btn-text,
    .e-grid .e-toolbar .e-toolbar-items .e-toolbar-item .e-tbar-btn-text {
        display: none;
    }
</style>
