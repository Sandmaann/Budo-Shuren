@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Caching.Memory

@inject NavigationManager NavigationManager
@inject ILogger<LoginUsername> Logger
@inject UserManager<ApplicationUser> UserManager
@inject SessionService SessionService
@inject IMemoryCache MemoryCache

<PageTitle>Login</PageTitle>
<HeadContent>
    <meta name="description" content="Melde dich an, um Zugriff auf vereinsinterne Inhalte zu erhalten. Entdecke personalisierte Funktionen und bleibe mit unserer Gemeinschaft verbunden.">
</HeadContent>

<Headline Titel="メンバーエリア" Untertitel="Login" />

<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="Mitgliederbereich" />
        <StatusMessage ShowAsError="true" Message="@errorMessage" />

        <div>
            @* <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="loginUsername"> *@
            <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="loginUsername">
                @* <EditForm Model="Input" OnValidSubmit="LoginUser" FormName="loginUsername" Action="/Account/Login"> *@
                <DataAnnotationsValidator />
                <ValidationSummary />

                <label for="email" class="font-ptsans tracking-[0.375rem] text-right text-sm font-normal leading-tight text-black">E-Mail</label>
                <div class="mb-3">
                    <InputText @bind-Value="Input.Email"
                               class="font-ptsans w-full border border-black px-3 py-4 text-sm font-normal tracking-widest"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="Die E-Mail mit der du dich registriert hast." />
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>

                <div class="mt-8 flex flex-wrap justify-between gap-y-2">
                    <button disabled="@LoginIsBusy" type="submit" class="font-yuji h-10 w-32 transform bg-black px-5 text-center text-sm font-normal leading-tight tracking-widest text-white transition duration-150 ease-in-out hover:bg-primary active:scale-90">
                        <span class="flex-1 mx-3 text-center text-white">Login</span>
                    </button>
                    <div class="font-yuji flex h-10 transform items-center border border-black bg-white px-5 text-center text-sm font-normal leading-tight tracking-widest text-black transition duration-150 ease-in-out hover:bg-primary hover:text-white active:scale-90">
                        <a href="Account/ForgotPassword">Passwort vergessen?</a>
                    </div>
                </div>
                <div class="mt-10">
                    <p class="font-yuji mb-4 text-sm leading-tight tracking-widest text-black hover:text-primary">
                        <a href="@(NavigationManager.GetUriWithQueryParameters("Account/Register", new Dictionary<string, object?> { ["ReturnUrl"] = ReturnUrl }))">Neuen Zugang erstellen</a>
                    </p>
                    <p class="font-yuji text-sm leading-tight tracking-widest text-black hover:text-primary">
                        <a href="Account/ResendEmailConfirmation">Best&auml;tigungs E-Mail erneut versenden</a>
                    </p>
                </div>
            </EditForm>
        </div>
    </section>
</div>


@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string errorMessage = string.Empty;
    private bool LoginIsBusy = false;
    private const int MaxRequests = 5;
    private static readonly TimeSpan TimeWindow = TimeSpan.FromMinutes(1);

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(this.Input?.Email))
        {
            // Setze den Benutzernamen in der Sitzung
            // var username = session?.GetString("Username") ?? "";
            var username = SessionService.GetUsername();
            if (!string.IsNullOrWhiteSpace(username))
            {
                this.Input.Email = username;
            }
        }
    }

    public async Task LoginUser(EditContext editContext)
    {
        bool skipRequestCount = false;

        if (LoginIsBusy)
            return;

        LoginIsBusy = true;
        var key = $"{HttpContext.Connection.RemoteIpAddress}:{nameof(LoginUser)}";
        if (!MemoryCache.TryGetValue(key, out int requestCount))
        {
            requestCount = 0;
        }

        if (requestCount >= MaxRequests)
        {
            errorMessage = "Du hast leider zu viele Login Versuche gebraucht. Bitte versuche es später erneut.";
            await InvokeAsync(() => StateHasChanged());
            return;
        }

        try
        {
            var user = await UserManager.FindByEmailAsync(Input.Email);
            if (user != null)
            {
                SessionService.SetUsername(Input.Email);
                //User Found, go to Password-Entry-Page.
                skipRequestCount = true;
                NavigationManager.NavigateTo("Account/Password");
            }
            else
            {
                //User not Found.
                errorMessage = "Das ging wohl leider nicht. Bitte prüfe deine E-Mail Adresse noch einmal.";
                await InvokeAsync(() => StateHasChanged());
            }
        }
        catch (NavigationException navi)
        {
            //Die NavigationException muss geworfen werden, damit der Redirect funktioniert
            Logger.LogError(navi, "Navigationsfehler beim Anmelden");
            throw navi;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Anmelden");
            errorMessage = "Ein Fehler ist aufgetreten. Bitte versuche es später erneut.";
            await InvokeAsync(() => StateHasChanged());
        }
        finally
        {
            //Nicht erhöhen wenn ein korrekter Login!
            if (!skipRequestCount)
            {
                // Erhöhe den requestCount und speichere ihn im Cache
                MemoryCache.Set(key, ++requestCount, TimeWindow);
                LoginIsBusy = false;
            }
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = Messages.EmailRequiredErrorMessage)]
        [EmailAddress(ErrorMessage = Messages.EmailFormatErrorMessage)]
        [Display(Name = "Email")]
        public string Email { get; set; } = "";

        // [Required(ErrorMessage = Messages.PasswordRequiredErrorMessage)]
        // [DataType(DataType.Password)]
        // public string Password { get; set; } = "";

        // [Display(Name = "Eingeloggt bleiben??")]
        // public bool RememberMe { get; set; }
    }
}
