@page "/Account/AccessDenied"

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Zugriff verweigert</PageTitle>

<Überschrift Titel="アクセス拒否" Untertitel="Zugriff verweigert" />
<div class="container mx-auto max-w-screen-md">
    <section class="mx-10">
        <SectionBanner Titel="Sie sind nicht berechtigt für den Zugriff" />

        @if (UserHasNoRoles)
        {
            <StatusMessage ShowAsError="true" Message="Bitte logge dich mit einem gültigen Benutzer ein! Wenn du Probleme mit deinem Zugang hast, frag bitte im Dojo nach Hilfe." />
        }
        else if (UserHasOnlyGuestRole)
        {
            <StatusMessage ShowAsError="false" Message="Dein Zugang ist erstellt, aber er muss erst von einem Abteilungsleiter bestätigt werden. Erst dann hast du Zugriff auf den Mitgliederbereich." />
        }
        else if (NichtAktiviert)
        {
            <StatusMessage ShowAsError="false" Message="Dein Zugang ist noch nicht aktiviert. Bitte wende dich an deinen Abteilungsleiter, um deinen Zugang zu aktivieren." />
        }
        else
        {
            <StatusMessage ShowAsError="true" Message="Bitte logge dich mit einem gültigen Benutzer ein! Wenn du Probleme mit deinem Zugang hast, frag bitte im Dojo nach Hilfe." />
        }
    </section>
</div>

@code
{
    private bool UserHasNoRoles { get; set; }
    private bool UserHasOnlyGuestRole { get; set; }
    private bool NichtAktiviert { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (claimsPrincipal != null)
        {
            var user = await UserManager.GetUserAsync(claimsPrincipal);
            if (user != null)
            {
                UserHasNoRoles = !claimsPrincipal.Claims.Any(c => c.Type == ClaimTypes.Role);
                UserHasOnlyGuestRole = claimsPrincipal.IsInRole(Roles.Gast);
                NichtAktiviert = user.Verified == false;
            }
        }
    }
}