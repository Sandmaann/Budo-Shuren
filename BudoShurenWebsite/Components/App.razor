@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="Aikido, Genbukan, Bujinkan, Kampfkünste, Augsburg, traditionell, japanisch, Budo, Iaido, Jodo, Ninjutsu, Taijutsu, Kenjutsu" />
    <meta name="author" content="Budo Shuren Dojo" />

    @* <base href="/" /> *@
    @*     <base href="@((Environment.IsDevelopment()) ? "/" : "/budoshuren/")" /> *@

    @* lokal, zum debuggen, oder wenn die App später untder der richtigen domain veröffnetlich ist*@
    <base href="/" />
    
    @* astrum, da die URL hier unter https://02gd.astrum-it.de/budoshuren/ läuft müssen auch die Routen entsprechend passen!*@
    @* Das sollte man, wenn die App veröffentlich ist, entfernen!*@
    @* Die Pfade der statischen Bilder müssen auch von / budoshuren / images / auf / images / umgestellt werden (bzw. umgekehrt) (48 Vorkommen aktuell !)*@
    @* Achtung: Bei der Komponente "Weiterleitung" ist das /budoshuren ebenfalls fest drin - solange das drin ist, gehen keine EXTERNEN Links!*@
@*     <base href="/budoshuren/" /> *@

    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="styleguide.css" />
    <link rel="stylesheet" href="BudoShurenWebsite.styles.css" />
    <link rel="stylesheet" href="budo-shuren.css" />

    <link rel="icon" type="image/x-icon" href="images/favicon.ico" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    @* fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Yuji+Syuku&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@48,400,0,0" />
    @* syncfusion *@
    <link href="_content/Syncfusion.Blazor.Themes/bootstrap5.css" rel="stylesheet" />

    <HeadOutlet />
</head>

<body onclick="bodyClick(event)">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Syncfusion.Blazor.Core/scripts/syncfusion-blazor.min.js" type="text/javascript"></script>
    <script src="script.js" defer></script>


    @* Blazor Bug - scrollt nicht korrekt nach oben bei Navigation in .NET 8 - das hier ist ein workaround *@
    @* Eigentlich sollte "<FocusOnNavigate RouteData="routeData" Selector="h1" />" in Routes.razor das machen! *@
    <script>
        window.Blazor.addEventListener("enhancedload", () => {
            window.scroll({ top: 0, left: 0, behavior: 'instant' });
        });
    </script>

    @* Close Sf-MenuBar when clicked outside *@
    <script>
        var GLOBAL = {};
        GLOBAL.DotNetReference = null;
        GLOBAL.SetDotnetReference = function (pDotNetReference) {
            GLOBAL.DotNetReference = pDotNetReference;
        };

        function bodyClick(e) {
            if (!document.querySelectorAll('.e-menu-header').length || !document.querySelectorAll('.e-menu-parent').length) {
                return;
            }
            if (!e.target.classList.contains("e-menu-container") && e.target.closest('.e-menu-container') == null) {
                if (GLOBAL.DotNetReference) {
                    GLOBAL.DotNetReference.invokeMethodAsync("HamburgerMenu", "documentClick");
                }
            }
        }
    </script>
</body>

</html>
