@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime jsRuntime

<div class="z-20 font-yuji fixed start-0 top-0 w-full bg-white">
    <div class="mx-auto max-w-screen-xl md:flex md:justify-between md:items-center">
        <div class="flex flex-wrap items-center justify-between p-3 md:order-2">
            <div class="ml-6 flex flex-row md:hidden">
                <button @onclick="ToggleMenu" style="margin-right:1.5rem">
                    <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                        <path fill-rule="evenodd"
                              d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z" />
                    </svg>
                </button>
                <div>
                    <li class="list-none py-1">
                        <NavLink href="@currentUrl" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            @Title
                        </NavLink>
                    </li>
                </div>
            </div>
            <div class="mr-6 md:mr-0">
                <AuthorizeView>
                    <Authorized>
                        <div class="md:order-2">
                            <form action="Account/Logout" method="post">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                <button type="submit" class="nav-link rounded px-3 py-2 text-black hover:underline active:underline">
                                    <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                                </button>
                            </form>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <li class="nav-item list-none py-1">
                            <NavLink href="/Account/Login" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                                Login
                            </NavLink>
                        </li>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        @{
            //Lokale Variablen um die Nav-Bar zu verwalten
            //1. Die Nav-Bar soll ausgeblendet sein, wenn Mobile-Size
            //2. Die Nav-Bar soll in einem Drop-Down nach unten aufgehen in Mobile-Size
            //3. Die Nav-Bar soll sich nach unten ausweiten, Transition !
            //4. Die Desktop-Ansicht soll davon nicht betroffen sein!

            //Geteilte Werte
            var basis = "transition-height ease-in-out duration-500 overflow-hidden";
            //Expanded-Werte, Höhe muss angegeben werden ansonsten greift die Transition nicht
            var expanded = "h-[272px] " + basis;
            //Collapsed-Werte mit MediaQuery für Desktop
            var collapsed = "h-0 md:h-auto " + basis;
            //Sichtbarkeit der Nav-Bar je nach Button-Klick
            var menuVisibleClass = _menuVisible ? "" : "hidden";
        }
        <div class="flex-1 @( _menuVisible ? expanded : collapsed)" @onmouseleave="@(() => _menuVisible = false)" @onfocusout="@(() => _menuVisible = false)">
            <div class="flex-1 items-center justify-center">
                <ul class="md:ml-16 @($"flex flex-col {menuVisibleClass} flex-wrap px-4 py-2 md:flex md:flex-row items-center justify-center transition overflow-hidden")">
                    <li class="nav-item px-3 py-1">
                        <NavLink href="" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Home
                        </NavLink>
                    </li>
                    <li class="nav-item px-3 py-1">
                        <NavLink href="/Aikido" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Aikido
                        </NavLink>
                    </li>

                    <li id="genbukan-menu" class="nav-item px-3 py-1">
                        <NavLink href="/Genbukan" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Genbukan
                        </NavLink>
                        <div id="dropdown" class="fixed w-20 bg-white">
                            <div class="mx-auto flex flex-col items-center justify-center">
                                <NavLink href="/Iaido" class="nav-link underline-offset-4 my-2 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                                    Iaidô
                                </NavLink>
                                <NavLink href="/Jodo" class="nav-link underline-offset-4 my-2 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                                    Jôdô
                                </NavLink>
                            </div>
                        </div>
                    </li>

                    <li class="nav-item px-3 py-1">
                        <NavLink href="/Bujinkan" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Bujinkan
                        </NavLink>
                    </li>
                    <li class="nav-item px-3 py-1">
                        <NavLink href="/wie-fange-ich-an" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            <span class="text-center">Wie fange ich an?</span>
                        </NavLink>
                    </li>
                    <li class="nav-item px-3 py-1">
                        <NavLink href="/Verein" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Verein
                        </NavLink>
                    </li>
                    <li class="nav-item px-3 py-1">
                        <NavLink href="/Kontakt" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Kontakt
                        </NavLink>
                    </li>
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item px-3 py-1">
                                <NavLink href="/Account/Member" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                                    Mitgliederbereich
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </div>
</div>

<style>



    #dropdown {
        display: none;
    }

    #genbukan-menu:hover #dropdown {
        display: block;
    }

    .nav-item {
    }

    .nav-link {
    }

    .nav-item .nav-link.active {
        text-decoration: underline;
    }
</style>


@code {
    private string? currentUrl;
    public string Title = "";
    // private bool collapseNavMenu = true;

    // private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // private void ToggleNavMenu()
    // {
    //     collapseNavMenu = !collapseNavMenu;
    // }

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    public void GetTitle()
    {
        //TODO das wird evtl. durch das 2. Menu im Mitgliederbereich gestört!
        switch (currentUrl)
        {
            case "":
                Title = "Home"; break;
            case "Aikido":
                Title = "Aikido"; break;
            case "Genbukan":
                Title = "Genbukan"; break;
            case "Iaido":
                Title = "Iaido"; break;
            case "Jodo":
                Title = "Jodo"; break;
            case "Bujinkan":
                Title = "Bujinkan"; break;
            case "wie-fange-ich-an":
                Title = "Wie fange ich an?"; break;
            case "Verein":
                Title = "Verein"; break;
            case "Kontakt":
                Title = "Kontakt"; break;
            case "Account/Member":
                Title = "Mitgliederbereich"; break;
            case "Account/Login":
                Title = "Mitgliederbereich"; break;
            default:
                if (currentUrl?.Contains("Account/Member/") == true)
                    Title = "Mitgliederbereich";
                break;
        }
        StateHasChanged();

        //Aktuellen Titel aus dem DOM mit JS ausleseen hat nicht funktioniert
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);

        if (_menuVisible)
            _menuVisible = false;
        StateHasChanged();
        GetTitle();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private bool _menuVisible = false;

    private void ToggleMenu()
    {
        _menuVisible = !_menuVisible;
    }
}
