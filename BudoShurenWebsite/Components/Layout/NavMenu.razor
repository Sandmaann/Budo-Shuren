@implements IDisposable
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<div class="z-20 fixed start-0 top-0 w-full bg-white">
    <div class="mx-auto max-w-screen-xl md:flex md:justify-between md:items-center">
        <div class="flex items-center p-3 md:order-2">
            <button @onclick="ToggleMenu" class="md:hidden" style="margin-right:1.5rem">
                <svg class="h-6 w-6 fill-current" viewBox="0 0 24 24">
                    <path fill-rule="evenodd"
                          d="M4 5h16a1 1 0 0 1 0 2H4a1 1 0 1 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2zm0 6h16a1 1 0 0 1 0 2H4a1 1 0 0 1 0-2z" />
                </svg>
            </button>

            <AuthorizeView>
                <Authorized>
                    <div class="md:order-2">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link rounded px-3 py-2 text-black hover:underline active:underline">
                                <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                            </button>
                        </form>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <li class="nav-item list-none py-1">
                        <NavLink href="/Account/Login" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                            Login
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </div>


        <div class="flex-1 items-center justify-center">
            @{
                var menuVisibleClass = _menuVisible ? "" : "hidden";
            }
            <ul class="@($"flex flex-col {menuVisibleClass} flex-wrap px-4 py-2 md:flex md:flex-row items-center justify-center")">
                <li class="nav-item px-3 py-1">
                    <NavLink href="" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Home
                    </NavLink>
                </li>
@*                 <li class="nav-item px-3 py-1">
                    <NavLink href="/Home-alt" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Home-alt
                    </NavLink>
                </li>   *@   
                <li class="nav-item px-3 py-1">
                    <NavLink href="/Aikido" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Aikido
                    </NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink href="/Bujinkan" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Bujinkan
                    </NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink href="/Genbukan" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Genbukan
                    </NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink href="/wie-fange-ich-an" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        <span class="text-center">Wie fange ich an?</span>
                    </NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink href="/Verein" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Verein
                    </NavLink>
                </li>
                <li class="nav-item px-3 py-1">
                    <NavLink href="/Kontakt" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                        Kontakt
                    </NavLink>
                </li>
                <AuthorizeView>
                    <Authorized>
                        <li class="nav-item px-3 py-1">
                            <NavLink href="/Account/Member" class="nav-link underline-offset-4 hover:underline" aria-current="page" Match="NavLinkMatch.All">
                                Mitgliederbereich
                            </NavLink>
                        </li>
                    </Authorized>
                </AuthorizeView>
            </ul>
        </div>

    </div>
</div>

