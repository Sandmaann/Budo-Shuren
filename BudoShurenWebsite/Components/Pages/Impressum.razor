@code {
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;

    private List<Abteilung> Abteilungen { get; set; } = new();
    private Abteilung FallbackAbteilung => new Abteilung
    {
        ID = Abteilung.Aikido,
        Name = Abteilung.Aikido,
        Abteilungsleiter = "",
        Email = "",
        Kontaktperson = "",
        Telefon = "",
        SortOrder = 0,
    };

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            _ = LoadDataAsync();
        }
    }

    private async Task LoadDataAsync()
    {
        if (IsLoading)
            return;
        try
        {
            IsLoading = true;
            ErrorMessage = string.Empty;
            Abteilungen = new();
            StateHasChanged();

            using var context = await DbContextFactory.CreateDbContextAsync();
            var data = await context.Abteilungen.OrderBy(x => x.SortOrder).ThenBy(x => x.Name).AsNoTracking().ToListAsync();
            if (data != null)
                this.Abteilungen = data;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            IsLoading = false;
            Logger.LogError(ex, "Fehler beim Laden der Daten für das Impressum.");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}