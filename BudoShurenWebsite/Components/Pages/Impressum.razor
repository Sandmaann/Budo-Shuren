                {
                    <StatusMessage ShowAsError="true" Message="@ErrorMessage" />

                    <Standardtext IsBold="true" Text="@FallbackAbteilung.Name" />
                    <Standardtext Text="@FallbackAbteilung.Kontaktperson" />
                    <Standardtext Text="@("Tel: " + FallbackAbteilung.Telefon)" />
                    <Standardtext Text="@("E-Mail: " + FallbackAbteilung.Email)" />
