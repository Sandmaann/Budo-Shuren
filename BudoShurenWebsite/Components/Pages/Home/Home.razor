@page "/"

@using BudoShurenWebsite.Components.Shared
@using BudoShurenWebsite.Components.Pages

<PageTitle>Budo Shuren Dojo</PageTitle>
<HeadContent>
    <meta name="description" content="Im Budo Shuren Dojo Augsburg werden die traditionellen japanischen Kampfkünste Aikido, Genbukan und Bujinkan unterrichtet. Trainiere Budo wie in Japan." />
</HeadContent>

<div>
    <Headline Titel="武道修練道場"
                 Untertitel="Budo Shuren Dojo"
                 Anekdote="Augsburg" />

</div>
<div class="container mx-auto max-w-screen-md">
    <div class="mx-10">
        <section>
            <SectionBanner Titel="Neuigkeiten" />
            <div>
                <Neuigkeiten />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Wer sind wir" />
            <div class="font-ptsans text-sm font-normal tracking-wider text-black md:ml-52">
                <Standardtext Text="Das Budo Shuren Dojo ist ein einzigartiger Verein, der drei verschiedene Kampfkünste unter einem Dach vereint. Diese Kampfkünste sind Aikido, vertreten durch das Aiki Shuren Dojo, Genbukan, repräsentiert durch Genbukan Augsburg, und Bujinkan, vertreten durch das Bujinkan Busshin Dojo. Jede dieser Abteilungen trainiert ihre jeweilige Kunst individuell, aber alle profitieren von der starken Gemeinschaft innerhalb des Dojos." />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Unsere Kampfkünste" />
            <div>
                <Kampfkunst />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Termine" />
            <div>
                <Kalender IsEditable="false" IsWochenansicht="false" Abteilung="Alle" />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Galerie" />
            <div>
                <GalerieCarousel Typ="@GalerieTyp.Home" />
            </div>
        </section>
    </div>
</div>

