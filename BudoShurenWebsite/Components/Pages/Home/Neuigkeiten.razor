@rendermode InteractiveServer

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject BildVariantenService BildVarianten

<div class="neuigkeiten-rahmen -mx-10 md:-mx-20">
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <StatusMessage ShowAsError="true" Message="@ErrorMessage" />
    }
    else if (NeuigkeitenData is null)
    {
        @* Nur wenn der vorgerenderte Stand nicht übernommen werden konnte: die Daten werden noch geladen *@
        <Spinner />
    }
    else
    {
        @if (NeuigkeitenData.Any())
        {
            @* Vorgerenderte Liste: alle Neuigkeiten stehen für Suchmaschinen im HTML, sichtbar ist wie im Karussell
               nur die erste. Die Liste bleibt auch unter dem Karussell stehen und hält die Höhe, damit die Seite
               beim Umschalten nicht springt (siehe Stile unten). Ohne JavaScript sind alle Neuigkeiten sichtbar. *@
            <noscript>
                <style>
                    .neuigkeiten-stapel { display: block; }
                    .neuigkeiten-stapel > article { visibility: visible; }
                </style>
            </noscript>
            <div class="neuigkeiten-stapel @(_interactiveReady ? "abgeloest" : "")">
            @foreach (var neuigkeit in NeuigkeitenData)
            {
                <article class="mx-10 mb-10 md:mx-20">
                    <div class="headline mb-4 flex flex-col md:mb-8 md:flex-row">
                        <h2 class="font-yuji text-3xl font-normal tracking-widest text-black">
                            @neuigkeit.Titel
                        </h2>

                        <div class="min-w-0 md:flex-1 md:min-w-44">
                            @if (!string.IsNullOrWhiteSpace(neuigkeit.Ort))
                            {
                                <div class="font-ptsans text-right text-sm tracking-wider text-black">
                                    <span class="font-bold">Ort:</span> @neuigkeit.Ort
                                </div>
                            }

                            @if (neuigkeit.Datum != null)
                            {
                                <div class="font-ptsans text-right text-sm tracking-wider text-black">
                                    <span class="font-bold">Zeit:</span> @(neuigkeit.Datum?.ToString("ddd. dd. MMM yyyy"))
                                </div>
                            }
                        </div>
                    </div>

                    <div>
                        <img class="neuigkeit-bild @(neuigkeit.BildHochkant ? "hochkant" : "")"
                             src="@GetImageUrl(neuigkeit.DbImageId)"
                             loading="@Ladeart(neuigkeit)"
                             fetchpriority="@Prioritaet(neuigkeit)"
                             alt="@neuigkeit.Titel"
                             title="@neuigkeit.Quellenangabe"
                             onerror="this.onerror=null;this.src='/images/missingimage.jpg';" />

                        <p class="font-ptsans text-sm font-normal tracking-wider text-black">
                            @neuigkeit.Beschreibung
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(neuigkeit.Link))
                    {
                        <div class="mt-5">
                            <Weiterleitung Link="@neuigkeit.Link" Text="@("→ " + neuigkeit.Linktext)" NewWindow="true" />
                        </div>
                    }
                </article>
            }
            </div>
        }
        else
        {
            <div class="mx-10 mb-10 md:mx-20">
                <p class="font-ptsans text-sm font-normal tracking-wider text-black">
                    Im Moment gibt es keine Neuigkeiten.
                </p>
            </div>
        }
    }
    @if (_interactiveReady)
    {
        @if (NeuigkeitenData is { Count: > 0 } && string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <SfCarousel ShowIndicators="true" AutoPlay="true">
                <ChildContent>
                    @foreach (var neuigkeit in NeuigkeitenData)
                    {
                        <CarouselItem>
                            <article class="mx-10 mb-10 md:mx-20">
                                <div class="headline mb-4 flex flex-col md:mb-8 md:flex-row">
                                    <div class="font-yuji text-3xl font-normal tracking-widest text-black">
                                        @neuigkeit.Titel
                                    </div>
                                    <div class="min-w-0 md:flex-1 md:min-w-44">
                                        @if (!string.IsNullOrWhiteSpace(neuigkeit.Ort))
                                        {
                                            <div class="font-ptsans text-right text-sm tracking-wider text-black">
                                                <span class="font-bold">Ort:</span> @neuigkeit.Ort
                                            </div>
                                        }

                                        @if (neuigkeit.Datum != null)
                                        {
                                            <div class="font-ptsans text-right text-sm tracking-wider text-black">
                                                <span class="font-bold">Zeit:</span> @(neuigkeit.Datum?.ToString("ddd. dd. MMM yyyy"))
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div>
                                    @* Ersatzbild per JavaScript wie in der vorgerenderten Liste: kein Umweg über den Server je Bild *@
                                    <img class="neuigkeit-bild @(neuigkeit.BildHochkant ? "hochkant" : "")"
                                         src="@GetImageUrl(neuigkeit.DbImageId)"
                                         loading="@Ladeart(neuigkeit)"
                                         fetchpriority="@Prioritaet(neuigkeit)"
                                         alt="@neuigkeit.Titel"
                                         title="@neuigkeit.Quellenangabe"
                                         onerror="this.onerror=null;this.src='/images/missingimage.jpg';" />

                                    <p class="font-ptsans text-sm font-normal tracking-wider text-black">
                                        @neuigkeit.Beschreibung
                                    </p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(neuigkeit.Link))
                                {
                                    <div class="mt-5">
                                        <Weiterleitung Link="@neuigkeit.Link" Text="@("→ " + neuigkeit.Linktext)" NewWindow="true" />
                                    </div>
                                }
                            </article>
                        </CarouselItem>
                    }
                </ChildContent>

                <IndicatorsTemplate>
                    <div class="indicator">
                        <div class="fs-6"></div>
                    </div>
                </IndicatorsTemplate>

                <PreviousButtonTemplate>
                    <SfButton CssClass="e-flat e-outline nav-btn" title="Previous">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                            <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                        </svg>
                    </SfButton>
                </PreviousButtonTemplate>

                <NextButtonTemplate>
                    <SfButton CssClass="e-flat e-outline nav-btn" title="Next">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                            <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                        </svg>
                    </SfButton>
                </NextButtonTemplate>
            </SfCarousel>
        }
    }
</div>

<style>
    /* Bilder in festem Format (Querformat 4:3, Hochformat 3:4), passend zu den Maßen in BildZuschnitt.
       Der Platz ist damit schon reserviert, bevor das Bild geladen ist. Schmal: Bild über dem Text. */
    .neuigkeit-bild {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        margin: 0 auto 1.5rem;
    }

        .neuigkeit-bild.hochkant {
            width: min(100%, 18rem);
            aspect-ratio: 3 / 4;
        }

    /* Ab Tailwind "md": Bild rechts, der Text läuft links daran vorbei */
    @@media (min-width: 768px) {
        .neuigkeit-bild {
            float: right;
            width: 28rem;
            margin: 0 0 2.5rem 2.5rem;
        }

            .neuigkeit-bild.hochkant {
                width: 18rem;
            }
    }

    /* Liste und Karussell liegen in derselben Gitterzelle übereinander, die höhere von beiden bestimmt die Höhe */
    .neuigkeiten-rahmen {
        display: grid;
    }

        .neuigkeiten-rahmen > * {
            grid-area: 1 / 1;
            min-width: 0;
        }

    /* Auch die Neuigkeiten der Liste liegen übereinander: so hoch wie die höchste, wie im Karussell */
    .neuigkeiten-stapel {
        display: grid;
    }

        .neuigkeiten-stapel > article {
            grid-area: 1 / 1;
            min-width: 0;
            display: flow-root;
            visibility: hidden;
        }

            .neuigkeiten-stapel > article:first-child {
                visibility: visible;
            }

    /* Sobald das Karussell seine Folien hat, übernimmt es; die Liste hält unsichtbar weiter die Höhe.
       Browser ohne :has() entfernen die Liste stattdessen, wenn das Karussell kommt. */
    .neuigkeiten-stapel.abgeloest {
        display: none;
    }

    @@supports selector(:has(*)) {
        .neuigkeiten-stapel.abgeloest {
            display: grid;
        }

        .neuigkeiten-rahmen:has(.e-carousel-item) .neuigkeiten-stapel > article {
            visibility: hidden;
        }
    }

    .e-carousel .e-carousel-navigators .e-btn:active,
    .e-carousel .e-carousel-navigators .e-btn:hover {
        background-color: transparent !important;
    }

    .e-carousel .e-carousel-navigators .e-btn svg {
        fill: none;
        stroke: #2A6749;
        stroke-linecap: square;
        stroke-width: 2px;
        height: 2rem;
        vertical-align: middle;
        width: 2rem;
    }

    .e-carousel .e-carousel-navigators .e-previous .e-btn svg {
        transform: rotate(180deg);
    }

    .e-carousel .slide-content {
        align-items: center;
        display: flex;
        font-size: 1.25rem;
        height: 100%;
        justify-content: center;
    }

    .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar .indicator {
        background-color: #ECECEC;
        border-radius: 0.25rem;
        cursor: pointer;
        display: flex;
        height: 6px;
        justify-content: center;
        margin: 0.5rem;
        width: 24px;
    }

        .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar .indicator .fs-6 {
            margin: auto;
        }

    .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar.e-active .indicator {
        background-color: #2A6749;
        color: #fff;
    }
</style>

@code {
    private const int Schwellenwert = 5;

    private bool _interactiveReady;
    private string ErrorMessage { get; set; } = string.Empty;

    /// <summary>
    /// Null, solange nicht geladen. Der vorgerenderte Stand wird an die interaktive Seite übergeben:
    /// so wird nicht doppelt geladen, und die (zufällige) Reihenfolge bleibt beim Umschalten auf das Karussell gleich.
    /// </summary>
    [PersistentState]
    public List<Neuigkeit>? NeuigkeitenData { get; set; }

    // Verkleinerte, auf das feste Format zugeschnittene Fassung (BildVariantenService)
    private string GetImageUrl(int? dbImageId)
    {
        return dbImageId.HasValue ? $"/Account/Member/Filesave/GetImage/{dbImageId.Value}?variante=neuigkeit" : "/images/missingimage.jpg";
    }

    // Nur das erste Bild ist beim Laden der Seite sichtbar: sofort und bevorzugt laden, die übrigen erst bei Bedarf
    private bool IstErste(Neuigkeit neuigkeit) => NeuigkeitenData is [var erste, ..] && ReferenceEquals(erste, neuigkeit);
    private string Ladeart(Neuigkeit neuigkeit) => IstErste(neuigkeit) ? "eager" : "lazy";
    private string? Prioritaet(Neuigkeit neuigkeit) => IstErste(neuigkeit) ? "high" : null;

    protected override async Task OnInitializedAsync()
    {
        NeuigkeitenData ??= await LoadNeuigkeiten();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task<List<Neuigkeit>?> LoadNeuigkeiten()
    {
        using var context = DbContextFactory.CreateDbContext();

        try
        {
            var now = DateTime.Now;

            var all = await context.Neuigkeiten
                .AsNoTracking()
                .OrderBy(x => x.Sortierung)
                .ToListAsync();

            var echte = all
                .Where(x => !x.IstStandardneuigkeit && (x.Ablaufdatum == null || x.Ablaufdatum > now))
                .ToList();

            var fehlende = Math.Max(0, Schwellenwert - echte.Count);

            var standards = all
                .Where(x => x.IstStandardneuigkeit)
                .Take(fehlende)
                .ToList();

            var data = echte
.Concat(standards)
.GroupBy(x => x.Sortierung)
.SelectMany(group => group.OrderBy(_ => Random.Shared.Next()))
.ToList();

            // var data = echte
            //     .Concat(standards)
            //     .OrderBy(x => x.Sortierung)
            //     .ToList();

            var masse = await BildVarianten.AbmessungenAsync(data.Where(x => x.DbImageId != null).Select(x => x.DbImageId!.Value).ToList());
            foreach (var neuigkeit in data)
            {
                neuigkeit.BildHochkant = neuigkeit.DbImageId is { } bildId
                    && masse.TryGetValue(bildId, out var m) && BildZuschnitt.IstHochkant(m.Breite, m.Hoehe);
            }

            ErrorMessage = string.Empty;
            return data;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            return null;
        }
    }
}