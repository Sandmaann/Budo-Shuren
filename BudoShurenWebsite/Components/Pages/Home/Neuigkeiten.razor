        <ChildContent>
            <CarouselItem>
                <div class="mx-10 md:mx-20">
                    <div class="headline mb-4 flex flex-col md:mb-8 md:flex-row">
                        <div class="text-justify text-black text-3xl font-normal font-['Yuji Syuku'] tracking-widest">Frühlingsfest</div>
                        <div class="text-right md:flex-1">
                            <div><span class="font-bold">Ort:</span> Augsburg, botanischer Garten</div>
                            <div><span class="font-bold">Zeit:</span> So. 12. Mai 2024</div>
                        </div>
                    </div>
                    <div class="md:flex md:flex-row">
                        <div class="image md:order-2">
                            <img src="images/pagode.jpg" alt="Japanisches Bild" />
                        </div>
                        <div class="description mr-16 mt-4 md:min-w-[216px] md:mt-0 text-black text-sm font-normal font-['PT Sans'] tracking-wider">
                            Das Shuren Budo Dojo in Augsburg ist ein Ort, an dem Kampfkunst, Selbstverteidigung und persönliche Entwicklung im Mittelpunkt stehen. Geführt von erfahrenen Lehrern, bietet das Dojo eine Vielzahl von Trainingsmöglichkeiten für Menschen jeden Alters und jeder Erfahrungsstufe.
