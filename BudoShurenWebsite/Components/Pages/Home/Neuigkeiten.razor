@rendermode InteractiveServer

@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons

@inject IHostEnvironment Environment
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<div class="-mx-10 md:-mx-20">
    @if (IsLoading)
    {
        <Spinner Text="Einen Moment, wir suche die neuesten Informationen zusammen." />
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <StatusMessage ShowAsError="true" Message="@ErrorMessage" />
        }
        else
        {
            <SfCarousel ShowIndicators="true" AutoPlay="true">
                <ChildContent>
                    @foreach (var neuigkeit in NeuigkeitenData)
                    {
                        <CarouselItem>
                            <div class="mx-10 mb-10 md:mx-20">
                                <div class="headline mb-4 flex flex-col md:mb-8 md:flex-row">
                                    <div class="font-yuji text-justify text-3xl font-normal tracking-widest text-black">@neuigkeit.Titel</div>
                                    <div class="min-w-0 md:flex-1 md:min-w-44">
                                        @if (!string.IsNullOrWhiteSpace(neuigkeit.Ort))
                                        {
                                            <div class="font-ptsans text-right text-sm tracking-wider text-black"><span class="font-bold">Ort:</span> @neuigkeit.Ort</div>
                                        }
                                        @if (neuigkeit.Datum != null)
                                        {
                                            <div class="font-ptsans text-right text-sm tracking-wider text-black"><span class="font-bold">Zeit: </span>@(neuigkeit.Datum?.ToString("ddd. dd. MMM yyyy"))</div>
                                        }
                                    </div>
                                </div>
                                <div>
                                    @* <img class="float-right mb-10 ml-4 max-h-96 md:ml-10 md:max-w-112" src="@neuigkeit.DisplayPath" alt="@neuigkeit.Titel" /> *@
                                    @if (neuigkeit.IsLoading)
                                    {
                                        <Spinner />
                                    }
                                    <img class="float-right mb-10 ml-4 max-h-96 md:ml-10 md:max-w-112"
                                         src="@GetImageUrl(neuigkeit?.DbImageId)"
                                         loading="lazy"
                                         alt="@neuigkeit?.Titel"
                                         title="@neuigkeit?.Quellenangabe"
                                         @onload="neuigkeit.OnImageLoaded"
                                         @onerror="neuigkeit.OnImageError" />

                                    @if (neuigkeit.ShowErrorImage)
                                    {
                                        <img class="float-right mb-10 ml-4 max-h-96 md:ml-10 md:max-w-112"
                                             src="/images/missingimage.jpg"
                                             alt="@neuigkeit?.Titel"/>
                                    }


                                    <Standardtext Text="@neuigkeit?.Beschreibung" />
                                </div>
                                @if (!string.IsNullOrWhiteSpace(neuigkeit?.Link))
                                {
                                    <div class="mt-5">
                                        <Weiterleitung Link="@neuigkeit.Link" Text="@("→ " + neuigkeit.Linktext)" NewWindow="true" />
                                    </div>
                                }
                            </div>
                        </CarouselItem>
                    }
                </ChildContent>
                <IndicatorsTemplate>
                    @{
                        <div class="indicator">
                            <div class="fs-6"></div>
                        </div>
                    }
                </IndicatorsTemplate>
                <PreviousButtonTemplate>
                    <SfButton CssClass="e-flat e-outline nav-btn" title="Previous">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                            <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                        </svg>
                    </SfButton>
                </PreviousButtonTemplate>
                <NextButtonTemplate>
                    <SfButton CssClass="e-flat e-outline nav-btn" title="Next">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40" width="40" height="40">
                            <path d="m13.5 7.01 13 13m-13 13 13-13"></path>
                        </svg>
                    </SfButton>
                </NextButtonTemplate>
            </SfCarousel>
        }
    }
</div>

<style>
    .e-carousel .e-carousel-navigators .e-btn:active,
    .e-carousel .e-carousel-navigators .e-btn:hover {
        background-color: transparent !important;
    }

    .e-carousel .e-carousel-navigators .e-btn svg {
        fill: none;
        stroke: #2A6749;
        stroke-linecap: square;
        stroke-width: 2px;
        height: 2rem;
        vertical-align: middle;
        width: 2rem;
    }

    .e-carousel .e-carousel-navigators .e-previous .e-btn svg {
        transform: rotate(180deg);
    }

    .e-carousel .slide-content {
        align-items: center;
        display: flex;
        font-size: 1.25rem;
        height: 100%;
        justify-content: center;
    }

    .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar .indicator {
        background-color: #ECECEC;
        border-radius: 0.25rem;
        cursor: pointer;
        display: flex;
        height: 6px;
        justify-content: center;
        margin: 0.5rem;
        width: 24px;
    }

        .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar .indicator .fs-6 {
            margin: auto;
        }

    .e-carousel .e-carousel-indicators .e-indicator-bars .e-indicator-bar.e-active .indicator {
        background-color: #2A6749;
        color: #fff;
    }

</style>


@code {
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;
    private IEnumerable<Neuigkeit> NeuigkeitenData { get; set; } = new List<Neuigkeit>();

    private string GetImageUrl(int? dbImageId)
    {
        return dbImageId.HasValue ? $"/Account/Member/Filesave/GetImage/{dbImageId.Value}" : "/images/missingimage.jpg";
    }
    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);
        if (firstRender)
        {
            _ = LoadNeuigkeiten();
        }
    }

    private async Task LoadNeuigkeiten()
    {
        using var context = DbContextFactory.CreateDbContext();

        if (IsLoading)
            return;
        try
        {
            IsLoading = true;
            StateHasChanged();

            var data = await context.Neuigkeiten.OrderBy(x => x.Sortierung).ToListAsync();
            foreach(var item in data)
            {
                item.StateHasChanged = () => StateHasChanged();
            }
            // foreach (var item in data)
            //     item.EnvironmentPath = Environment.ContentRootPath;
            NeuigkeitenData = data;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            IsLoading = false;
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }
}
