                        <div class="flex flex-row justify-between">
                            <div class="font-ptsans text-sm font-normal tracking-wider text-black">Montag</div>
                            <div class="font-ptsans text-sm font-normal tracking-wider text-black">19:30 - 21:00</div>
                        </div>
                        <div class="flex flex-row justify-between">
