@code {
    private bool _interactiveReady;

    private int currentIndex = 0;
    public int CurrentIndex
    {
        get => currentIndex;
        set
        {
            currentIndex = value;
            OnCurrentIndexChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            _interactiveReady = true;
            StateHasChanged();
        }
    }

    private void OnCurrentIndexChanged()
    {
        switch (CurrentIndex)
        {
            case 0:
                AikidoStyle = focusedInnerBlockStyle;
                GenbukanStyle = defaultInnerBlockStyle;
                BujinkanStyle = defaultInnerBlockStyle;
                break;
            case 1:
                AikidoStyle = defaultInnerBlockStyle;
                GenbukanStyle = focusedInnerBlockStyle;
                BujinkanStyle = defaultInnerBlockStyle;
                break;
            case 2:
                AikidoStyle = defaultInnerBlockStyle;
                GenbukanStyle = defaultInnerBlockStyle;
                BujinkanStyle = focusedInnerBlockStyle;
                break;
        }
    }

    private void KampfkunstClick(int args)
    {
        CurrentIndex = args;
    }

    private readonly string defaultInnerBlockStyle = "border-black text-black";
    private readonly string focusedInnerBlockStyle = "border-primary text-primary";

    private string AikidoStyle { get; set; } = "border-primary text-primary";
    private string BujinkanStyle { get; set; } = "border-black text-black";
    private string GenbukanStyle { get; set; } = "border-black text-black";
}