@code {
    private int currentIndex = 0;
    public int CurrentIndex
    {
        get => currentIndex;
        set
        {
            currentIndex = value;
            OnCurrentIndexChanged();
        }
    }

    private void OnCurrentIndexChanged()
    {
        switch (CurrentIndex)
        {
            case 0:
                AikidoStyle = focusedInnerBlockStyle;
                GenbukanStyle = defaultInnerBlockStyle;
                BujinkanStyle = defaultInnerBlockStyle;
                break;
            case 1:
                AikidoStyle = defaultInnerBlockStyle;
                GenbukanStyle = focusedInnerBlockStyle;
                BujinkanStyle = defaultInnerBlockStyle;
                break;
            case 2:
                AikidoStyle = defaultInnerBlockStyle;
                GenbukanStyle = defaultInnerBlockStyle;
                BujinkanStyle = focusedInnerBlockStyle;
                break;
        }
    }

    private void KampfkunstClick(int args)
    {
        CurrentIndex = args;
    }

    string defaultInnerBlockStyle = "border-black text-black";
    // string defaultInnerBlockStyle = "color: var(--default-text-color);";
    string focusedInnerBlockStyle = "border-primary text-primary";
    // string focusedInnerBlockStyle = "color: var(--highlight-text-color);";

    string AikidoStyle { get; set; } = "border-primary text-primary";
    string BujinkanStyle { get; set; } = "border-black text-black";
    string GenbukanStyle { get; set; } = "border-black text-black";


}
