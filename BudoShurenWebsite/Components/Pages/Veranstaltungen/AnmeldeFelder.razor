@using BudoShurenWebsite.Models.Enums
@using BudoShurenWebsite.Services.Veranstaltungen

@*
    Felder für Anmeldung (Detailseite) und Änderung (meine Anmeldung), je nach Einstellungen der Veranstaltung.
    Die name-Attribute werden ausdrücklich mit Praefix gesetzt: in einer Unterkomponente leitet Blazor sie sonst
    aus dem eigenen Parameter ab ("Eingabe.Vorname" statt "Formular.Eingabe.Vorname"), und die Formularbindung
    der Seite fände die Werte beim Absenden nicht.
*@

<div class="grid gap-4 md:grid-cols-2">
    <div>
        <label class="@Label" for="@Id("vorname")">Vorname *</label>
        <InputText id="@Id("vorname")" name="@Name("Eingabe.Vorname")" @bind-Value="Eingabe.Vorname" class="@Feld" autocomplete="given-name" />
        @FehlerText(nameof(AnmeldeEingabe.Vorname))
    </div>
    <div>
        <label class="@Label" for="@Id("nachname")">Nachname *</label>
        <InputText id="@Id("nachname")" name="@Name("Eingabe.Nachname")" @bind-Value="Eingabe.Nachname" class="@Feld" autocomplete="family-name" />
        @FehlerText(nameof(AnmeldeEingabe.Nachname))
    </div>
</div>
<div>
    <label class="@Label" for="@Id("email")">E-Mail *</label>
    <InputText id="@Id("email")" type="email" name="@Name("Eingabe.Email")" @bind-Value="Eingabe.Email" class="@Feld" autocomplete="email" />
    @if (EmailHinweis is not null)
    {
        <p class="mt-1 text-xs text-gray-600">@EmailHinweis</p>
    }
    @FehlerText(nameof(AnmeldeEingabe.Email))
</div>

@if (Einstellungen.TelefonFeld != FormularFeldModus.Aus)
{
    <div>
        <label class="@Label" for="@Id("telefon")">Telefon@(Stern(Einstellungen.TelefonFeld))</label>
        <InputText id="@Id("telefon")" type="tel" name="@Name("Eingabe.Telefon")" @bind-Value="Eingabe.Telefon" class="@Feld" autocomplete="tel" />
        @FehlerText(nameof(AnmeldeEingabe.Telefon))
    </div>
}
@if (Einstellungen.VereinFeld != FormularFeldModus.Aus)
{
    <div>
        <label class="@Label" for="@Id("verein")">Verein / Dojo@(Stern(Einstellungen.VereinFeld))</label>
        <InputText id="@Id("verein")" name="@Name("Eingabe.Verein")" @bind-Value="Eingabe.Verein" class="@Feld" />
        @FehlerText(nameof(AnmeldeEingabe.Verein))
    </div>
}
@if (Einstellungen.GraduierungFeld != FormularFeldModus.Aus)
{
    <div>
        <label class="@Label" for="@Id("graduierung")">Graduierung@(Stern(Einstellungen.GraduierungFeld))</label>
        <InputText id="@Id("graduierung")" name="@Name("Eingabe.Graduierung")" @bind-Value="Eingabe.Graduierung" class="@Feld" />
        @FehlerText(nameof(AnmeldeEingabe.Graduierung))
    </div>
}

@if (Einstellungen.Teilnahmemodus == Teilnahmemodus.EinzelneTage)
{
    <fieldset>
        <legend class="@Label">An welchen Tagen bist du dabei? *</legend>
        @for (var i = 0; i < Tage.Count; i++)
        {
            var index = i;
            var tag = TagInfos.Single(t => t.Id == Tage[index].Id);
            var voll = tag.FreiePlaetze == 0 && !Tage[index].Gewaehlt;
            <input type="hidden" name="@Name($"Tage[{index}].Id")" value="@tag.Id" />
            <label class="mt-1 flex items-center gap-2 @(voll ? "text-gray-400" : "")">
                <InputCheckbox name="@Name($"Tage[{index}].Gewaehlt")" @bind-Value="Tage[index].Gewaehlt" disabled="@voll" />
                @VeranstaltungTexte.Tag(tag)@(voll ? " – ausgebucht" : "")
            </label>
        }
        @if (Einstellungen.MinTageBeiTeilanmeldung > 1)
        {
            <p class="mt-1 text-xs text-gray-600">Mindestens @Einstellungen.MinTageBeiTeilanmeldung Tage.</p>
        }
        @FehlerText(nameof(AnmeldeEingabe.TagIds))
    </fieldset>
}

@if (Einstellungen.MaxBegleitpersonen > 0)
{
    <div>
        <label class="@Label" for="@Id("begleitung")">Ich bringe weitere Personen mit (Anzahl)</label>
        <InputNumber id="@Id("begleitung")" name="@Name("Eingabe.AnzahlBegleitpersonen")" @bind-Value="Eingabe.AnzahlBegleitpersonen" min="0" max="@Einstellungen.MaxBegleitpersonen" class="@($"{Feld} md:w-32")" />
        <p class="mt-1 text-xs text-gray-600">Für Begleitpersonen brauchen wir keine Daten. Höchstens @Einstellungen.MaxBegleitpersonen.</p>
        @FehlerText(nameof(AnmeldeEingabe.AnzahlBegleitpersonen))
    </div>
    <div>
        <label class="@Label" for="@Id("infoemails")">Weitere E-Mail-Adressen für Infos (optional)</label>
        <InputTextArea id="@Id("infoemails")" name="@Name("Eingabe.InfoEmails")" @bind-Value="Eingabe.InfoEmails" rows="2" class="@Feld" placeholder="eine Adresse pro Zeile" />
        <p class="mt-1 text-xs text-gray-600">Zum Beispiel für deine Begleitpersonen: Sie bekommen Infos zur Veranstaltung und können sich jederzeit abmelden. Höchstens eine Adresse je Begleitperson.</p>
        @FehlerText(nameof(AnmeldeEingabe.InfoEmails))
    </div>
}

@if (Einstellungen.BemerkungFeld != FormularFeldModus.Aus)
{
    <div>
        <label class="@Label" for="@Id("bemerkung")">Bemerkung@(Stern(Einstellungen.BemerkungFeld))</label>
        <InputTextArea id="@Id("bemerkung")" name="@Name("Eingabe.Bemerkung")" @bind-Value="Eingabe.Bemerkung" rows="3" class="@Feld" />
        @FehlerText(nameof(AnmeldeEingabe.Bemerkung))
    </div>
}

@code {
    private const string Label = "mb-1 block text-xs font-bold";
    private const string Feld = "w-full rounded border border-gray-300 p-2 text-sm";

    /// <summary>Name des [SupplyParameterFromForm]-Parameters der Seite, z. B. "Formular".</summary>
    [Parameter, EditorRequired]
    public string Praefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public AnmeldeEingabe Eingabe { get; set; } = default!;

    /// <summary>Auswahl der Tage (nur bei Teilnahmemodus EinzelneTage), gleiche Reihenfolge wie TagInfos.</summary>
    [Parameter, EditorRequired]
    public List<TagWahl> Tage { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<TagAnzeige> TagInfos { get; set; } = [];

    [Parameter, EditorRequired]
    public AnmeldeFormularEinstellungen Einstellungen { get; set; } = default!;

    [Parameter]
    public IReadOnlyDictionary<string, string>? Fehler { get; set; }

    [Parameter]
    public string? EmailHinweis { get; set; }

    private string Name(string feld) => $"{Praefix}.{feld}";

    // Eindeutig, falls zwei Formulare auf einer Seite stehen (Übersicht: "Manuell anmelden" und Bearbeiten-Panel)
    private string Id(string feld) => $"{Praefix.ToLowerInvariant()}-{feld}";

    private RenderFragment? FehlerText(string feld) =>
        Fehler?.TryGetValue(feld, out var text) == true
            ? @<p class="font-ptsans mt-1 text-xs text-red-700">@text</p>
            : null;

    private static string Stern(FormularFeldModus modus) => modus == FormularFeldModus.Pflicht ? " *" : "";
}
