@page "/veranstaltungen/benachrichtigung-abmelden/{Token}"
@* Für externe Empfänger von Organisator-Benachrichtigungen. Öffnen ändert nichts; abgemeldet wird per Klick (POST). *@

@using BudoShurenWebsite.Services.Veranstaltungen
@using Microsoft.AspNetCore.RateLimiting

@attribute [EnableRateLimiting(VeranstaltungRateLimit.Formulare)]

@inject ISelbstverwaltungService Selbstverwaltung
@inject IOptions<VeranstaltungenOptionen> Optionen

<PageTitle>Benachrichtigungen abbestellen | Budo Shuren Dojo</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex, nofollow">
</HeadContent>

<Headline Titel="武道" Untertitel="Veranstaltungen" Anekdote="" />

<div class="container mx-auto max-w-screen-md">
    <div class="font-ptsans mx-10 mb-12 text-sm">
        @if (!Optionen.Value.Aktiviert)
        {
            <Standardtext Text="Diese Seite gibt es nicht." />
        }
        else if (_abgemeldet)
        {
            <h2 class="font-yuji mb-3 text-2xl font-bold">Abgemeldet</h2>
            <p>Du bekommst keine Benachrichtigungen mehr zu dieser Veranstaltung.</p>
        }
        else if (_titel is null)
        {
            <h2 class="font-yuji mb-3 text-2xl font-bold">Link ungültig</h2>
            <p>Dieser Link ist ungültig, oder du bist bereits abgemeldet. Es gilt jeweils der Link aus der neuesten E-Mail.</p>
        }
        else
        {
            <h2 class="font-yuji mb-3 text-2xl font-bold">Benachrichtigungen abbestellen</h2>
            <p class="mb-4">Du bekommst Benachrichtigungen über Anmeldungen zu <strong>@_titel</strong>. Möchtest du keine mehr bekommen?</p>
            <EditForm Model="Formular" FormName="benachrichtigung-abmelden" OnSubmit="AbmeldenAsync" Enhance>
                <button type="submit" class="knopf-primaer">
                    Keine Benachrichtigungen mehr
                </button>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Token { get; set; } = string.Empty;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "benachrichtigung-abmelden")]
    private KnopfFormular? Formular { get; set; }

    private string? _titel;
    private bool _abgemeldet;

    protected override async Task OnInitializedAsync()
    {
        Formular ??= new();

        if (HttpContext is not null)
            VeranstaltungLinks.SicherheitsHeaderSetzen(HttpContext.Response);

        if (!Optionen.Value.Aktiviert)
        {
            if (HttpContext is { Response.HasStarted: false })
                HttpContext.Response.StatusCode = StatusCodes.Status404NotFound;
            return;
        }

        _titel = await Selbstverwaltung.BenachrichtigungAbmeldungPruefenAsync(Token);
    }

    private async Task AbmeldenAsync()
    {
        if (Optionen.Value.Aktiviert)
            _abgemeldet = await Selbstverwaltung.BenachrichtigungAbmeldenAsync(Token);
    }
}
