<style>
    .e-ddl.e-input-group.e-control-wrapper .e-ddl-icon::before {
        color: #000000;
        font-weight: 700;
    }

    .e-custom.e-input-group, .e-custom.e-input-group.e-control-wrapper {
        height: 42px;
        border-width: 1px;
        border-color: #000000;
        border-radius: 0;
    }

    .e-input-group:not(.e-success):not(.e-warning):not(.e-error), .e-input-group.e-control-wrapper:not(.e-success):not(.e-warning):not(.e-error) {
        height: 42px;
        border-color: #000000;
        border-radius: 0;
    }

    .e-ddl.e-input-group.e-control-wrapper .e-input {
        height: 42px;
        border-color: #000000;
        border-radius: 0;
    }


    .e-dropdownbase .e-list-item.e-active,
    .e-dropdownbase .e-list-item.e-active.e-hover {
        background-color: #2A6749;
    }

    .dropdown-item-container {
        text-align: center;
        padding: 10px 0;
    }

    .abteilung {
        text-align: center;
        /* PT Sans bold 14 */
        font-family: "PT Sans";
        font-size: 14px;
        font-style: normal;
        font-weight: 700;
        line-height: normal;
        letter-spacing: 1.4px;
        padding-right: 5px;
    }

    .abteilungsleiter {
        /* Pt Sans regular 14 */
        font-family: "PT Sans";
        font-size: 14px;
        font-style: normal;
        font-weight: 400;
        line-height: normal;
        letter-spacing: 1.4px;
    }

</style>

@code {
    public string DropVal = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        LocalData = await DataService.GetAbteilungenAsync();
    }

    private IEnumerable<Abteilung> LocalData = Array.Empty<Abteilung>();
}
