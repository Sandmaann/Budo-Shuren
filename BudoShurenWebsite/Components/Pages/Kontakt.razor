@page "/Kontakt"
@page "/budoshuren/Kontakt"
@rendermode InteractiveServer

<PageTitle>Kontakt - Budo Kampfkunstverein Augsburg</PageTitle>
<HeadContent>
    <meta name="description" content="Kontaktiere das Budo Shuren Dojo in Augsburg für Kampfkunst-Training. Finde alle Infos zu Anfahrt und wie du uns erreichen kannst." />
</HeadContent>

@using Syncfusion.Blazor.DropDowns;


<div>
    <Headline Titel="連係"
                 Untertitel="Kontakt" />
</div>
<div class="container mx-auto max-w-screen-md">
    <div class="mx-10">
        @if (ShowNachrichtGesendet)
        {
            <StatusMessage ShowAsError="false" Message="Deine Nachricht wurde erfolgreich versendet!" />
        }
        <section>
            <SectionBanner Titel="Erreiche uns" />
            <div class="md:flex md:flex-row">
                <div class="md:w-72">
                    <Standardtext Text="Hast du Fragen, oder möchtest du gerne bei einem Probetraining teilnehmen?" />
                    <Standardtext Text="Dann suche dir hier deine gewünschte Kampfkunst aus und schreibe uns eine Nachricht!" />
                </div>
                <div class="md:grow md:-mt-4">
                    <InteresseFormular ShowAbteilung="true" ShowText="false" ShowMarginAuswahlfelder="true" OnSend="SetMessage" />
                </div>
            </div>
        </section>

        <section>
            <SectionBanner Titel="Impressum" />
            <div>
                <div class="">
                    <div class="font-ptsans text-sm tracking-widest">
                        <p class="font-bold">Budo Shuren Dojo e.V.</p>
                        <p>Austraße 23 1/5</p>
                        <p>86153 Augsburg</p>
                        <br />
                        <p><span class="font-bold">Mobiltelefon:</span> +49 174 2010622</p>
                        <p><span class="font-bold">E-Mail Adresse:</span> info@iwama-aikido-augsburg.de</p>
                    </div>
                </div>
                <div class="mt-10">
                    <div>
                        <div class="mt-4">
                            <Standardtext Text="Die journalistisch-redaktionelle Verantwortung sowie die Zuständigkeit für Design und Programmierung liegen bei Dr. Carsten Oetzel (info [ad] iwama - aikido - augsburg [punkt] de)" />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Der Urheber räumt Ihnen ganz konkret das Nutzungsrecht ein, sich eine private Kopie für persönliche Zwecke anzufertigen. Nicht berechtigt sind Sie dagegen, die Materialien zu verändern und/oder weiter zu geben oder gar selbst zu veröffentlichen. Wenn nicht ausdrücklich anders vermerkt, liegen die Urheberrechte für die Inhalte dieser Internetpräsenz beim Budo Shuren Dojo Augsburg e.V. /Dr. Carsten Oetze" />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Dieses Impressum gilt nur für die Internetpräsenz unter den Adressen http://www.budo-shuren-dojo.de/. Als Teil des WorldWideWeb (WWW) ist sie mit fremden, sich jederzeit wandelnden Web-Sites verknüpft, die folglich nicht diesem Verantwortungsbereich unterliegen. Dass Inhalte externer Links weder gegen Sitten noch Gesetze verstoßen, wurde genau einmal geprüft, bevor sie hier aufgenommen wurden. Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir also keine Haftung für die Inhalte solcher Links. Für den Inhalt verlinkter Seiten sind ausschließlich deren Betreiber verantwortlich. Links, die zu fremden Webprojekten führen, erkennen sie daran, dass sich ein neues Browserfenster öffnet." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Falls Sie vermuten, dass von dieser Website aus eines Ihrer Schutzrechte verletzt wird, teilen Sie dies bitte umgehend per Email an info [ad] iwama - aikido - augsburg [punkt] de mit, damit zügig Abhilfe geschafft werden kann." />
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <section>
            <SectionBanner Titel="Anfahrt" />
            <Wegbeschreibung />
        </section>
    </div>
</div>

@code {
    private bool ShowNachrichtGesendet { get; set; } = false;

    private void SetMessage(bool result)
    {
        if (result)
        {
            ShowNachrichtGesendet = true;
            StateHasChanged();
        }
    }
}
