@page "/Bujinkan"
@page "/budoshuren/Bujinkan"
<PageTitle>Bujinkan - traditionelle Samurai und Ninja Schulen</PageTitle>
<HeadContent>
    <meta name="description" content="Entdecke die Kunst des Bujinkan Budo Ninjutsu Taijutsu in Augsburg. Hier trainierst du traditionelle Techniken der Ninja und Samurai für alle Altersgruppen." />
</HeadContent>


<div>
    <Headline Titel="武神館"
              Untertitel="Bujinkan"
              Anekdote="" />
</div>


<div class="container mx-auto max-w-screen-md">
    <div class="mx-10">
        <div class="mx-auto my-20 w-36 md:-mt-10">
            <img src="/budoshuren/images/bujinkan/bujinkan_logo.jpg" alt="Das Mon des Bujinkan Busshin Dojos Augsburg" />
        </div>

        @if (ShowNachrichtGesendet)
        {
            <StatusMessage ShowAsError="false" Message="Deine Nachricht wurde erfolgreich versendet!" />
        }

        <section class="mt-20 md:flex md:flex-row md:justify-between">
            <div class="mt-0 md:mt-0 md:mr-20">
                <div class="mt-0">
                    <Standardtext Text="Das Bujinkan Budo Taijutsu/Ninjutsu ist eine
                                        japanische Kampfkunst, welche von Dr.
                                        Masaaki Hatsumi gegründet wurde. Das
                                        Bujinkan vereint insgesamt neun
                                        verschiedene Schulen, die ihre Wurzeln in
                                        den alten Samurai- und Ninja-Familien
                                        haben. Dadurch bietet das Bujinkan eine
                                        beeindruckende Vielfalt an Techniken und
                                        Strategien." />
                </div>
                <div class="mt-4">
                    <Standardtext Text="In unserem Dojo legen wir großen Wert
                                        darauf, die Vielseitigkeit des Bujinkan zu
                                        vermitteln. Neben unbewaffneten Techniken
                                        wie Hebel, Würfe, Tritte, Block- und
                                        Schlagtechniken lernen unsere Schüler
                                        auch den Umgang mit traditionellen
                                        japanischen Waffen. Diese umfassende
                                        Ausbildung macht das Bujinkan Budo
                                        Taijutsu/Ninjutsu zu einer sehr vielseitigsten
                                        Kampfkunst." />
                </div>
            </div>
            <div class="mt-10 md:min-w-72 md:mt-0 md:max-w-72">
                <img src="/budoshuren/images/bujinkan/bujinkan_titel.jpg" alt="Zwei Budoka üben einen Wurf." />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Das Training" />
            <div>
                <div>
                    <Kalender Abteilung="Bujinkan" IsWochenansicht="true" />
                </div>
                <div class="mt-12 justify-between md:flex md:flex-row">
                    <div class="md:w-52">
                        <Subheadline Text="Der Unterricht" />
                    </div>
                    <div class="flex-1 mt-5 md:ml-18 md:mt-0">
                        <div>
                            <Standardtext Text="Das Erwachsenentraining ist für jeden ab dem 16. Lebensjahr geeignet, da es sich an die individuellen Anforderungen und Wünsche anpassen lässt.
                                                Somit kann Bujinkan bis ins hohe Alter trainiert werden.
                                                Dies ist möglich, da der Unterricht ohne Erfolgsdruck stattfindet und jeder selbst bestimmt,
                                                was man erreichen will. Hierbei wird man vom Lehrer entsprechend betreut.
                                                Für Kinder haben wir ein eigenes Kindertraining." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Unabhängig von Alter, Vorkenntnissen und körperlichen Voraussetzungen verbessern sich Körpergefühl und Bewegungsfähigkeit. Neben dem Ausbau der körperlichen Fähigkeit nimmt auch die geistige Entwicklung im Training einen hohen Stellenwert ein." />
                        </div>
                    </div>
                </div>
                <div class="my-10">
                    <img class="" src="/budoshuren/images/bujinkan/bujinkan_training.jpg" alt="Bild der Bujinkan Kindertrainingsgruppe bei einer Gruppenübung.">
                </div>
                <div class="mt-10 md:mr-32">
                    <div class="md:mr-20">
                        <Standardtext Text="Das Bujinkan ist einzigartig in seiner
                                            Integration verschiedener Kampftechniken
                                            wie Jujutsu, Kenjutsu, Ninjutsu und anderen.
                                            Diese Vielfalt bereitet die Praktizierenden
                                            auf eine breite Palette von Situationen vor,
                                            sei es im Nahkampf oder im Umgang mit
                                            Waffen. In unserem Dojo lehren wir den
                                            Umgang mit traditionellen Waffen wie dem
                                            Katana (Schwert), Tanto (Messer), Bo
                                            (Stock), Yari (Speer), Naginata (Hellebarde),
                                            Bogen, Ninjato (Ninja-Schwert) usw.. Diese
                                            Waffen sind nicht nur Werkzeuge der
                                            Verteidigung, sondern auch Mittel zur
                                            Entwicklung von Geschicklichkeit und
                                            Konzentration." />
                    </div>
                    <div class="mt-4 font-bold">
                        <Standardtext Text="Die neun Schulen des Bujinkan sind:" />
                    </div>
                    <ul class="ml-5 mt-2 list-outside list-disc">
                        <li class="mb-2"><p class="font-yuji font-normal tracking-widest">玉虎流骨指術<br class="md:hidden" /><span class="hidden md:inline"> - </span> Gyokko-Ryu Koshijutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">九鬼神伝流八法秘剣術<br class="md:hidden" /><span class="hidden md:inline"> - </span>Kukishin-Ryu Happo Bikenjutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">高木揚心流柔体術<br class="md:hidden" /><span class="hidden md:inline"> - </span>Takagiyoshin-Ryu Jutaijutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">虎倒流骨法術<br class="md:hidden" /><span class="hidden md:inline"> - </span>Koto-Ryu Koppojutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">神伝不動流打拳体術<br class="md:hidden" /><span class="hidden md:inline"> - </span>Shindenfudo-Ryu Dakentaijutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">義鑑流骨法術<br class="md:hidden" /><span class="hidden md:inline"> - </span>Gikan-Ryu Koppojutsu</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">雲隠流忍法<br class="md:hidden" /><span class="hidden md:inline"> - </span>Kumogakure-Ryu Ninpo</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">玉心流忍法<br class="md:hidden" /><span class="hidden md:inline"> - </span>Gyokushin-Ryu Ninpo</p></li>
                        <li class="my-2"><p class="font-yuji font-normal tracking-widest">戸隠流忍法<br class="md:hidden" /><span class="hidden md:inline"> - </span>Togakure-Ryu Ninpo</p></li>
                    </ul>
                </div>
            </div>
        </section>

        <section>
            <SectionBanner Titel="Kindertraining" />
            <div class="mt-12 justify-between md:flex md:flex-row">
                <div class="md:w-52">
                    <Subheadline Text="Bujinkan Kids" />
                </div>
                <div class="flex-1 mt-5 md:ml-18 md:mt-0">
                    <div>
                        <Standardtext Text="Im Kinder- und Jugendtraining (6 bis 16 Jahren) des Bujinkan geht es weit über das Erlernen
                                            von Kampftechniken hinaus. Unser Training ist darauf ausgerichtet,
                                            den Kindern nicht nur körperliche Fertigkeiten zu vermitteln,
                                            sondern auch ihre geistige und emotionale Entwicklung zu fördern.
                                            Durch spielerische Übungen und interaktive Lektionen werden sie ermutigt,
                                            ihre Fähigkeiten zu entdecken und ihr Selbstvertrauen aufzubauen.
                                            Dabei stehen Respekt, Disziplin und gegenseitige Unterstützung im Mittelpunkt,
                                            sodass die Kinder nicht nur körperlich, sondern auch sozial wachsen können." />
                    </div>
                </div>
            </div>
            <div class="mt-10">
                <div class="mx-10 flex justify-center md:float-right md:flex-grow md:mx-0">
                    @* <img class="mb-4 max-w-64 md:ml-16" src="/budoshuren/images/bujinkan/bujinkan_training.jpg" alt="Bild der Bujinkan Kindertrainingsgruppe bei einer Gruppenübung."> *@
                </div>
                <div class="mt-4 md:mr-64">
                    <Standardtext Text="Ein besonderer Schwerpunkt liegt auf der Fallschule und dem Rollentraining. Diese Fertigkeiten dienen nicht nur dem Selbstschutz, sondern lehren die Kinder auch, wie sie sich in unerwarteten Situationen schützen können. Durch das Beherrschen dieser Techniken gewinnen sie nicht nur an Sicherheit, sondern auch an Selbstbewusstsein im Umgang mit Herausforderungen des Alltags." />
                </div>
                <div class="mt-4 md:mr-64">
                    <Standardtext Text="Darüber hinaus bietet das Bujinkan-Training
                                            den Kindern eine faszinierende Einführung
                                            in die japanische Kampfkunst und Kultur.
                                            Dabei trainieren sie verschiedene Techniken
                                            und erfahren auch etwas über die
                                            Geschichte, die Werte und Kultur, welche
                                            damit verbunden sind. Neben einem tieferen
                                            Verständnisses für die Kunst fördert dies
                                            auch ihre Neugier und ihren Respekt für
                                            andere Kulturen." />
                </div>
            </div>
        </section>

        <section>
            <SectionBanner Titel="Der Lehrer" />
            <div class="md:flex md:flex-row md:justify-between md:h-auto">
                <div class="md:mr-20">
                    <div>
                        <img class="md:max-h-80" src="/budoshuren/images/bujinkan/johannes.jpg" alt="Porträtfoto von Johannes Schiebel, Shihan und Leiter des Bujinkan Busshin Dojos Augsburg" />
                    </div>
                    <div class="mt-10">
                        <Subheadline Text="Johannes Schiebl" />
                    </div>
                    <div class="mt-10 md:w-100">
                        <div>
                            <Standardtext Text="Seit vielen Jahren trainiere ich in den
                                                verschiedenen Kampfkünsten und widme
                                                mich der Weitergabe von Bujinkan Budo
                                                Taijutsu/Ninjutsu, so wie ich es durch meine
                                                Lehrer gelernt und erfahren habe." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Geboren wurde ich 1977 in Salzburg,
                                                Österreich. Meine Reise in den
                                                Kampfkünsten begann im Alter von etwa 14
                                                Jahren, als meine Mutter mich zu einem
                                                Shotokan Karate Dojo schickte, um einen
                                                Ausgleich von der Schule zu finden.
                                                Seitdem habe ich eine faszinierende Reise
                                                durch verschiedene Kampfkünste erlebt." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Meine Suche nach einem umfassenderen
                                                Ansatz setzte sich fort und führte mich zum
                                                Tai Chi Chuan, bevor ich mich schließlich
                                                dem Bujinkan Budo Taijutsu/Ninjutsu
                                                zuwandte. Im Jahr 2000 begann ich mein
                                                Training in dieser faszinierenden
                                                Kampfkunst und habe seitdem eine Vielzahl
                                                von Erfahrungen gesammelt." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Unter der Anleitung verschiedener Lehrer habe ich mein Wissen und meine Fähigkeiten im Bujinkan kontinuierlich erweitert. Ich hatte das Privileg, von erfahrenen Lehrern wie Markus Behmer, Stefan Filus und Holger Kunzmann zu lernen. Diese Lehrer haben mich nicht nur in den Kampfkünsten, sondern auch in meiner persönlichen Entwicklung geprägt." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Im Laufe der Jahre habe ich meine eigene Trainingsgruppe gegründet, Seminare besucht, Prüfungen abgelegt und mein Wissen kontinuierlich vertieft. Meine Reisen führten mich nicht nur durch verschiedene Städte und Länder, sondern auch nach Japan, wo ich die Gelegenheit hatte, von den besten Lehrern direkt zu lernen." />
                        </div>
                        <div class="mt-4">
                            <Standardtext Text="Seit 2016 bin ich stolzer Leiter des Bujinkan
                                                Busshin Dojo Augsburg, in welchem ich
                                                meine Leidenschaft für das Bujinkan Budo
                                                Taijutsu/Ninjutsu mit anderen teile. Neben
                                                den Kampfkünsten beschäftige ich mich
                                                auch intensiv mit verschiedenen Themen
                                                aus Asien, darunter die japanische Sprache
                                                und Geschichte der Samurai-Ära, sowie Qi-
                                                Gong, Traditionelle Chinesische Medizin (TCM),
                                                Akupressur, die 5-Elemente-Lehre und Feng Shui." />
                        </div>
                    </div>
                    <div class="mt-5">
                        <Weiterleitung Link="https://bujinkanbusshindojoblog.wordpress.com/" Text="→ Zum Blog" NewWindow="true"/>
                    </div>
                </div>

                <div class="mt-10 md:max-w-72 md:min-w-64">
                    <div class="md:h-100"></div>
                    <div>
                        <InteresseFormular Abteilung="@(Abteilung.Bujinkan)" OnSend="SetMessage" />
                    </div>
                </div>
            </div>
        </section>

        <section>
            <SectionBanner Titel="Galerie" />
            <div>
                <GalerieCarousel Typ="@GalerieTyp.Bujinkan" />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Gedanken zum Training" />
            <div>
                <Subheadline Text="Shut up and train!" />
            </div>
            <div class="mb-4 mt-10">
                <Weiterleitung Link="https://shutokukan.org/join-the-ryu/" Text="So you want to join the Ryu by Dave Lowry" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://theninjadiaryblog.wordpress.com/2016/01/25/der-weg-ins-dojo-teil-1-drei-punkte-die-passen-muessen/" Text="Der Weg ins Dojo, Teil 1" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://theninjadiaryblog.wordpress.com/2016/03/02/der-weg-ins-dojo-teil-2-warum-ausgerechnet-du/" Text="Der Weg ins Dojo, Teil 2" NewWindow="true"/>
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://theninjadiaryblog.wordpress.com/2016/03/22/der-weg-ins-dojo-teil-3-deine-entscheidung-und-eine-geheimtechnik/" Text="Der Weg ins Dojo, Teil 3" NewWindow="true" />
            </div>
        </section>

        <section>
            <SectionBanner Titel="Befreundete Dojos und weitere Links" />
            <div class="mb-4 mt-10">
                <Weiterleitung Link="http://www.bujinkan.com/" Text="Hombu Dojo" NewWindow="true"/>
            </div>
            <div class="my-4">
                <Weiterleitung Link="http://www.bkd-reutlingen.de/" Text="Bujinkan Dojo Reutlingen" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://tvconweiler.de/timetable/event/ninjutsu/" Text="Bujinkan Dojo Conweiler" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="http://www.bujinkan-fulda.de/#Startseite" Text="Bujinkan Dojo Fulda" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="http://www.xn--bujinkan-wrzburg-szb.de/" Text="Bujinkan Dojo Gerbrunn" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="http://bkd-karlsruhe.de/" Text="Bujinkan Dojo Karlsruhe" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://mtv-ludwigsburg.de/project/bujinkan/" Text="Bujinkan Dojo Ludwigsburg" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="http://bujinkan.training/" Text="Bujinkan Dojo Neuss" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://www.taijutsu.ch/" Text="Bujinkan Dojo Rüfenach (CH)" NewWindow="true" />
            </div>
            <div class="my-4">
                <Weiterleitung Link="https://bujinkan-muenchen.de/" Text="Bujinkan Sakura Dojo München" NewWindow="true" />
            </div> 
            
            <div class="my-4">
                <Weiterleitung Link="https://sites.google.com/view/augsburgohanashikai/home" Text="Augsburg Nihongo Ohanashikai" NewWindow="true" />
            </div>  
            <div class="my-4">
                <Weiterleitung Link="https://bujinkanbusshindojoblog.wordpress.com/" Text="Bujinkan Busshin Dojo Blog" NewWindow="true" />
            </div>
        </section>
    </div>
</div>

@code {
    private bool ShowNachrichtGesendet { get; set; } = false;

    private void SetMessage(bool result)
    {
        if (result)
        {
            ShowNachrichtGesendet = true;
            StateHasChanged();
        }
    }
}
