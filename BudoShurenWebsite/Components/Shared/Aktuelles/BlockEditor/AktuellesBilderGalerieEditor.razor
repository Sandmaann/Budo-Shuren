@using BudoShurenWebsite.Models

<div class="rounded border border-t-0 border-gray-300 p-4">
    <h5 class="font-ptsans mb-3 text-sm font-bold">Bilder-Galerie</h5>

    <div class="mb-3">
        <label class="font-ptsans mb-1 block text-xs font-bold">Bilder hochladen</label>
        @* vorläufig: erst "Speichern" des Beitrags übernimmt die Bilder, sonst räumt BildAufraeumJob sie auf *@
        <BildAuswahl Mehrere="true" OnHochgeladen="BildHochgeladen" />
    </div>

    @if (Block.Bilder != null && Block.Bilder.Any())
    {
        <div class="mt-3 grid grid-cols-3 gap-2">
            @foreach (var bild in Block.Bilder.OrderBy(b => b.Sortierung))
            {
                <div class="relative">
                    <img src="/Account/Member/Filesave/GetImage/@bild.BildId"
                         alt="Bild"
                         class="h-32 w-full rounded object-cover" />
                    <button type="button"
                            class="absolute right-1 top-1 rounded bg-red-500 px-2 py-1 text-xs text-white hover:bg-red-600"
                            @onclick="() => BildEntfernen(bild)">
                        ✕
                    </button>
                </div>
            }
        </div>
    }

    <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div>
            <label class="font-ptsans mb-1 block text-xs font-bold">Bilder pro Reihe (1–6)</label>
            <input type="number" min="1" max="6"
                   class="w-20 rounded border border-gray-300 p-2 text-sm"
                   @bind="Block.BilderProReihe" />
        </div>
        <div>
            <label class="font-ptsans mb-1 block text-xs font-bold">Bildunterschrift (optional)</label>
            <input type="text"
                   class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm"
                   @bind="Block.BildUnterschrift"
                   placeholder="z.B. Trainingslager 2024" />
        </div>
    </div>
</div>

@code {

    [Parameter]
    public AktuellesBlock Block { get; set; } = null!;

    private void BildHochgeladen(HochgeladenesBild bild)
    {
        var sortierung = Block.Bilder.Any() ? Block.Bilder.Max(b => b.Sortierung) + 1 : 0;
        Block.Bilder.Add(new AktuellesBild { BlockId = Block.Id, BildId = bild.Id, Sortierung = sortierung });
    }

    private void BildEntfernen(AktuellesBild bild)
    {
        Block.Bilder.Remove(bild);
        StateHasChanged();
    }

}
