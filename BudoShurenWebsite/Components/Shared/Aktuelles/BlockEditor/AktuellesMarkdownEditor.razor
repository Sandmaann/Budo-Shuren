@using BudoShurenWebsite.Models
@using Markdig

<div class="rounded border border-t-0 border-gray-300 p-4">
    <h5 class="font-ptsans mb-3 text-sm font-bold">Markdown-Text</h5>

    <div class="mb-2 flex gap-2">
        <button type="button" @onclick="InsertBold" class="rounded border border-gray-400 px-3 py-1 text-xs hover:bg-gray-100">
            <strong>Fett</strong>
        </button>
        <button type="button" @onclick="InsertItalic" class="rounded border border-gray-400 px-3 py-1 text-xs hover:bg-gray-100">
            <em>Kursiv</em>
        </button>
        <button type="button" @onclick="InsertLink" class="rounded border border-gray-400 px-3 py-1 text-xs hover:bg-gray-100">
            🔗 Link
        </button>
    </div>

    <textarea @bind="Block.MarkdownInhalt"
              @bind:event="oninput"
              class="font-ptsans w-full rounded border border-gray-300 p-2 text-sm"
              rows="8"
              placeholder="Text hier eingeben... Nutze **fett**, *kursiv*, [Link](url)"></textarea>

    @if (ShowPreview && !string.IsNullOrWhiteSpace(Block.MarkdownInhalt))
    {
        <div class="mt-3 rounded border border-blue-200 bg-blue-50 p-3">
            <p class="font-ptsans mb-1 text-xs font-bold text-blue-800">Vorschau:</p>
            <div class="font-ptsans text-sm tracking-wider">
                <div class="markdown-content my-4">
                    @((MarkupString)ConvertMarkdown(Block.MarkdownInhalt ?? string.Empty))
                </div>

                @* @((MarkupString)RenderMarkdown(Block.MarkdownInhalt)) *@
            </div>
        </div>
    }

    <div class="mt-2">
        <label class="flex items-center gap-2">
            <input type="checkbox" @bind="ShowPreview" />
            <span class="font-ptsans text-xs">Live-Vorschau anzeigen</span>
        </label>
    </div>
</div>

<style>
    .markdown-content a {
        color: #0066cc;
        text-decoration: none;
        font-weight: 500;
        border-bottom: 2px solid #0066cc;
        transition: all 0.3s ease;
    }

        .markdown-content a:hover {
            color: #0052a3;
            border-bottom-color: #0052a3;
        }

        .markdown-content a:visited {
            color: #663399;
        }

    /* Überschriften */
    .markdown-content h1, .markdown-content h2, .markdown-content h3 {
        margin-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: bold;
    }

    .markdown-content h1 {
        font-size: 1.875rem;
    }

    .markdown-content h2 {
        font-size: 1.5rem;
    }

    .markdown-content h3 {
        font-size: 1.25rem;
    }

    /* Listen */
    .markdown-content ul {
        list-style-type: disc;
        margin-left: 1.5rem;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .markdown-content ol {
        list-style-type: decimal;
        margin-left: 1.5rem;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .markdown-content li {
        margin-bottom: 0.5rem;
        line-height: 1.6;
        display: list-item;
    }

    /* Absätze */
    .markdown-content p {
        margin-bottom: 1rem;
        line-height: 1.6;
        white-space: pre-wrap;
        word-wrap: break-word;
    }
</style>

@code {
    [Parameter]
    public AktuellesBlock Block { get; set; } = null!;

    private bool ShowPreview { get; set; } = true;

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .Build();

    // private string RenderMarkdown(string? markdown)
    // {
    //     if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;
    //     return Markdown.ToHtml(markdown, MarkdownPipeline);
    // }

    private string ConvertMarkdown(string markdown)
    {
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .UseAutoLinks()
            .Build();

        return Markdig.Markdown.ToHtml(markdown ?? string.Empty, pipeline);
    }

    private void InsertBold() => Block.MarkdownInhalt = (Block.MarkdownInhalt ?? string.Empty) + "**fett**";
    private void InsertItalic() => Block.MarkdownInhalt = (Block.MarkdownInhalt ?? string.Empty) + "*kursiv*";
    private void InsertLink() => Block.MarkdownInhalt = (Block.MarkdownInhalt ?? string.Empty) + "[Linktext](https://beispiel.de)";
}
