@using BudoShurenWebsite.Models
@using BudoShurenWebsite.Models.Enums
@using Markdig
@using System.Text.Json

@if (Block != null)
{
    switch (Block.Typ)
    {
        case WissenBlockTyp.TextAbsatz:
            <div class="mt-4">
                <p class="font-ptsans text-sm tracking-wider">
                    @((MarkupString)RenderMarkdown(Block.TextInhalt ?? ""))
                </p>
            </div>
            break;

        case WissenBlockTyp.SectionBanner:
            <div class="mb-10 mt-20">
                <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.UntertitelText</h3>
                <hr class="border-t border-solid border-black" />
            </div>
            break;

        case WissenBlockTyp.Subheadline:
            <div class="mt-10 md:my-10">
                <h4 class="font-yuji text-2xl font-normal tracking-widest md:text-3xl">
                    @Block.UntertitelText
                </h4>
            </div>
            break;

        case WissenBlockTyp.BildMitText:
            <div class="mt-10 md:grid md:grid-cols-2 md:grid-rows-[2rem_auto]">
                @if (!string.IsNullOrEmpty(Block.UntertitelText))
                {
                    <h5 class="font-yuji mb-2 text-sm font-bold tracking-wider text-black md:col-start-2 md:row-start-1 md:ml-16">
                        @Block.UntertitelText
                    </h5>
                }
                @if (Block.BildId.HasValue)
                {
                    var bildPosition = Block.BildPosition?.ToLower() == "rechts" ? "md:col-start-2 md:row-span-2" : "md:col-start-1 md:row-span-2";
                    var textPosition = Block.BildPosition?.ToLower() == "rechts" ? "md:col-start-1 md:row-start-2" : "md:col-start-2 md:row-start-2";

                    <img class="@bildPosition" src="/Account/Member/Filesave/GetImage/@Block.BildId" alt="@Block.AltText" />

                    <div class="@textPosition mx-10 mt-2 md:ml-24 md:mr-0">
                        <p class="font-ptsans text-sm tracking-wider">
                            @((MarkupString)RenderMarkdown(Block.TextInhalt ?? ""))
                        </p>
                    </div>
                }
            </div>
            break;

        case WissenBlockTyp.BildEinzel:
            @if (Block.BildId.HasValue)
            {
                <div class="mt-10 flex justify-center">
                    <img class="max-w-full md:max-w-72" src="/Account/Member/Filesave/GetImage/@Block.BildId" alt="@Block.AltText" />
                </div>
            }
            break;

        case WissenBlockTyp.Aufzaehlung:
            @if (!string.IsNullOrEmpty(Block.ListenItemsJson))
            {
                var items = JsonSerializer.Deserialize<List<string>>(Block.ListenItemsJson);
                if (items != null && items.Any())
                {
                    <div class="mx-10 mt-5 md:ml-32">
                        <ul class="list-disc">
                            @foreach (var item in items)
                            {
                                <li class="mt-2">
                                    <p class="font-ptsans text-sm tracking-wider">
                                        @((MarkupString)RenderMarkdown(item))
                                    </p>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            break;

        case WissenBlockTyp.TextUndBildRechts:
            <section>
                @if (!Block.BannerAusblenden)
                {
                    <div class="mb-10 mt-20">
                        <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.BannerTitel</h3>
                        <hr class="border-t border-solid border-black" />
                    </div>
                }
                <div class="flex flex-col justify-center md:flex-row">
                    <div>
                        @if (Block.BildId.HasValue)
                        {
                            <div class="flex justify-center md:float-right md:flex-grow">
                                <img class="mb-4 max-w-full md:max-w-72 md:ml-16"
                                     src="/Account/Member/Filesave/GetImage/@Block.BildId"
                                     alt="@Block.AltText" />
                            </div>
                        }
                        @foreach (var absatz in GetAbsaetze(Block.TextInhalt))
                        {
                            <div class="mt-4 first:mt-0">
                                <p class="font-ptsans text-sm tracking-wider">
                                    @((MarkupString)RenderMarkdown(absatz))
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </section>
            break;

        case WissenBlockTyp.UeberschriftMitEingeruecktemText:
            <section>
                @if (!Block.BannerAusblenden)
                {
                    <div class="mb-10 mt-20">
                        <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.BannerTitel</h3>
                        <hr class="border-t border-solid border-black" />
                    </div>
                }
                <div>
                    @if (!string.IsNullOrWhiteSpace(Block.UntertitelText))
                    {
                        <div class="mt-10 md:my-10">
                            <h4 class="font-yuji text-2xl font-normal tracking-widest md:text-3xl">
                                @Block.UntertitelText
                            </h4>
                        </div>
                    }
                    <div class="font-ptsans mt-10 tracking-widest text-black md:ml-72">
                        @foreach (var absatz in GetAbsaetze(Block.TextInhalt))
                        {
                            <p class="font-ptsans text-sm tracking-wider text-black">
                                @((MarkupString)RenderMarkdown(absatz))
                            </p>
                        }
                    </div>
                </div>
            </section>
            break;

        case WissenBlockTyp.UeberschriftMitZweiTextbloecken:
            <section>
                @if (!Block.BannerAusblenden)
                {
                    <div class="mb-10 mt-20">
                        <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.BannerTitel</h3>
                        <hr class="border-t border-solid border-black" />
                    </div>
                }
                <div class="mt-12 justify-between md:flex md:flex-row">
                    @if (!string.IsNullOrWhiteSpace(Block.UntertitelText))
                    {
                        <div class="md:w-52">
                            <h4 class="font-yuji text-2xl font-normal tracking-widest md:text-3xl">
                                @Block.UntertitelText
                            </h4>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Block.TextInhalt))
                    {
                        <div class="mt-5 flex-1 md:ml-18 md:mt-0">
                            @foreach (var absatz in GetAbsaetze(Block.TextInhalt))
                            {
                                <p class="font-ptsans text-sm tracking-wider text-black">
                                    @((MarkupString)RenderMarkdown(absatz))
                                </p>
                            }
                        </div>
                    }
                </div>
                <div class="mt-10">
                    @if (Block.BildId.HasValue)
                    {
                        <div class="mx-10 flex justify-center md:float-right md:flex-grow md:mx-0">
                            <img class="mb-4 max-w-64 md:ml-16"
                                 src="/Account/Member/Filesave/GetImage/@Block.BildId"
                                 alt="@Block.AltText" />
                        </div>
                    }
                    @foreach (var absatz in GetAbsaetze(Block.TextInhalt2))
                    {
                        <div class="mt-4 md:mr-64">
                            <p class="font-ptsans text-sm tracking-wider text-black">
                                @((MarkupString)RenderMarkdown(absatz))
                            </p>
                        </div>
                    }
                </div>
            </section>
            break;
            case WissenBlockTyp.TextMitUeberschriftRechts:
                <section>
                    @if (!Block.BannerAusblenden)
                    {
                        <div class="mb-10 mt-20">
                            <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.BannerTitel</h3>
                            <hr class="border-t border-solid border-black" />
                        </div>
                    }
                    <div class="mt-20 md:flex md:flex-row">
                        @if (!string.IsNullOrWhiteSpace(Block.UntertitelText))
                        {
                            <div class="min-w-48 max-w-48 md:ml-18 md:order-2">
                                <h4 class="font-yuji text-2xl font-normal tracking-widest md:text-3xl">
                                    @Block.UntertitelText
                                </h4>
                            </div>
                        }
                        <div class="mt-5 md:order-1 md:mt-0">
                            @foreach (var absatz in GetAbsaetze(Block.TextInhalt))
                            {
                                <p class="font-ptsans mb-4 text-sm tracking-wider text-black first:mt-0">
                                    @((MarkupString)RenderMarkdown(absatz))
                                </p>
                            }
                        </div>
                    </div>
                </section>
                break;

        case WissenBlockTyp.ZwischenüberschriftUndBildMitText:
            <section>
                @if (!Block.BannerAusblenden)
                {
                    <div class="mb-10 mt-20">
                        <h3 class="font-ptsans text-xs font-normal tracking-widest text-black">@Block.BannerTitel</h3>
                        <hr class="border-t border-solid border-black" />
                    </div>
                }
                <div class="mt-10">
                    @if (!string.IsNullOrWhiteSpace(Block.UntertitelText))
                    {
                        <div class="font-bold">
                            <p class="font-ptsans text-sm tracking-wider">@Block.UntertitelText</p>
                        </div>
                    }
                    <div class="mt-5 md:mt-0">
                        @if (Block.BildId.HasValue)
                        {
                            <div class="mx-10 flex justify-center md:float-right md:flex-grow md:mx-0">
                                <img class="mb-4 max-w-64 md:ml-16"
                                     src="/Account/Member/Filesave/GetImage/@Block.BildId"
                                     alt="@Block.AltText" />
                            </div>
                        }
                        @foreach (var absatz in GetAbsaetze(Block.TextInhalt))
                        {
                            <div class="mt-4">
                                <p class="font-ptsans text-sm tracking-wider">
                                    @((MarkupString)RenderMarkdown(absatz))
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </section>
            break;
    }
}
@code {
    [Parameter]
    public WissenBlock? Block { get; set; }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder()
        .DisableHtml()
        .UseEmphasisExtras()
        .UseAutoLinks()
        .Build();

    private string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        return Markdown.ToHtml(markdown, MarkdownPipeline);
    }

    private static IEnumerable<string> GetAbsaetze(string? text)
        => (text ?? string.Empty)
            .Split("\n\n", StringSplitOptions.RemoveEmptyEntries)
            .Select(a => a.Trim())
            .Where(a => a.Length > 0);
}
