

<div class="default-container überschrift-container">
    <div id="headline-grid">
        <div id="inner-grid">
            <div id="headline">
                <h2>@Titel</h2>
            </div>
            <div id="untertitel">
                <h1>@Untertitel</h1>
            </div>
            <div id="anekdote">
                <p>@Anekdote</p>
            </div>
        </div>
    </div>
    <span id="vertical-content">武道修練道場</span>
</div>

@code {
    [Parameter]
    public string? Titel { get; set; }

    [Parameter]
    public string? Untertitel { get; set; }

    [Parameter]
    public string? Anekdote { get; set; }
}
