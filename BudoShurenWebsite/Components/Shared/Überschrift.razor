@rendermode InteractiveServer

<div class="relative w-full">
    <div class="relative mb-0 mt-10 flex max-w-screen-xl flex-col items-center justify-center md:mb-28">
        <div class="relative mx-auto flex flex-col items-center justify-center md:pb-10">
            <div>
                <h2 class="text-black text-5xl sm:text-7xl md:text-8xl font-normal font-['Yuji Syuku'] tracking-widest text-center">@Titel</h2>
            </div>
            <div>
                <h1 class="text-black text-xl sm:text-2xl font-normal font-['Yuji Syuku'] tracking-[1.2rem] sm:tracking-[1.3rem] md:tracking-[1.4rem] text-center">@Untertitel</h1>
            </div>
            <div class="pt-5 md:absolute md:bottom-0 md:right-0">
                <p class="text-center md:text-right text-xl md:text-xl font-normal font-['Yuji Syuku'] tracking-[0.21rem]">@Anekdote</p>
            </div>
        </div>
    </div> 
    
    <div class="absolute right-5 top-0 hidden md:block">
        <div class="text-right text-black text-2xl font-normal font-['Yuji Syuku']">武<br />道<br />修<br />練<br />道<br />場</div>
    </div>
</div>

@code {
    [Parameter]
    public string? Titel { get; set; }

    [Parameter]
    public string? Untertitel { get; set; }

    [Parameter]
    public string? Anekdote { get; set; }
}
