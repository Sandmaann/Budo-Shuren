@page "/Account/Member/Galerie/budoshuren/images/{ImageName}/{EntryID}"
@page "/budoshuren/Account/Member/Galerie/budoshuren/images/{ImageName}/{EntryID}"
@layout EmptyLayout

@inject IHostEnvironment environment
@inject ApplicationDbContext DbContext;
@inject IJSRuntime JSRuntime
@inject UserService UserService
@inject ILogger<ImageDetail> Logger

@rendermode InteractiveServer

<div class="flex h-screen w-screen bg-black">
    <div class="relative mt-5 flex flex-grow flex-row">
        <div class="mx-5">
            <button class="transform rounded-full text-center transition duration-150 ease-in-out hover:bg-gray-700 active:scale-90" @onclick="goBack" title="Zurück zur vorherigen Seite" aria-label="Zurück gehen">
                <span class="material-symbols-outlined m-2 text-white">arrow_back</span>
            </button>
        </div>
        <div class="max-h-[95vh] max-w-full flex-grow self-center object-cover">
            <img src="@ImagePath" class="mx-auto max-h-[95vh] max-w-full object-cover" title="@Item?.Titel" alt="@Item?.Untertitel" onerror="this.src='/budoshuren/images/missingimage.jpg'" />
        </div>
        @if (CanEdit)
        {
            <div>
                <div class="mx-5 flex flex-col">
                    <button class="rotate-180 transform rounded-full text-center transition duration-150 ease-in-out hover:bg-gray-700 active:scale-90" @onclick="toggleSlideoverBlazor" title="Daten zum Bild bearbeiten" aria-label="Einstellungen öffnen">
                        <span class="material-symbols-outlined m-2 text-white">expand_circle_right</span>
                    </button>
                    <button class="mt-4 transform rounded-full text-center transition duration-150 ease-in-out hover:bg-gray-700 active:scale-90" @onclick="deleteImage" title="Eintrag komplett löschen" aria-label="Eintrag löschen">
                        <span class="material-symbols-outlined m-2 text-white">delete_forever</span>
                    </button>
                </div>
            </div>
        }
    </div>

    @if (CanEdit)
    {
        <div id="slideover-container" class="invisible fixed inset-0 h-full w-full">
            <div @onclick="toggleSlideoverBlazor" id="slideover-bg" class="opacity-0 absolute inset-0 h-full w-full bg-gray-900 transition-all duration-500 ease-out"></div>

            <div onclick="" id="slideover" class="absolute right-0 h-full w-96 translate-x-full overflow-auto bg-white transition-all duration-300 ease-out">
                <EditGalerie @ref="editGalerie" Einträge="(new List<GalerieEintrag> {Item})" OnClose="onSidebarClosed" />
            </div>
        </div>
    }
</div>


<script>
    function toggleSlideover() {
        document.getElementById('slideover-container').classList.toggle('invisible');
        document.getElementById('slideover-bg').classList.toggle('opacity-0');
        document.getElementById('slideover-bg').classList.toggle('opacity-50');
        document.getElementById('slideover').classList.toggle('translate-x-full');
    }
</script>
@code {

    EditGalerie editGalerie;

    [Parameter]
    public string ImageName { get; set; }

    [Parameter]
    public string EntryID { get; set; }

    public GalerieEintrag? Item { get; set; }

    private bool isOpen { get; set; } = false;
    bool deleted = false;

    public bool CanEdit { get; set; } = false;


    private async Task deleteImage()
    {
        if (CanEdit == false)
            return;
        if (deleted)
        {
            return;
        }
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Möchtest du dieses Bild wirklich löschen?");
        if (confirm)
        {
            // Code zum Löschen des Bildes
            var item = await DbContext.Galerie.FindAsync(Item?.ID);
            if (item != null)
            {
                try
                {
                    DbContext.Galerie.Remove(item);
                    await DbContext.SaveChangesAsync();

                    //Datei löschen!
                    if (!string.IsNullOrWhiteSpace(item.ImagePath) && File.Exists(item.ImagePath))
                        File.Delete(item.ImagePath);

                    deleted = true;

                    // await JSRuntime.InvokeVoidAsync("alert", "Das Bild wurde gelöscht!");
                    await JSRuntime.InvokeVoidAsync("history.back");
                }
                catch (Exception e)
                {
                    Logger.LogError(e, "Fehler beim Löschen des Bildes");
                    await JSRuntime.InvokeVoidAsync("alert", "Das Bild konnte nicht gelöscht werden.");
                    return;
                }
            }
            else
                await JSRuntime.InvokeVoidAsync("alert", "Das Bild konnte nicht gelöscht werden.");
        }
    }

    private async Task onSidebarClosed(bool result)
    {
        if (result)
            await JSRuntime.InvokeVoidAsync("history.back");
        else
            await JSRuntime.InvokeVoidAsync("toggleSlideover");
    }

    private async Task toggleSlideoverBlazor()
    {
        if (CanEdit == false)
            return;

        isOpen = !isOpen;
        await JSRuntime.InvokeVoidAsync("toggleSlideover");
        if (isOpen)
        {
            editGalerie.SetData(new List<GalerieEintrag> { Item });
        }
    }

    private async Task goBack()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    public string ImagePath
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(ImageName))
            {
                string path = Path.Combine(environment.EnvironmentName, "galery", ImageName);
                return path;
            }
            return string.Empty;
        }
    }


    protected override async Task OnParametersSetAsync()
    {
        if (int.TryParse(EntryID, out int ID) && ID > 0)
            Item = await DbContext.Galerie.FindAsync(ID);
    }

    private async Task SetPermissions()
    {
        try
        {
            await UserService.InitializeAsync();
            var user = UserService.CurrentUser;
            if (user != null && ( Global.Roles.IsEditor(user.Roles) || Global.Roles.IsAbteilungsleiter(user.Roles) || Global.Roles.IsAdmin(user.Roles)))
            {
                CanEdit = true;
            }
            else
            {
                CanEdit = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Laden der Berechtigungen");
            CanEdit = false;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SetPermissions();
    }
}
