@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<ImageCard> Logger

<div class="h-min w-full select-none bg-gray-100 @(OnImageClicked.HasDelegate ? "cursor-pointer" : "")" @onclick="OnClick" @onpointerdown="MouseDown" @onpointerup="MouseUp">
    <div class="relative">

        @if (isLoading)
        {
            <div class="m-8">
                <Spinner />
            </div>
        }
        <img oncontextmenu="@(Eintrag.DisableHover ? "" : "return false;")"
             class="object-cover transition-all duration-500 ease-in-out @(Eintrag.IsSelected ? "transform scale-85 rounded-md" : "transform scale-100")"
             loading="lazy"
             src="@GetImageUrl(Eintrag.DbImageId)"
             title="@Eintrag.Titel"
             alt="@Eintrag.Untertitel"
             @onload="OnImageLoaded"
             @onerror="OnImageError" />
        @if (showErrorImage)
        {
            <img src="/images/missingimage.jpg"
                 class="object-cover transition-all duration-500 ease-in-out @(Eintrag.IsSelected ? "transform scale-85 rounded-md" : "transform scale-100")"
                 alt="Fehler beim Laden des Bildes" />
        }

        @if (Eintrag.IsSelected)
        {
            <div class="absolute inset-0 flex items-start justify-end">
                <div class="m-2 flex items-center rounded-full bg-primary">
                    <span class="material-symbols-outlined m-0.5 text-white">done</span>
                </div>
            </div>
        }
        @if (!Eintrag.DisableHover)
        {
            <div class="opacity-0 z-10 absolute inset-0 hidden flex-col justify-between duration-300 md:flex md:hover:opacity-100">
                <div class="flex items-start justify-end">
                    <button class="" @onclick="OnCheckClicked" aria-label="Auswählen" title="Auswählen">
                        <div class="m-2 flex items-center rounded-full @(Eintrag.IsSelected ? "bg-primary" : "bg-gray-400")">
                            <span class="material-symbols-outlined m-0.5 text-white">done</span>
                        </div>
                    </button>
                </div>
                <div class="hidden items-end justify-center bg-opacity-70 bg-gradient-to-t from-black md:flex">
                    <div class="text-wrap px-4 py-2 pt-10 text-white">
                        <Subheadline Text="@Eintrag.Titel" />
                    </div>
                </div>
                @if (Eintrag.IsSelected)
                {
                    <div class="absolute inset-0 hidden items-end justify-end md:flex">
                        <button class="transform transition duration-150 ease-in-out active:scale-90" @onclick="OnDetailClicked" aria-label="Details anzeigen" title="Details anzeigen">
                            <div class="m-2 flex items-center rounded-full">
                                <span class="material-symbols-outlined m-0.5 text-white">search</span>
                            </div>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {

    [Parameter]
    public GalerieEintrag Eintrag { get; set; } = new GalerieEintrag
    {
        Titel = "Unbekannt"
    };

    [Parameter]
    public EventCallback OnSelectionChanged { get; set; }

    [Parameter]
    public bool IsScrolling { get; set; }

    [Parameter]
    public EventCallback<GalerieEintrag> OnImageClicked { get; set; }

    private bool isLoading { get; set; } = true;
    private bool showErrorImage { get; set; } = false;

    bool checkClicked = false;
    bool detailClicked = false;

    bool longClick = false;

    DateTime mouseDownTime;

    private Timer? timer;
    private bool timerFired = false;

    private void OnImageLoaded()
    {
        isLoading = false;
        StateHasChanged();
    }
    private void OnImageError()
    {
        isLoading = false;
        showErrorImage = true;
        StateHasChanged();
    }

    void MouseDown()
    {
        if (Eintrag?.DisableSelection == true)
            return;

        timerFired = false;
        // await Task.Delay(50);
        timer = new Timer(_ =>
        {
            if (IsScrolling)
                return;
            timerFired = true;
            InvokeAsync(async () =>
                {
                    if (IsScrolling)
                    {
                        timerFired = true;
                        return;
                    }
                    // Ihre Methode hier aufrufen
                    Eintrag.IsSelected = !Eintrag.IsSelected;
                    await OnSelectionChanged.InvokeAsync();
                    StateHasChanged();
                });
        }, null, 500, Timeout.Infinite);

        mouseDownTime = DateTime.UtcNow;
    }

    void MouseUp()
    {
        if (Eintrag?.DisableSelection == true)
            return;

        if (timer != null)
        {
            timer.Dispose();
            timer = null;
        }

        if (!timerFired)
        {
            // Führen Sie die Aktion aus, wenn der Timer nicht abgelaufen ist
            long milliseconds = (DateTime.UtcNow.Ticks - mouseDownTime.Ticks) / TimeSpan.TicksPerMillisecond;
            if (milliseconds > 400)
            {
                //long press
                Console.WriteLine("long press");
                longClick = true;
                OnClick();
            }
            else
            {
                longClick = false;
            }
        }
    }

    private async void OnClick()
    {
        if (OnImageClicked.HasDelegate)
        {
            await OnImageClicked.InvokeAsync(Eintrag);
            return;
        }

        if (Eintrag?.DisableSelection == true)
            return;

        if (timerFired)
        {
            return;
        }
        if (checkClicked)
        {
            checkClicked = false;
            return;
        }
        if (detailClicked)
        {
            detailClicked = false;
            return;
        }
        if (longClick)
        {
            //Lange gehalten = immer Auswahlmodus
            Eintrag.IsSelected = !Eintrag.IsSelected;
            await OnSelectionChanged.InvokeAsync();

            longClick = false;
            return;
        }
        if (Eintrag.SelectionMode)
        {
            Eintrag.IsSelected = !Eintrag.IsSelected;
            await OnSelectionChanged.InvokeAsync();
        }
        else
        {
            if (Eintrag.DbImageId > 0)
            {
                NavigationManager.NavigateTo($"/Account/Member/Galerie/images/{Eintrag.ID}");
            }
        }
    }

    private async void OnCheckClicked()
    {
        if (Eintrag?.DisableSelection == true)
            return;

        checkClicked = true;
        Eintrag.IsSelected = !Eintrag.IsSelected;
        await OnSelectionChanged.InvokeAsync();
    }
    private void OnDetailClicked()
    {
        //Navigate to ImageDetail
        if (Eintrag?.DbImageId > 0)
        {
            detailClicked = true;
            NavigationManager.NavigateTo($"/Account/Member/Galerie/images/{Eintrag.ID}");
        }
    }

    private string GetImageUrl(int? dbImageId)
    {
        if (dbImageId.HasValue)
        {
            return $"/Account/Member/Filesave/GetImage/{dbImageId.Value}";
        }
        return "/images/missingimage.jpg";
    }
}