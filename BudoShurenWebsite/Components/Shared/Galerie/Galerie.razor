@page "/Galerie"
@rendermode InteractiveServer

<PageTitle>Galerie</PageTitle>
<HeadContent>
    <meta name="description" content="Entdecke unsere Galerie mit Fotos von Trainings, Seminaren und Veranstaltungen. Tauche ein in die Welt der Kampfkunst und erlebe die Gemeinschaft.">
</HeadContent>

@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using BudoShurenWebsite.Models;
@using Microsoft.EntityFrameworkCore;

@using BudoShurenWebsite.Data
@using Microsoft.AspNetCore.Identity

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserService UserService
@inject ProtectedSessionStorage SessionStorage
@inject IJSRuntime JSRuntime
@inject IHostEnvironment environment
@inject ApplicationDbContext DbContext
@inject BildVariantenService BildVarianten
@inject ILogger<Galerie> Logger

<div class="">
    <div class="container mx-auto">
        <div>
            <div class="mx-auto max-w-screen-md">
                <div class="mx-10">
                    <SectionBanner Titel="Öffentliche Galerie" />
                </div>
            </div>

            <div class="z-40 sticky top-16 bg-white pb-5">

                <div class="mx-auto max-w-screen-md">
                    <div class="mx-10 flex flex-col">
                        <div class="flex flex-wrap">
                            <div class="relative grow">
                                @if (SelectionMode)
                                {
                                    <div class="flex flex-row items-center justify-start">
                                        <button @onclick="auswahlAufheben" class="mr-2 flex min-h-10 min-w-10 items-center justify-center rounded-full hover:bg-gray-200" aria-label="Auswahl aufheben" title="Auswahl aufheben">
                                            <span class="material-symbols-outlined">close</span>
                                        </button>
                                        <div>
                                            <Standardtext Text="@(selectedEinträgeCount > 0 ? $"{selectedEinträgeCount} ausgewählt" : "Keine Auswahl")" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <button @onclick="Suche" aria-label="Suchen" class="absolute inset-y-0 left-0 flex transform items-center pl-3 transition duration-150 ease-in-out active:scale-90">
                                        <span class="material-symbols-outlined">search</span>
                                    </button>
                                    <InputText @bind-Value="Suchtext"
                                               @oninput="Suche"
                                               class="w-44 truncate border border-white bg-white px-9 py-2 pl-10 text-sm font-semibold text-black !outline-none transition-all duration-1000 ease-out placeholder:tracking-widest focus:border focus:w-full focus:border-primary focus:ring-transparent sm:bg-transparent sm:pr-6"
                                               placeholder="Suchen..." />
                                }

                            </div>

                            <div class="flex items-center justify-end">
                                @if (SelectionMode)
                                {
                                    <div class="hidden flex-row items-center md:flex">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="@filterText" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>

                                    <div class="flex flex-row items-center md:hidden">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>
                                }
                                else
                                {
                                    <div class="hidden flex-row items-center md:flex">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="@filterText" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>
                                    <div class="flex flex-row items-center md:hidden">
                                        <SfMenu TValue="MenuItem" HamburgerMode="false" ShowItemOnClick="true">
                                            <MenuItems>
                                                <MenuItem Text="" IconCss="e-icons e-filter">
                                                    <MenuItems>
                                                        <MenuItem Text="Home" IconCss="@homeCssImage"></MenuItem>
                                                        <MenuItem Text="Aikido" IconCss="@aikidoCssImage"></MenuItem>
                                                        <MenuItem Text="Bujinkan" IconCss="@bujinkanCssImage"></MenuItem>
                                                        <MenuItem Text="Genbukan" IconCss="@genbukanCssImage"></MenuItem>
                                                        <MenuItem Text="Iaido" IconCss="@iaidoCssImage"></MenuItem>
                                                        <MenuItem Text="Jodo" IconCss="@jodoCssImage"></MenuItem>
                                                        <MenuItem Separator="true"></MenuItem>
                                                        <MenuItem Text="Keine" IconCss="e-icons e-filter-clear"></MenuItem>
                                                    </MenuItems>
                                                </MenuItem>
                                            </MenuItems>
                                            <MenuEvents TValue="MenuItem" OnClose="onClose" OnOpen="onOpen" ItemSelected="itemSelected"></MenuEvents>
                                        </SfMenu>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="z-10 mx-10 mt-5">
                <div>
                    <Virtualize Items="Gruppen">
                        <ItemContent>
                            <ImageGroup @key="context.ID"
                                        Gruppe="@context"
                                        OnSelectionChanged="SelectionChanged"
                                        IsScrolling="isScrolling"
                                        OnImageClicked="OpenImagePopup" />
                        </ItemContent>
                        <Placeholder>
                            <div class="flex justify-center">
                                <span class="m text-gray-400">Das ist ein Platzhalter.</span>
                            </div>
                        </Placeholder>
                        <EmptyContent>
                            <div class="flex justify-center">
                                @if (IsLoading)
                                {
                                    <Spinner Text="Einen Moment, die Bilder werden geladen ..." />
                                }
                                else
                                {
                                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                                    {
                                        <StatusMessage ShowAsError="true" Message="@errorMessage" />
                                    }
                                    else
                                    {
                                        <span class="m text-gray-400">Keine Einträge gefunden.</span>
                                    }
                                }
                            </div>
                        </EmptyContent>
                    </Virtualize>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bild Popup/Overlay -->
<div @onclick="CloseImagePopup"
     class="@(ShowImagePopup ? "visible opacity-100" : "invisible opacity-0") fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-70 transition-opacity duration-300"
     style="cursor: pointer;">

    <div @onclick:stopPropagation
         class="relative max-w-4xl max-h-[95vh] bg-white rounded-lg shadow-2xl overflow-hidden">

        <!-- Schließen Button -->
        <button @onclick="CloseImagePopup"
                class="absolute top-4 right-4 z-10 rounded-full bg-gray-900 text-white hover:bg-gray-700 transition duration-150"
                aria-label="Schließen"
                title="Popup schließen">
            <span class="material-symbols-outlined m-2">close</span>
        </button>

        <!-- Bild anzeigen -->
        @if (SelectedImage != null)
        {
            <img src="@GetImageUrl(SelectedImage.DbImageId)"
                 alt="@SelectedImage.Untertitel"
                 class="mx-auto max-h-[80vh] max-w-4xl object-contain"
                 loading="lazy"
                 style="cursor: default;" />

            <!-- Bildinfo -->
            <div class="p-4 font-ptsans"
                 style="cursor: default;">
                <h3 class="font-yuji">@SelectedImage.Titel</h3>
                @if (!string.IsNullOrWhiteSpace(SelectedImage.Untertitel))
                {
                    <p class="text-sm">@SelectedImage.Untertitel</p>
                }
                @if (SelectedImage.ImageDate.HasValue)
                {
                    <p class="text-xs">@SelectedImage.ImageDate.Value.ToLocalTime().ToString("dd. MMMM yyyy")</p>
                }
            </div>
        }
    </div>
</div>


<style>
    .e-menu-item {
        font-size: 1rem;
    }

    .e-menu-container .e-ul .e-menu-item {
        margin-top: 0.25rem;
        margin-bottom: 0.25rem;
        font-size: 1rem;
    }
</style>


@code {

    // Popup-Zustand
    private bool ShowImagePopup { get; set; } = false;
    private GalerieEintrag? SelectedImage { get; set; }

    string suchtext = string.Empty;
    private string errorMessage { get; set; } = string.Empty;
    private string Suchtext { get => suchtext; set { if (value != suchtext) { suchtext = value; Suche(); } } }

    private bool IsLoading { get; set; } = false;
    private bool SidebarIsVisible { get; set; } = false;

    private bool SelectionMode { get; set; } = false;
    int selectedEinträgeCount { get; set; }

    private IEnumerable<GalerieEintrag> SelectedEinträge { get; set; } = new List<GalerieEintrag>();

    private List<GalerieEintrag> Einträge { get; set; } = new List<GalerieEintrag>();
    private ICollection<GalerieGruppe> Gruppen { get; set; } = new List<GalerieGruppe>();

    string menuItemName = string.Empty;

    private bool isScrolling { get; set; } = false;


    private bool aikido { get; set; } = false;
    private bool bujinkan { get; set; } = false;
    private bool genbukan { get; set; } = false;
    private bool iaido { get; set; } = false;
    private bool jodo { get; set; } = false;
    private bool home { get; set; } = false;

    private bool hasfilter => aikido || bujinkan || genbukan || iaido || jodo || home;

    private string filterText => hasfilter ? "Filter*" : "Filter";

    private string aikidoCssImage => aikido ? "e-icons e-check-large" : "e-icons";
    private string bujinkanCssImage => bujinkan ? "e-icons e-check-large" : "e-icons";
    private string genbukanCssImage => genbukan ? "e-icons e-check-large" : "e-icons";
    private string iaidoCssImage => iaido ? "e-icons e-check-large" : "e-icons";
    private string jodoCssImage => jodo ? "e-icons e-check-large" : "e-icons";
    private string homeCssImage => home ? "e-icons e-check-large" : "e-icons";

    bool cancelDropDownClose = false;

    bool iJustClosedYou_1 = false;


    private void onOpen(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (iJustClosedYou_1)
        {
            iJustClosedYou_1 = false;
            args.Cancel = true;
        }
    }
    private void onClose(BeforeOpenCloseMenuEventArgs<MenuItem> args)
    {
        if (cancelDropDownClose)
        {
            args.Cancel = true;
            cancelDropDownClose = false;
        }
    }

    private void itemSelected(MenuEventArgs<MenuItem> args)
    {
        //Selected menu item
        var selectedItem = args.Item.Text;

        if (selectedItem != "Filter")
        {
            switch (selectedItem)
            {
                case "Aikido":
                    cancelDropDownClose = true;
                    aikido = !aikido;
                    Suche();
                    break;
                case "Bujinkan":
                    cancelDropDownClose = true;
                    bujinkan = !bujinkan;
                    Suche();
                    break;
                case "Genbukan":
                    cancelDropDownClose = true;
                    genbukan = !genbukan;
                    Suche();
                    break;
                case "Iaido":
                    cancelDropDownClose = true;
                    iaido = !iaido;
                    Suche();
                    break;
                case "Jodo":
                    cancelDropDownClose = true;
                    jodo = !jodo;
                    Suche();
                    break;
                case "Home":
                    cancelDropDownClose = true;
                    home = !home;
                    Suche();
                    break;
                case "Keine":
                    aikido = false;
                    bujinkan = false;
                    genbukan = false;
                    iaido = false;
                    jodo = false;
                    home = false;
                    cancelDropDownClose = false;
                    Suche();
                    break;
                default:
                    cancelDropDownClose = false;
                    return;
            }
        }
        else
            cancelDropDownClose = false;
    }

    private void SelectionChanged()
    {
        var preValue = SelectionMode;
        selectedEinträgeCount = Einträge?.Where(x => x.IsSelected)?.Count() ?? 0;
        SelectionMode = selectedEinträgeCount > 0;

        if (SelectionMode != preValue)
        {
            Einträge?.ForEach(x => x.SelectionMode = SelectionMode);
        }
    }

    private void auswahlAufheben()
    {
        Einträge?.ForEach(x => x.IsSelected = false);
        SelectionChanged();
    }

    private void Suche()
    {
        try
        {

            IEnumerable<GalerieEintrag> gefilterteEinträge;
            if (string.IsNullOrWhiteSpace(Suchtext) &&
            !aikido && bujinkan && !genbukan && !iaido && !jodo && !home)
            {
                gefilterteEinträge = Einträge.Where(x => x.Öffentlich);
            }
            else
            {
                // Wenn der Suchtext nicht leer ist, filtern Sie die Einträge
                gefilterteEinträge = Einträge.Where(x => x.Öffentlich);

                if (!string.IsNullOrWhiteSpace(suchtext))
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x =>
                    x.Titel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                    x.Untertitel?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true ||
                    x.Beschreibung?.Contains(Suchtext, StringComparison.OrdinalIgnoreCase) == true);
                }
                if (aikido)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Aikido);
                }
                if (bujinkan)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Bujinkan);
                }
                if (genbukan)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Genbukan);
                }
                if (iaido)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Iaido);
                }
                if (jodo)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Jodo);
                }
                if (home)
                {
                    gefilterteEinträge = gefilterteEinträge.Where(x => x.Home);
                }
            }

            var groups = gefilterteEinträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
            var gruppen = new List<GalerieGruppe>();
            foreach (var group in groups.OrderByDescending(x => x.Key))
            {
                var neueGruppe = new GalerieGruppe
                {
                    Datum = group.Key,
                    Items = group.ToList()
                };
                gruppen.Add(neueGruppe);
            }
            Gruppen = gruppen;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Durchsuchen der Daten: {ex.Message}";
            Logger.LogError(ex, errorMessage);
        }
        finally
        {
            SelectionChanged();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        try
        {
            if (IsLoading)
                return;

            IsLoading = true;

            await Task.Delay(10);

            var einträge = await DbContext.Galerie
            .Where(x => x.Öffentlich)
            .AsNoTracking()
            .ToListAsync();
            await BildVarianten.KachelMasseSetzenAsync(einträge);
            // einträge.ForEach(x => x.EnvironmentPath = environment.ContentRootPath);

            var groups = einträge.GroupBy(eintrag => new DateTime(eintrag.SortDate?.Year ?? 1, eintrag.SortDate?.Month ?? 1, 1));
            var gruppen = new List<GalerieGruppe>();
            foreach (var group in groups.OrderByDescending(x => x.Key))
            {
                var items = group.ToList();
                items.ForEach(x => x.DisableSelection = true);
                var neueGruppe = new GalerieGruppe
                {
                    Datum = group.Key,
                    Items = group.ToList(),
                    DisableSelection = true
                };
                gruppen.Add(neueGruppe);
            }

            Einträge = einträge;
            Gruppen = gruppen;
            errorMessage = string.Empty;
        }
        catch (Exception ex)
        {
            errorMessage = $"Fehler beim Laden der Daten: {ex.Message}";
            Logger.LogError(ex, errorMessage);
        }
        finally
        {
            IsLoading = false;
            SelectionChanged();
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await LoadData();

            try
            {
                var scrollPosition = await SessionStorage.GetAsync<int>("scrollPosition");
                if (scrollPosition.Success)
                {
                    await JSRuntime.InvokeVoidAsync("setScrollPosition", scrollPosition.Value);
                }

                await JSRuntime.InvokeVoidAsync("saveScrollPositionOnUnload", DotNetObjectReference.Create(this));
            }
            catch
            {
                // ignored
            }

            await JSRuntime.InvokeVoidAsync("registerScrolling", DotNetObjectReference.Create(this));
        }
        if (!firstRender)
        {
            try
            {
                var scrollPosition = await JSRuntime.InvokeAsync<int>("getScrollPosition");
                await SessionStorage.SetAsync("scrollPosition", scrollPosition);
            }
            catch
            {
                // ignored
            }
        }
    }

    public string[] suchdata = { "Aikido", "Bujinkan", "Genbukan", "Iaido", "Jodo", "Home" };

    private void OpenImagePopup(GalerieEintrag image)
    {
        SelectedImage = image;
        ShowImagePopup = true;
    }

    private void CloseImagePopup()
    {
        ShowImagePopup = false;
        SelectedImage = null;
    }

    private string GetImageUrl(int? dbImageId)
    {
        if (dbImageId.HasValue)
        {
            return $"/Account/Member/Filesave/GetImage/{dbImageId.Value}";
        }
        return "/images/missingimage.jpg";
    }


    [JSInvokable]
    public async Task SaveScrollPosition(int scrollPosition)
    {
        await SessionStorage.SetAsync("scrollPosition", scrollPosition);
    }

    [JSInvokable]
    public void OnScrollStart()
    {
        // Ihre Logik hier
        isScrolling = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnScrollEnd()
    {
        // Ihre Logik hier
        isScrolling = false;
        StateHasChanged();
    }
}