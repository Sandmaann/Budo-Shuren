
<div>
    <button class="flex flex-row items-center" @onclick="SelectAll" aria-label="Alle auswählen" disabled="@Gruppe.DisableHover">
        <div class="m-2 ml-0 flex items-center overflow-hidden rounded-full bg-gray-600 transition-all duration-500 @(HasSelectedItems ? "w-auto opacity-100 mr-5" : "w-0 opacity-0")">
            <span class="material-symbols-outlined m-0.5 text-white">done</span>
        </div>
        <div class="mb-1">
            <Subheadline Text="@Gruppe.Titel" />
        </div>
    </button>

    @if (SmallLayout)
    {
        @* Zeilen statt fester Spalten: jede Kachel bekommt eine Breite passend zu ihrem Seitenverhältnis und wächst,
           bis die Zeile voll ist. So bleibt keine Spalte leer, und wenige Bilder werden entsprechend größer. *@
        <div class="flex flex-wrap items-center justify-center gap-4 py-8">
            @foreach (var eintrag in Gruppe.Items)
            {
                <div class="min-w-0 [&_img]:w-full" style="@ZeilenStil(eintrag)">
                    <ImageCard Eintrag="@eintrag"
                               OnSelectionChanged="SelectionChanged"
                               OnImageClicked="OnImageClicked"
                               IsScrolling="IsScrolling" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="columns-2 gap-4 space-y-4 py-8 md:columns-3 lg:columns-4 xl:columns-5 2xl:columns-6 3xl:columns-7 4xl:columns-8 5xl:columns-9">
            @foreach (var eintrag in Gruppe.Items)
            {
                <ImageCard Eintrag="@eintrag"
                           OnSelectionChanged="SelectionChanged"
                           OnImageClicked="OnImageClicked"
                           IsScrolling="IsScrolling" />
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public GalerieGruppe Gruppe { get; set; } = new GalerieGruppe();

    [Parameter]
    public EventCallback OnSelectionChanged { get; set; }

    [Parameter]
    public EventCallback<GalerieEintrag> OnImageClicked { get; set; }

    [Parameter]
    public bool IsScrolling { get; set; }

    [Parameter]
    public bool SmallLayout { get; set; } = false;
    // Beim "SmallLayout" hat die Ansicht weniger Spalten - z.B. für das Mini.Carousel
    // -> weniger horizontaler Platz zur Verfügung


    // Zeilenhöhe der kleinen Galerie: angestrebt wird die Grundhöhe, wenige Bilder wachsen bis zur Maximalhöhe.
    // Breiter als die Kachel-Fassung (BildZuschnitt.GalerieKachelMaxBreite) wird ein Bild nicht, sonst wäre es unscharf.
    private const double ZeilenGrundHoeheRem = 13;
    private const double ZeilenMaxHoeheRem = 22;

    private static string ZeilenStil(GalerieEintrag eintrag)
    {
        // Sind die Maße noch nicht bekannt, wird ein Querformat angenommen
        var verhaeltnis = eintrag.KachelBreite > 0 && eintrag.KachelHoehe > 0
            ? Math.Clamp((double)eintrag.KachelBreite.Value / eintrag.KachelHoehe.Value, 0.5, 3)
            : 4d / 3;

        return FormattableString.Invariant(
            $"flex: {verhaeltnis:0.###} 1 {verhaeltnis * ZeilenGrundHoeheRem:0.##}rem; max-width: min({verhaeltnis * ZeilenMaxHoeheRem:0.##}rem, {BildZuschnitt.GalerieKachelMaxBreite}px)");
    }

    public bool HasSelectedItems { get; set; } = false;

    private bool skipSelection = false;

    private async void SelectionChanged()
    {
        if (Gruppe.DisableSelection == true)
            return;

        if (!skipSelection)
        {
            HasSelectedItems = Gruppe.Items.Any(e => e.IsSelected);
            await OnSelectionChanged.InvokeAsync();
        }
    }

    private void SelectAll()
    {
        if (Gruppe.DisableSelection == true)
            return;

        skipSelection = true;

        if (Gruppe.Items.Any(x => x.IsSelected == false) == false)
        {
            foreach (var eintrag in Gruppe.Items.Where(x => x?.DisableSelection == false))
            {
                eintrag.IsSelected = false;
            }
            HasSelectedItems = false;
            skipSelection = false;
            SelectionChanged();

            return;
        }
        else
        {
            foreach (var eintrag in Gruppe.Items.Where(x => x?.DisableSelection == false))
            {
                eintrag.IsSelected = true;
            }
            HasSelectedItems = true;
        }

        skipSelection = false;
        SelectionChanged();
    }
}
