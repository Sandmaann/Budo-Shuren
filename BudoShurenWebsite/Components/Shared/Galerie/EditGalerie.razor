@inject IHttpClientFactory ClientFactory
@inject HttpClient Http
@inject ILogger<EditGalerie> Logger
@inject IHostEnvironment environment
@inject ApplicationDbContext DbContext;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime
@inject UserService UserService
@inject IBildUpload BildUpload
@inject IEntwurfSpeicher Entwuerfe

@rendermode InteractiveServer
@implements IAsyncDisposable

@using BudoShurenWebsite.Services.Entwuerfe

<div class="mx-5 flex h-screen flex-col">
    <div class="flex h-screen flex-col @(isSaving ? "opacity-50" : "opacity-100")">
        <div>
            <div class="mb-5 mr-5 mt-10 flex flex-row items-center justify-between">
                <div class="grow">
                    @if (IsNew)
                    {
                        <div class="flex flex-col items-center justify-center">
                            <h3 class="text-2xl">Neue Bilder anlegen</h3>
                        </div>
                    }
                    else
                    {
                        <div class="flex flex-col items-center justify-center">
                            <h3 class="text-2xl">@(Einträge.Count() > 1 ? "Einträge" : "Eintrag") bearbeiten</h3>
                            <Standardtext Text="@(Einträge.Count() > 1 ? $"{Einträge.Count()} Biler ausgewählt" : "1 Bild ausgewählt")" />
                        </div>
                    }
                </div>
                <div>
                    <button @onclick="CloseSidebar" class="transform transition duration-150 ease-in-out active:scale-90" aria-label="Seitenleiste schließen" title="Seitenleiste schließen">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <StatusMessage ShowAsError="true" Message="@errorMessage" />
            }
            <EntwurfHinweis VomUtc="_entwurfVomUtc" OnVerwerfen="VerwerfenUndSchliessenAsync" />
        </div>

        @if (IsNew && CanEdit)
        {
            <div class="sidebarHeight:overflow-auto">
                @* vorläufig: erst "Speichern" legt die Einträge an, sonst räumt BildAufraeumJob die Bilder auf *@
                <BildAuswahl Mehrere="true" Gesperrt="@isSaving" OnHochgeladen="BildHochgeladen" />
                @if (uploadedFiles.Count > 0)
                {
                    <p class="font-ptsans mt-2 text-xs">@(uploadedFiles.Count == 1 ? "1 Bild hochgeladen" : $"{uploadedFiles.Count} Bilder hochgeladen")</p>
                    <div class="mb-3 grid grid-cols-3 gap-2">
                        @foreach (var bild in uploadedFiles)
                        {
                            <div @key="bild.Id" class="relative">
                                <img src="@($"Account/Member/Filesave/GetImage/{bild.Id}")" alt="@bild.FileName" title="@bild.FileName" class="aspect-[4/3] w-full rounded object-cover" />
                                <button type="button" class="absolute right-1 top-1 rounded bg-red-600 px-1.5 text-xs text-white hover:bg-red-700"
                                        title="Bild entfernen" disabled="@isSaving" @onclick="() => BildEntfernenAsync(bild)">✕</button>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        <div class="sidebarHeight:sticky sidebarHeight:bottom-0">
            <div class="flex flex-col p-4">
                <div class="mt-5">
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Titel*</label>
                    <InputText @bind-Value="SelectedEintrag.Titel" disabled="@isSaving" title="Gib bitte den Titel ein" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
                </div>

                <div class="mt-2">
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Untertitel</label>
                    <InputText @bind-Value="SelectedEintrag.Untertitel" disabled="@isSaving" title="Gib bitte einen Untertitel ein" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
                </div>

                <div class="mt-2">
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Beschreibung</label>
                    <InputText @bind-Value="SelectedEintrag.Beschreibung" disabled="@isSaving" title="Gib bitte eine Beschreibung ein" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
                </div>

                <div class="mt-2">
                    <div>
                        <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Abteilung*</label>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Öffentlich" class="h-6 w-6" title="Öffentlich anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Öffentlich</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Home" class="h-6 w-6" title="In Home anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Home</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Aikido" class="h-6 w-6" title="In Aikido anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Aikido</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Bujinkan" class="h-6 w-6" title="In Bujinkan anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Bujinkan</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Genbukan" class="h-6 w-6" title="In Genbukan anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Genbukan</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Iaido" class="h-6 w-6" title="In Iaido anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Iaido</span>
                            </label>
                        </div>
                        <div class="my-2">
                            <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                                <InputCheckbox @bind-Value="SelectedEintrag.Jodo" class="h-6 w-6" title="In Jodo anzeigen" disabled="@isSaving" />
                                <span class="ml-2 mt-0.5">Jodo</span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-2">
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Datum*</label>
                    <InputDate @bind-Value="SelectedEintrag.ImageDate" disabled="@isSaving" title="Datum des Bildes" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
                </div>

                <div class="mt-2">
                    <label class="font-ptsans tracking-[0.375rem] text-sm font-normal leading-tight text-black">Fotograf</label>
                    <InputText @bind-Value="SelectedEintrag.ImageCreatedBy" disabled="@isSaving" title="Wer hat das Bild gemacht?" class="font-ptsans w-full border border-black px-3 py-1 text-sm font-normal tracking-widest" />
                </div>
            </div>

            @if (CanEdit)
            {
                <div class="p-4">
                    @if (savedSuccessfully && !SelectedEintrag.Changed)
                    {
                        <button @onclick="CloseSidebar" class="h-10 w-full transform bg-black px-5 text-center text-white transition duration-150 ease-in-out hover:bg-primary active:scale-90" aria-label="Zurück zur vorherigen Seite">
                            <div class="flex flex-row items-center justify-start">
                                <span class="material-symbols-outlined m-0.5 text-white">done</span>
                                <span class="font-yuji px-5 text-sm font-normal leading-tight tracking-widest">Jetzt zurück gehen</span>
                            </div>
                        </button>
                        <div class="mt-5 text-primary">
                            <Standardtext Text="Erfolgreich gespeichert" />
                        </div>
                    }
                    else
                    {
                        <button @onclick="onSave" class="h-10 w-full transform bg-black px-5 text-center text-white opacity-100 transition duration-150 ease-in-out hover:bg-primary active:scale-90" aria-label="Eintrag speichern">
                            <div class="flex flex-row items-center justify-start">
                                <span class="material-symbols-outlined">save</span>
                                <span class="font-yuji px-5 text-sm font-normal leading-tight tracking-widest">Speichern</span>
                            </div>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="z-10 sticky inset-y-20 flex-col items-center justify-center @(isSaving ? "flex"  : "hidden")">
        <SfProgressBar Type="ProgressType.Circular" Value="@currentSave" EnableRtl="false"
                       TrackColor="#2A6749" Radius="100%" InnerRadius="350%" ProgressColor="white" TrackThickness="80"
                       ProgressThickness="8" CornerRadius="CornerType.Round" Minimum="0" Maximum="@maxSave">
            <ProgressBarAnnotations>
                <ProgressBarAnnotation>
                    <ContentTemplate>
                        <div class="font-yuji min-w-10 text-center text-sm tracking-wider text-white">
                            <span>
                                @progressText
                            </span>
                        </div>
                    </ContentTemplate>
                </ProgressBarAnnotation>
            </ProgressBarAnnotations>
        </SfProgressBar>
        <div class="mt-2">
            <Standardtext Text="@savingText" />
        </div>
    </div>
</div>

@code {

    [Parameter]
    public IEnumerable<GalerieEintrag> Einträge { get; set; } = new List<GalerieEintrag>();

    [Parameter]
    public EventCallback<bool> OnClose { get; set; }


    [Parameter]
    public bool IsOpen { get; set; }

    public bool CanEdit { get; set; } = false;


    public async Task<bool> CanClose()
    {
        if (isSaving)
        {
            bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Die Bilder werden gerade gespeichert! Willst du nicht warten, bis die Bilder fertig gespeichert sind?");
            return confirm;
        }
        else if (IsNew && uploadedFiles.Any() && !savedSuccessfully)
        {
            bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "Es sind bereits Dateien hochgeladen! Wollst du die bereits hochgeladenen Dateien wirklich verwerfen?");
            return confirm;
        }

        return true;
    }

    public async Task Clear()
    {
        try
        {

            //Aufräumen
            errorMessage = string.Empty;
            SelectedEintrag = new InputModel();
            await NichtGespeicherteBilderVerwerfenAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Aufräumen der Daten");
        }
    }

    public async void SetData(IEnumerable<GalerieEintrag> einträge)
    {
        try
        {
            Einträge = einträge;
            if (Einträge?.Count() > 0)
            {
                var dummy = Einträge?.FirstOrDefault();
                if (dummy != null)
                {
                    SelectedEintrag = new InputModel
                        {
                            Aikido = dummy.Aikido,
                            Beschreibung = dummy.Beschreibung ?? "",
                            Bujinkan = dummy.Bujinkan,
                            Genbukan = dummy.Genbukan,
                            Öffentlich = dummy.Öffentlich,
                            Home = dummy.Home,
                            ImageCreatedBy = dummy.ImageCreatedBy ?? "",
                            ImageDate = dummy.ImageDate,
                            Titel = dummy.Titel ?? "",
                            Untertitel = dummy.Untertitel ?? "",
                            Iaido = dummy.Iaido,
                            Jodo = dummy.Jodo
                        };
                }
            }
            else
            {
                SelectedEintrag = new InputModel();
                uploadedFiles = new();
            }
            savedSuccessfully = false;
            _entwurfVomUtc = null;
            await SetPermissions();

            // Ab jetzt ist die Seitenleiste offen: gesichert wird, sobald sich an diesem Stand etwas ändert
            _offen = true;
            (await SicherungAsync())?.AusgangMerken();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Setzen der Daten");
        }
        StateHasChanged();

    }

    #region Entwurf

    // Ungespeicherte Eingaben überstehen ein Neuladen der Seite (Tab-Wechsel auf dem Handy)
    private EntwurfSicherung<GalerieEntwurf>? _sicherung;
    private DateTime? _entwurfVomUtc;
    private bool _offen;

    private async Task<EntwurfSicherung<GalerieEntwurf>?> SicherungAsync()
    {
        if (_sicherung is null)
        {
            await UserService.InitializeAsync();
            if (!CanEdit || UserService.CurrentUser.User?.Id is not { } benutzerId)
                return null;
            _sicherung = new(Entwuerfe, Logger, benutzerId, "galerie", () => _offen ? AlsEntwurf() : null, e => e.Bilder.Select(b => b.Id));
        }
        // Beim Prerendering gibt es noch nichts zu sichern
        if (RendererInfo.IsInteractive)
            _sicherung.Starten(InvokeAsync);
        return _sicherung;
    }

    private GalerieEntwurf AlsEntwurf() => new()
    {
        EintragIds = Einträge?.Select(e => e.ID).ToList() ?? [],
        Bilder = uploadedFiles.Where(f => !f.EntryCreated).Select(f => new HochgeladenesBild(f.Id, f.FileName)).ToList(),
        Titel = SelectedEintrag.Titel,
        Untertitel = SelectedEintrag.Untertitel,
        Beschreibung = SelectedEintrag.Beschreibung,
        ImageCreatedBy = SelectedEintrag.ImageCreatedBy,
        ImageDate = SelectedEintrag.ImageDate,
        Oeffentlich = SelectedEintrag.Öffentlich,
        Home = SelectedEintrag.Home,
        Aikido = SelectedEintrag.Aikido,
        Bujinkan = SelectedEintrag.Bujinkan,
        Genbukan = SelectedEintrag.Genbukan,
        Iaido = SelectedEintrag.Iaido,
        Jodo = SelectedEintrag.Jodo
    };

    /// <summary>
    /// War die Seitenleiste beim letzten Mal offen und ungespeichert, stellt sie ihren Stand wieder her.
    /// </summary>
    /// <param name="alle">Alle Einträge der Galerie: daraus werden die bearbeiteten herausgesucht.</param>
    /// <returns>Die bearbeiteten Einträge (leer = neue Bilder), oder null, wenn es nichts wiederherzustellen gibt.</returns>
    public async Task<List<GalerieEintrag>?> EntwurfWiederherstellenAsync(IReadOnlyCollection<GalerieEintrag> alle)
    {
        await SetPermissions();
        if (await SicherungAsync() is not { } sicherung)
            return null;
        if (await sicherung.LadenAsync() is not { } geladen)
        {
            sicherung.AusgangMerken();
            return null;
        }

        var entwurf = geladen.Daten;
        var eintraege = alle.Where(e => entwurf.EintragIds.Contains(e.ID)).ToList();
        if (entwurf.EintragIds.Count > 0 && eintraege.Count == 0)
        {
            // Die bearbeiteten Einträge gibt es nicht mehr
            await sicherung.LoeschenAsync();
            return null;
        }

        var fehlend = await Entwuerfe.FehlendeBilderAsync(entwurf.Bilder.Select(b => b.Id).ToList());
        Einträge = eintraege;
        uploadedFiles = entwurf.Bilder.Where(b => !fehlend.Contains(b.Id)).Select(b => new UploadedFile { Id = b.Id, FileName = b.Dateiname }).ToList();
        SelectedEintrag = new InputModel
        {
            Titel = entwurf.Titel,
            Untertitel = entwurf.Untertitel,
            Beschreibung = entwurf.Beschreibung,
            ImageCreatedBy = entwurf.ImageCreatedBy,
            ImageDate = entwurf.ImageDate,
            Öffentlich = entwurf.Oeffentlich,
            Home = entwurf.Home,
            Aikido = entwurf.Aikido,
            Bujinkan = entwurf.Bujinkan,
            Genbukan = entwurf.Genbukan,
            Iaido = entwurf.Iaido,
            Jodo = entwurf.Jodo
        };
        errorMessage = string.Empty;
        savedSuccessfully = false;
        _entwurfVomUtc = geladen.GeaendertUtc;
        _offen = true;
        sicherung.AusgangMerken();
        StateHasChanged();
        return eintraege;
    }

    /// <summary>Die Seitenleiste ist zu: Entwurf weg, bis zum nächsten Öffnen wird nichts gesichert.</summary>
    private async Task EntwurfBeendenAsync()
    {
        _offen = false;
        _entwurfVomUtc = null;
        if (_sicherung is not null)
            await _sicherung.LoeschenAsync();
    }

    /// <summary>Löscht hochgeladene Bilder, zu denen kein Eintrag entstanden ist.</summary>
    private async Task NichtGespeicherteBilderVerwerfenAsync()
    {
        var offen = uploadedFiles.Where(f => !f.EntryCreated).Select(f => f.Id).ToList();
        uploadedFiles = new();
        if (offen.Count > 0)
            await BildUpload.VerwerfenAsync(offen);
    }

    public async ValueTask DisposeAsync()
    {
        if (_sicherung is not null)
            await _sicherung.DisposeAsync();
    }

    #endregion

    private InputModel SelectedEintrag { get; set; } = new InputModel();

    private bool IsNew => Einträge == null || Einträge?.Count() == 0;
    private bool CanSave { get; set; }

    private string savingText { get; set; } = string.Empty;
    private int currentSave { get; set; } = 0;
    private int maxSave { get; set; } = 0;

    public string progressText
    {
        get
        {
            if (maxSave > 0)
            {
                double current = currentSave;
                double max = maxSave;
                double percent = (current / max) * 100;
                return percent.ToString("N0") + " %";
            }
            return "0 %";
        }
    }

    private void SetCanSave(bool ausSave = false)
    {
        try
        {
            {
                if (ausSave)
                {
                    if (string.IsNullOrWhiteSpace(SelectedEintrag.Titel))
                    {
                        errorMessage = "Bitte gib noch einen Titel an!";
                        CanSave = false;
                        return;
                    }
                    if (IsNew && !uploadedFiles.Any(f => !f.EntryCreated))
                    {
                        errorMessage = "Bitte lade mindestens 1 Bild für die Gallerie hoch!";
                        CanSave = false;
                        return;
                    }
                }
                errorMessage = string.Empty;
                CanSave = true;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Setzen der Berechtigungen zum Speichern");
        }
    }

    // private bool filesUploaded = false;
    private string errorMessage = string.Empty;
    private bool savedSuccessfully = false;
    List<string> errors = new();
    bool isSaving { get; set; } = false;

    List<UploadedFile> uploadedFiles = new();
    // List<string> uploadedFiles = new();


    private async Task SetPermissions()
    {
        try
        {
            await UserService.InitializeAsync();
            var user = UserService.CurrentUser;
            if (Global.Roles.IsEditor(user.Roles) || Global.Roles.IsAbteilungsleiter(user.Roles) || Global.Roles.IsAdmin(user.Roles))
            {
                CanEdit = true;
            }
            else
            {
                CanEdit = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Setzen der Berechtigungen");
            CanEdit = false;
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await SetPermissions();
    }

    private async Task CloseSidebar()
    {
        try
        {
            // Erst fragen, dann aufräumen: sonst wären die Bilder schon weg, wenn man doch weitermachen will
            if (!await CanClose())
                return;
            await VerwerfenUndSchliessenAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Schließen der Sidebar");
        }
    }

    /// <summary>Schließt ohne Rückfrage: nicht gespeicherte Bilder und der Entwurf werden gelöscht.</summary>
    private async Task VerwerfenUndSchliessenAsync()
    {
        await NichtGespeicherteBilderVerwerfenAsync();
        await EntwurfBeendenAsync();
        await OnClose.InvokeAsync(savedSuccessfully);
    }

    private void BildHochgeladen(HochgeladenesBild bild)
    {
        uploadedFiles.Add(new UploadedFile { Id = bild.Id, FileName = bild.Dateiname });
        errorMessage = string.Empty;
    }

    private async Task BildEntfernenAsync(UploadedFile bild)
    {
        uploadedFiles.Remove(bild);
        if (!bild.EntryCreated)
            await BildUpload.VerwerfenAsync([bild.Id]);
    }

    private async Task onSave()
    {
        if (CanEdit == false)
            return;
        if (isSaving)
            return;
        try
        {
            isSaving = true;
            savingText = string.Empty;
            SetCanSave(true);
            if (CanSave == false)
                return;
            if (SelectedEintrag.IsValid == false)
                return;

            errors = new();

            if (IsNew)
            {
                await SaveNewFiles();
            }
            else
            {
                await SaveChanged();
            }

            if (errors.Any())
            {
                errorMessage = string.Join(Environment.NewLine, errors);
                errors = new();
            }
            else
            {
                SelectedEintrag.Changed = false;
                savedSuccessfully = true;
                isSaving = false;


                // Gespeichert: der Entwurf hat seinen Zweck erfüllt
                if (IsNew)
                {
                    await VerwerfenUndSchliessenAsync();
                }
                else if (_sicherung is not null)
                {
                    await _sicherung.LoeschenAsync();
                    _sicherung.AusgangMerken();
                    _entwurfVomUtc = null;
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Bei der Erstellung der neuen Einträge ist ein Fehler aufgetreten: " + ex.Message;
            Logger.LogError(ex, errorMessage);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveChanged()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        string? userId = "unbekannt";
        if (user?.Identity?.IsAuthenticated == true)
        {
            userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        }
        maxSave = Einträge.Count();
        currentSave = 0;

        foreach (var eintrag in Einträge)
        {
            currentSave++;
            savingText = $"Bild {currentSave} von {maxSave}";
            // StateHasChanged();

            try
            {
                var item = await DbContext.Galerie.FindAsync(eintrag.ID);
                if (item != null)
                {
                    item.Titel = SelectedEintrag.Titel;
                    item.Untertitel = SelectedEintrag.Untertitel;
                    item.Beschreibung = SelectedEintrag.Beschreibung;
                    item.ImageDate = SelectedEintrag.ImageDate;
                    item.ImageCreatedBy = SelectedEintrag.ImageCreatedBy;
                    item.Öffentlich = SelectedEintrag.Öffentlich;
                    item.Home = SelectedEintrag.Home;
                    item.Aikido = SelectedEintrag.Aikido;
                    item.Bujinkan = SelectedEintrag.Bujinkan;
                    item.Genbukan = SelectedEintrag.Genbukan;
                    item.Iaido = SelectedEintrag.Iaido;
                    item.Jodo = SelectedEintrag.Jodo;
                    item.LastChangedUTC = DateTime.UtcNow;
                    item.LastChangedBy = userId;

                    await DbContext.SaveChangesAsync();
                }
                // DbContext.Galerie.Update(item);
                await DbContext.SaveChangesAsync();
            }
            catch (Exception ex)
            {
                errors.Add($"Fehler beim Speichern des Eintrags {eintrag.Titel}: {ex.Message}");
                Logger.LogError(ex, $"Fehler beim Speichern des Eintrags {eintrag.Titel}: {ex.Message}");
            }
        }
    }

    private async Task SaveNewFiles()
    {
        try
        {
            var files = uploadedFiles.Where(f => !f.EntryCreated).ToList();            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            string? userId = "unbekannt";
            if (user?.Identity?.IsAuthenticated == true)
            {
                userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            }

            maxSave = files.Count();
            currentSave = 0;

            foreach (var file in files)
            {
                try
                {
                    currentSave++;
                    savingText = $"Bild {currentSave} von {maxSave}";

                    var uploadedFile = file;
                    int dbImageId = uploadedFile.Id;
                    // Nur prüfen, nicht laden: die Bilddaten werden hier nicht gebraucht
                    if (!await DbContext.Images.AnyAsync(i => i.Id == dbImageId))
                    {
                        errors.Add($"Die Datei {file.FileName} wurde nicht in der Datenbank gefunden!");
                        continue;
                    }

                    var neuerEintrag = new GalerieEintrag
                        {
                            Titel = SelectedEintrag.Titel,
                            Untertitel = SelectedEintrag.Untertitel,
                            Beschreibung = SelectedEintrag.Beschreibung,
                            ImageDate = SelectedEintrag.ImageDate,
                            ImageCreatedBy = SelectedEintrag.ImageCreatedBy,
                            Öffentlich = SelectedEintrag.Öffentlich,
                            Home = SelectedEintrag.Home,
                            Aikido = SelectedEintrag.Aikido,
                            Bujinkan = SelectedEintrag.Bujinkan,
                            Genbukan = SelectedEintrag.Genbukan,
                            Iaido = SelectedEintrag.Iaido,
                            Jodo = SelectedEintrag.Jodo,
                            EntryCreatedBy = userId,
                            EntryCreationDateUTC = DateTime.UtcNow,
                            DbImageId = dbImageId
                        };
                    await DbContext.Galerie.AddAsync(neuerEintrag);
                    await DbContext.SaveChangesAsync();
                    // Bis hierhin war das Bild vorläufig (BildAufraeumJob)
                    await BildVerwendung.AlsGespeichertMarkierenAsync(DbContext, [dbImageId]);

                    uploadedFile.EntryCreated = true;
                }
                catch (Exception ex)
                {
                    errors.Add($"Fehler beim Speichern der neuen Datei {file.FileName}");
                    Logger.LogError(ex, "Fehler beim Speichern der neuen Datei {Datei}", file.FileName);
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Speichern der neuen Datei");
            errorMessage = "Fehler beim Speichern der neuen Datei";
            savedSuccessfully = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    public async Task CopyFileAsync(string sourceFile, string destinationFile)
    {
        try
        {
            using (var sourceStream = new FileStream(sourceFile, FileMode.Open, FileAccess.Read, FileShare.Read, 4096, FileOptions.Asynchronous | FileOptions.SequentialScan))
            using (var destinationStream = new FileStream(destinationFile, FileMode.CreateNew, FileAccess.Write, FileShare.None, 4096, FileOptions.Asynchronous | FileOptions.SequentialScan))
                await sourceStream.CopyToAsync(destinationStream);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Kopieren der Datei");
        }
    }


