@* Ohne eigenen Render-Modus: reine Anzeige; auf statischen Seiten soll sie keine SignalR-Verbindung öffnen *@

<div class="font-yuji relative mx-auto -mb-5 w-full max-w-screen-xl md:mb-24">
    <div class="relative mb-0 mt-0 flex max-w-screen-xl flex-col items-center justify-center">
        <div class="relative mx-auto flex flex-col items-center justify-center md:pb-10 max-w-screen-md">
            <div>
                <h2 class="font-yuji hyphens-auto break-words text-center font-normal text-black @TitelGroesse">@Titel</h2>
            </div>
            <div>
                <h1 class="font-yuji hyphens-auto text-wrap break-words text-center font-normal text-black @UntertitelGroesse">@Untertitel</h1>
            </div>
            <div class="pt-5 md:absolute md:bottom-0 md:right-0">
                <p class="font-yuji tracking-[0.21rem] text-center text-xl font-normal md:text-right md:text-xl">@Anekdote</p>
            </div>
        </div>
    </div>

    <div class="absolute right-5 top-0 hidden md:block">
        <div class="font-yuji text-right text-2xl font-normal text-black">武<br />道<br />修<br />練<br />道<br />場</div>
    </div>
</div>

@code {
    [Parameter]
    public string? Titel { get; set; }

    [Parameter]
    public string? Untertitel { get; set; }

    [Parameter]
    public string? Anekdote { get; set; }

    // Die Kopfzeile ist für kurze Texte entworfen: wenige Schriftzeichen als Titel, ein Wort mit sehr weitem
    // Zeichenabstand als Untertitel. Texte aus der Datenbank (Aktuelles, Themen) sind oft länger und werden
    // deshalb stufenweise kleiner und enger gesetzt, damit sie auch auf dem Handy in die Breite passen.
    private string TitelGroesse => (Titel?.Trim().Length ?? 0) switch
    {
        <= 8 => "text-5xl tracking-widest sm:text-7xl md:text-8xl",
        <= 20 => "text-4xl tracking-wider sm:text-5xl md:text-6xl",
        <= 40 => "text-3xl tracking-wide sm:text-4xl md:text-5xl",
        _ => "text-2xl tracking-wide sm:text-3xl md:text-4xl"
    };

    // Beim Untertitel zählt neben der Länge das längste Wort: es lässt sich nicht umbrechen
    private string UntertitelGroesse
    {
        get
        {
            var text = Untertitel?.Trim() ?? string.Empty;
            var laengstesWort = text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(w => w.Length).DefaultIfEmpty(0).Max();

            if (text.Length <= 22 && laengstesWort <= 13)
                return "tracking-[1.0rem] text-base sm:text-xl sm:tracking-[1.3rem] md:tracking-[1.4rem] xs:text-xl xs:tracking-[1.2rem]";
            if (text.Length <= 40 && laengstesWort <= 18)
                return "tracking-[0.5rem] text-base sm:text-xl sm:tracking-[0.8rem] md:tracking-[1.0rem] xs:text-lg";
            return "tracking-[0.25rem] text-base sm:text-lg sm:tracking-[0.4rem] md:tracking-[0.5rem]";
        }
    }
}
