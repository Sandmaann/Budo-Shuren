@inject ILogger<InteresseFormular> Logger
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject EmailSender EmailSender
@inject VisitorCounterService VisitorCounterService
@inject UserManager<ApplicationUser> UserManager
@inject KontaktSchutz Schutz
@inject KontaktProtokoll Protokoll
@inject NavigationManager NavigationManager
@inject IHttpContextAccessor HttpContextAccessor

@using BudoShurenWebsite.Models.Enums
@using BudoShurenWebsite.Services.Kontakt
@using Microsoft.Extensions.Options
@using System.ComponentModel.DataAnnotations
@using Syncfusion.Blazor.DropDowns;
@using Microsoft.AspNetCore.Identity

<div class="h-full">
    @if (ShowText)
    {
        <div class="font-yuji text-sm font-normal leading-tight tracking-wider text-black">Interesse? <br />Dann schreibe mir doch gerne eine Nachricht!</div>
    }

    @* Statisch eingebunden (z. B. Aikido) lädt das Absenden die Seite neu und sie steht oben: dort zeigt die Seite
       die Rückmeldung (OnSend). Interaktiv (z. B. Kontakt) bleibt die Seite stehen: Rückmeldung unter "Senden". *@
    @if (!RendererInfo.IsInteractive)
    {
        <StatusMessage Message="@errorMessage" />
    }
    <EditForm Model="Input" method="post" OnValidSubmit="SubmitNachricht" FormName="nachricht" class="flex h-full flex-col">
        <DataAnnotationsValidator />
        <ValidationSummary class="mt-8 text-error" role="alert" />
        <div class="mt-4 text-right">
            <label for="email" class="font-ptsans tracking-[0.375rem] text-right text-sm font-normal leading-tight text-black">Deine E-Mail</label>
        </div>
        <div class="@(ShowMarginAuswahlfelder ? "ml-20" : "")">
            <InputText id="email" @bind-Value="Input.Email" class="font-ptsans w-full border border-black px-3 py-4 text-sm font-normal tracking-widest" autocomplete="email" aria-required="true" placeholder="beispiel@email.de" />
            <ValidationMessage For="() => Input.Email" class="text-error" />
        </div>

        @if (ShowAbteilung)
        {
            <div class="mt-4 text-right">
                <label for="abteilung" class="font-ptsans tracking-[0.375rem] text-right text-sm font-normal leading-tight text-black">Empfänger</label>
            </div>
            <div class="@(ShowMarginAuswahlfelder ? "ml-20" : "")">
                <div id="abteilung">
                    <SfDropDownList TValue="string"
                                    TItem="Abteilung"
                                    Placeholder="Wähle eine Abteilung aus"
                                    @bind-Value="@Input.SelectedAbteilung"
                                    DataSource="@Abteilungen">
                        <DropDownListTemplates TItem="Abteilung">
                            <ItemTemplate Context="itemContext">
                                <div class="my-auto py-4 text-center">
                                    <span class="font-ptsans text-sm font-bold tracking-wider">@((itemContext as Abteilung).Name)</span>
                                    <span class="font-ptsans text-sm font-normal tracking-wider">@((itemContext as Abteilung).Abteilungsleiter)</span>
                                </div>
                            </ItemTemplate>
                            <ValueTemplate Context="itemContext">
                                <div class="my-auto py-4 text-center">
                                    <span class="font-ptsans text-sm font-bold tracking-wider">@((itemContext as Abteilung).Name)</span>
                                    <span class="font-ptsans text-sm font-normal tracking-wider">@((itemContext as Abteilung).Abteilungsleiter)</span>
                                </div>
                            </ValueTemplate>
                        </DropDownListTemplates>
                        <DropDownListFieldSettings Text="Name" Value="Name"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>
                <ValidationMessage For="() => Input.SelectedAbteilung" class="text-error" />
            </div>
        }

        <div class="mt-8 text-right">
            <label for="nachricht" class="font-ptsans tracking-[0.375rem] text-right text-sm font-normal leading-tight text-black">Deine Nachricht</label>
        </div>
        <div class="grow">
            <InputTextArea id="nachricht" @bind-Value="Input.Text" class="font-ptsans h-full min-h-80 w-full max-w-full resize-none border border-black px-3 py-4 text-sm font-normal tracking-widest" autocomplete="off" aria-required="true" placeholder="Was möchtest du schreiben?" />
            <ValidationMessage For="() => Input.Text" class="text-error" />
        </div>

        @* Honeypot: für Menschen unsichtbar und nicht per Tastatur erreichbar. Kein display:none, das erkennen Bots. *@
        <div class="absolute -left-[10000px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <InputText id="website" @bind-Value="Input.Website" tabindex="-1" autocomplete="off" />
        </div>
        @* Verschlüsselter Zeitpunkt des Auslieferns (KontaktSchutz) *@
        <InputText type="hidden" @bind-Value="Input.Zeitstempel" />

        <div class="mt-8 flex justify-end">
            <button type="submit" class="font-yuji h-10 transform bg-black px-5 text-center text-sm font-normal leading-tight tracking-widest text-white transition duration-150 ease-in-out hover:bg-primary active:scale-90">
                <span class="text-center text-white">Senden</span>
            </button>
        </div>
        @if (RendererInfo.IsInteractive)
        {
            <div class="mt-4">
                <StatusMessage ShowAsError="true" Message="@errorMessage" />
                @if (_gesendet)
                {
                    <StatusMessage ShowAsError="false" Message="Deine Nachricht wurde erfolgreich versendet!" />
                }
            </div>
        }
    </EditForm>
</div>

<style>
    .resize-horizontal {
        resize: horizontal;
        overflow: auto;
    }

    .e-ddl.e-input-group.e-control-wrapper .e-ddl-icon::before {
        color: #000000;
        font-weight: 700;
    }

    .e-custom.e-input-group, .e-custom.e-input-group.e-control-wrapper {
        height: 52px;
        border-width: 1px;
        border-color: #000000;
        border-radius: 0;
    }

    .e-input-group:not(.e-success):not(.e-warning):not(.e-error), .e-input-group.e-control-wrapper:not(.e-success):not(.e-warning):not(.e-error) {
        height: 52px;
        border-color: #000000;
        border-radius: 0;
    }

    .e-input-group.e-success, .e-input-group.e-control-wrapper.e-success, .e-input-group.e-success:not(.e-float-icon-left), .e-input-group.e-control-wrapper.e-success:not(.e-float-icon-left) {
        border-color: #000000;
        border-radius: 0;
    }

    .e-ddl.e-input-group.e-control-wrapper .e-input {
        height: 52px;
        border-color: #000000;
        border-radius: 0;
    }

    .e-dropdownbase .e-list-item.e-active,
    .e-dropdownbase .e-list-item.e-active.e-hover {
        background-color: #2A6749;
    }

</style>

@code {
    private string? errorMessage;
    private bool _gesendet;


    [Parameter]
    public string? Abteilung { get; set; }

    [Parameter]
    public bool ShowAbteilung { get; set; } = false;

    [Parameter]
    public bool ShowText { get; set; } = true;

    [Parameter]
    public bool ShowMarginAuswahlfelder { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnSend { get; set; }

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    /// <summary>Nur beim statischen Rendern gesetzt.</summary>
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    public string DropVal = string.Empty;
    private IEnumerable<Abteilung> Abteilungen = Array.Empty<Abteilung>();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Ein abgeschicktes Formular bringt seinen Zeitstempel mit. Fehlt er dort, gilt die Nachricht als zu schnell abgeschickt.
        if (string.IsNullOrEmpty(Input.Zeitstempel))
            Input.Zeitstempel = Schutz.Zeitstempel();

        using var context = DbContextFactory.CreateDbContext();
        Abteilungen = await context.Abteilungen.ToListAsync();
        if (Abteilungen.FirstOrDefault(x => x.Name == Abteilung) is Abteilung auswahl)
        {
            Input.SelectedAbteilung = auswahl.Name ?? "";
        }
    }

    public async Task SubmitNachricht()
    {
        errorMessage = null;
        _gesendet = false;

        // Die Abteilung wird hier überall über den Namen angegeben (Auswahl, Seiten-Parameter, ApplicationUser.Abteilung)
        if (Abteilungen.FirstOrDefault(x => x.Name == Input.SelectedAbteilung) is not Abteilung abteilung)
        {
            // Ohne Abteilung gibt es keinen Empfänger (früher brach das Formular hier ohne jede Meldung ab)
            errorMessage = "Bitte wähle aus, an wen deine Nachricht gehen soll.";
            return;
        }

        string nachricht = Input.Text;
        var anfrage = new KontaktAnfrage
        {
            Abteilung = abteilung.Name,
            AbsenderEmail = Input.Email,
            Nachricht = nachricht,
            Seite = Seite(),
            Interaktiv = RendererInfo.IsInteractive
        };

        var pruefung = Schutz.Pruefen(Input.Website, Input.Zeitstempel, Input.Email, nachricht, IpAdresse());
        if (pruefung.Abgelehnt is { } grund)
        {
            anfrage.Status = grund;
            anfrage.Hinweis = pruefung.Hinweis;
            await Protokoll.EintragenAsync(anfrage);

            // Mit einem neuen Zeitstempel klappt der zweite Versuch
            if (grund == KontaktAnfrageStatus.FormularUngueltig)
                Input.Zeitstempel = Schutz.Zeitstempel();
            errorMessage = KontaktSchutz.Meldung(grund);
            await RueckmeldenAsync(false);
            return;
        }

        string name = abteilung.Abteilungsleiter?.Split(" ")[0] ?? "unbekannter Abteilungsleiter";
        const string betreff = "Neue Anfrage von der Budo-Shuren-Dojo Webseite";
        int mails = 0;

        //E-Mail an die "Abteilung" senden - die die in der DB zur Abteilung hinterlegt ist.
        if (!string.IsNullOrWhiteSpace(abteilung.Email))
        {
            try
            {
                await EmailSender.SendEmailAsync(abteilung.Email, betreff, EmailSender.InteresseMail(name, nachricht, Input.Email));
                mails++;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, $"Fehler beim Senden der Nachricht an Abteilung {abteilung.Name}");
            }
        }

        //E-Mail an Abteilungsleiter senden
        try
        {
            var users = await UserManager.GetUsersInRoleAsync(Roles.Abteilungsleiter);
            foreach (var user in users.Where(x => x.Abteilung == abteilung.Name && x.Email != abteilung.Email))
            {
                try
                {
                    await EmailSender.SendEmailAsync(user.Email ?? "", betreff, EmailSender.InteresseMail(user.Vorname, nachricht, Input.Email));
                    mails++;
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, $"Fehler beim Senden der Nachricht an Abteilungsleiter {user.UserName}");
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, $"Fehler beim Ermitteln der Abteilungsleiter von {abteilung.Name}");
        }

        anfrage.AnzahlMails = mails;
        if (mails == 0)
        {
            Logger.LogError("An keine einzige der Abteilungs / Abteilungsleiter-Adressen konnte eine E-Mail geschickt werden.");
            anfrage.Status = KontaktAnfrageStatus.VersandFehler;
            anfrage.Hinweis = "Keine Mail an die Abteilung oder ihre Abteilungsleiter verschickt, siehe Log";
            await Protokoll.EintragenAsync(anfrage);

            errorMessage = "Die Nachricht konnte leider nicht versendet werden! Du kannst auch direkt an info@budo-shuren-dojo.de schreiben. In unserem Impressum findest du auch die einzelnen Kontaktdaten der Abteilungsleiter.";
            await RueckmeldenAsync(false);
            return;
        }

        //Bestätigungsemail an den Absender schicken. Schlägt sie fehl, ist die Nachricht trotzdem angekommen.
        try
        {
            await EmailSender.SendKontaktformularConfirmation(Input.Email);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Senden der Bestätigung an den Absender (Interesse Formular)");
            anfrage.Hinweis = "Bestätigung an den Absender konnte nicht verschickt werden";
        }

        anfrage.Status = KontaktAnfrageStatus.Zugestellt;
        await Protokoll.EintragenAsync(anfrage);

        //Counter
        try
        {
            await VisitorCounterService.AddVisitorAsync(Input.Email, "InteresseEmail_" + abteilung.Name);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Fehler beim Zählen eines Besuchers (Interesse Formular)");
        }

        await RueckmeldenAsync(true);

        Input.Text = string.Empty;
        Input.Email = string.Empty;
    }

    /// <summary>Interaktiv zeigt das Formular die Rückmeldung selbst unter dem Button, statisch die Seite oben (OnSend).</summary>
    private async Task RueckmeldenAsync(bool erfolgreich)
    {
        if (RendererInfo.IsInteractive)
            _gesendet = erfolgreich;
        else
            await OnSend.InvokeAsync(erfolgreich);
    }

    /// <summary>Seite, auf der das Formular steht, ohne Query (für das Protokoll).</summary>
    private string Seite()
    {
        var pfad = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0];
        return pfad.Length == 0 ? "Home" : pfad;
    }

    /// <summary>
    /// Adresse des Absenders für KontaktLimit. Interaktiv gibt es keine Anfrage, nur die der Verbindung:
    /// die ist nicht immer greifbar, dann gelten die Grenzen je E-Mail-Adresse und insgesamt.
    /// </summary>
    private string? IpAdresse()
    {
        try
        {
            return (HttpContext ?? HttpContextAccessor.HttpContext)?.Connection.RemoteIpAddress?.ToString();
        }
        catch (ObjectDisposedException)
        {
            return null;
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = Messages.EmailRequiredErrorMessage)]
        [Display(Name = "Deine E-Mail Adresse")]
        [EmailAddress(ErrorMessage = Messages.EmailFormatErrorMessage)]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = Messages.NachrichtRequiredErrorMessage)]
        [StringLength(KontaktAnfrage.MaxNachricht, ErrorMessage = "Deine Nachricht ist zu lang (höchstens 4000 Zeichen).")]
        [Display(Name = "Deine Nachricht")]
        [DataType(DataType.Text)]
        public string Text { get; set; } = "";

        [Display(Name = "Abteilung")]
        public string SelectedAbteilung { get; set; } = "";

        // Honeypot-Feld
        public string Website { get; set; } = "";

        /// <summary>Verschlüsselter Ladezeitpunkt (KontaktSchutz).</summary>
        public string? Zeitstempel { get; set; }
    }

}
