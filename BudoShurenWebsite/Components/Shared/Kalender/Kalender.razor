@code {
    private SfSchedule<AppointmentData> scheduleObj;

    DateTime CurrentDate = DateTime.Today;
    private bool IsLoading { get; set; } = false;
    private string ErrorMessage { get; set; } = string.Empty;

    private List<Abteilung> Abteilungen = new List<Abteilung>()
    {
        new Abteilung() { ID= "Verein", Name= "Verein", Abteilungsleiter = "" },
        new Abteilung() { ID= "Aikido", Name= "Aikido", Abteilungsleiter = "Björn Rosenstiel﻿﻿" },
        new Abteilung() { ID= "Bujinkan", Name= "Bujinkan", Abteilungsleiter = "Johannes Schiebl" },
        new Abteilung() { ID= "Genbukan", Name= "Genbukan", Abteilungsleiter = "Henry Schubert" },
    };

    [Parameter]
    public string? Abteilung { get; set; }
    [Parameter]
    public bool IsEditable { get; set; } = false;

    [Parameter]
    public bool? IsWochenansicht { get; set; }

    private bool? WochenansichtEinstellung
    {
        get
        {
            if (CurrentView == View.Week)
                return true;
            else if (CurrentView == View.Month)
                return false;
            return null;
        }
    }

    private void OnCurrentViewChanged(View view)
    {
        if (view == View.Week)
            IsWochenansicht = true;
        else if (view == View.Month)
            IsWochenansicht = false;
        else
            IsWochenansicht = null;
        // CurrentView = args.CurrentView;
    }


    private bool Permission { get; set; } = false;

    private bool AllowEditing => IsEditable && Permission;

    private View CurrentView { get; set; }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        return base.SetParametersAsync(parameters);

        if (IsWochenansicht == true)
            CurrentView = View.Week;
        else if (IsWochenansicht == false)
            CurrentView = View.Month;

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (firstRender)
        {
            await SetPermissions();
            if (scheduleObj != null)
            {
                // await scheduleObj.RefreshAsync();
            }
        }
    }

    private async Task SetPermissions()
    {
        await UserService.InitializeAsync();
        if (UserService.IsAbteilungsleiter || UserService.IsEditor || UserService.IsAdmin)
        {
            Permission = true;
        }
        else
        {
            Permission = false;
        }
        StateHasChanged();

        var e = AllowEditing;
    }

    private async void CloseQuickInfo()
    {
        if(this.scheduleObj != null)
        {
            await scheduleObj.CloseQuickInfoPopupAsync();
        }
    }

    public static bool MoreThanHalfAnHour(DateTime start, DateTime ende)
    {
        if (ende.Subtract(start).TotalMinutes > 30)
        {
            return true;
            // return "absolute";
        }
        else
        {
            return false;
            // return "hidden";
        }
    }
    private async void OnDeleteClick(MouseEventArgs args, AppointmentData data)
    {
        await scheduleObj.CloseQuickInfoPopupAsync();

        if (UserService.IsEditor || UserService.IsAbteilungsleiter || UserService.IsAdmin)
        {
            await UserService.InitializeAsync();
            await scheduleObj.DeleteEventAsync(data);
        }
    }
    private async void OnBearbeitenClick(MouseEventArgs args, AppointmentData data)
    {
        await scheduleObj.CloseQuickInfoPopupAsync();

        await UserService.InitializeAsync();
        if (UserService.IsEditor || UserService.IsAbteilungsleiter || UserService.IsAdmin)
        {
            string abteilung;
            if (Abteilung == "Alle")
                abteilung = string.Empty;
            else
                abteilung = Abteilung;

            AppointmentData eventData = new AppointmentData
                {
                    Id = data.Id,
                    Subject = data.Subject,
                    Location = data.Location,
                    Description = data.Description,
                    StartTime = data.StartTime,
                    EndTime = data.EndTime,
                    IsAllDay = data.IsAllDay,
                    Abteilung = abteilung,
                    RecurrenceException = data.RecurrenceException,
                    RecurrenceID = data.RecurrenceID,
                    RecurrenceRule = data.RecurrenceRule
                };
            await scheduleObj.OpenEditorAsync(eventData, CurrentAction.Save);
        }
    }

    public static string GetTimeString(DateTime date)
    {
        return date.ToString("HH:mm", CultureInfo.InvariantCulture);
    }
    public static string getDateHeaderTextDay(DateTime date)
    {
        return date.ToString("dddd", CultureInfo.CurrentCulture);
    }
    public static string getShortDateHeaderTextDay(DateTime date)
    {
        return date.ToString("ddd", CultureInfo.CurrentCulture);
    }
    public static string getDateHeaderTextNumber(DateTime date)
    {
        return date.ToString("dd. MM.", CultureInfo.CurrentCulture);
    }
    public static string getShortDateHeaderTextNumber(DateTime date)
    {
        return date.ToString("dd", CultureInfo.CurrentCulture);
    }
    public static bool IsHalfHour(DateTime start, DateTime end)
    {
        return end.Subtract(start).TotalMinutes <= 30;
    }
}