@rendermode InteractiveServer

@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Buttons
@using System.Globalization
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject UserService UserService

<div class="font-ptsans -mx-10 lg:-mx-32 md:mx-0">
    <SfSchedule @ref="scheduleObj"
                CssClass="schedule-cell-dimension"
                TValue="AppointmentData"
                Height="694px"
                Readonly="@(AllowEditing == false)"
                @bind-SelectedDate="@CurrentDate"
                ShowQuickInfo="@(!IsEditable)"
                AllowMultiCellSelection="false"
                AllowResizing="false"
                AllowDragAndDrop="false"
                CurrentViewChanged="@OnCurrentViewChanged"
                ShowTimeIndicator="false">
        <ScheduleQuickInfoTemplates TemplateType="TemplateType.Event">
            <HeaderTemplate>
                @{
                    var appointment = context as AppointmentData;
                }
                <div>
                    <div class="flex flex-row justify-between rounded p-2" style="background:@(appointment.Color)">
                        <p class="font-yuji text-xl font-normal tracking-widest text-white md:text-2xl">
                            @appointment.Subject
                        </p>
                        <button class="bg-transparent text-white" @onclick="CloseQuickInfo">
                            <span class="material-symbols-outlined">close</span>
                        </button>
                    </div>
                </div>
            </HeaderTemplate>
            <FooterTemplate>
                @if (Permission && IsEditable)
                {
                    <div class="flex flex-row justify-end gap-2">
                        <SfButton Content="Bearbeiten" IsPrimary="true" OnClick="@(e => OnBearbeitenClick(e, context as AppointmentData))"></SfButton>
                        <SfButton Content="Löschen" OnClick="@(e => OnDeleteClick(e, context as AppointmentData))"></SfButton>
                    </div>
                }
                else
                {
                    <div>
                        <div class="">Abteilung: @((context as AppointmentData).Abteilung)</div>
                    </div>
                }
            </FooterTemplate>
        </ScheduleQuickInfoTemplates>
        <ScheduleViews>
            @if (IsWochenansicht == true || IsEditable)
            {
                <ScheduleView Option="View.Week"
                              StartHour="14:00"
                              EndHour="22:00"
                              FirstDayOfWeek="1">
                    <EventTemplate>
                        @{
                            var appointment = context as AppointmentData;
                        }
                        <div class="template-wrap" style="background:@(appointment.Color)">
                            @if (appointment.IsAllDay)
                            {
                                <div class="font-ptsans text-2xs text-wrap break-all px-1 py-1 font-bold tracking-wider text-white md:break-normal md:py-0 md:text-sm lg:text-base md:px-2">@appointment.Subject</div>
                            }
                            else
                            {
                                if (MoreThanHalfAnHour(appointment.StartTime, appointment.EndTime))
                                {
                                    <div class="font-ptsans text-2xs hidden text-balance px-0 pb-0.5 pt-1 text-center font-bold tracking-wider text-white md:px-1 md:text-2xs lg:text-xs md:pt-1.5 md:block">@GetTimeString(appointment.StartTime) - @GetTimeString(appointment.EndTime)</div>
                                    <div class="font-ptsans text-2xs text-wrap break-all px-1 py-1 font-bold tracking-wider text-white md:break-normal md:py-0 md:text-sm lg:text-base md:px-2">@appointment.Subject</div>
                                    <div class="font-ptsans text-2xs text-balance px-1 font-bold tracking-wide text-white md:px-2 md:py-1 md:text-xs">@appointment.Description</div>
                                }
                                else
                                {
                                    <div class="font-ptsans text-2xs text-wrap break-all px-1 py-1 font-bold tracking-wider text-white md:break-normal md:py-0 md:text-sm lg:text-base md:px-2">@appointment.Subject</div>
                                }
                            }
                        </div>
                    </EventTemplate>
                </ScheduleView>
            }
            @if (IsWochenansicht == false || IsEditable)
            {
                <ScheduleView Option="View.Month"
                              FirstDayOfWeek="1"
                              MaxEventsPerRow="3">
                    <EventTemplate>
                        @{
                            var appointment = context as AppointmentData;
                        }
                        <div class="template-wrap" style="background:@(appointment.Color)">
                            @if (appointment.IsAllDay)
                            {
                                <div class="my-auto">
                                    <span class="font-ptsans px-1 text-xs font-bold tracking-wide text-white">@appointment.Subject</span>
                                </div>
                            }
                            else
                            {
                                <div class="my-auto">
                                    <span class="font-ptsans hidden px-1 text-xs font-normal tracking-wide text-white md:inline">@GetTimeString(appointment.StartTime)</span>
                                    <span class="font-ptsans text-2xs break-all px-1 font-bold tracking-wide text-white md:text-xs">@appointment.Subject</span>
                                </div>
                            }
                        </div>
                    </EventTemplate>
                </ScheduleView>
            }
        </ScheduleViews>
        <ScheduleEventSettings TValue="AppointmentData" AllowAdding="@AllowEditing" AllowDeleting="@AllowEditing" AllowEditing="@AllowEditing" AllowEditFollowingEvents="false">
            <SfDataManager Adaptor="Adaptors.CustomAdaptor">
                <AppointmentAdaptorComponent Abteilung="@Abteilung" IsWeek="@IsWochenansicht"></AppointmentAdaptorComponent>
            </SfDataManager>
        </ScheduleEventSettings>

        <ScheduleTemplates>
            <EditorTemplate>
                @{
                    var appointment = context as AppointmentData;
                }
                <div>
                    <SfTextBox Placeholder="Termin"
                               FloatLabelType="FloatLabelType.Always"
                               @bind-Value="@(appointment.Subject)"></SfTextBox>
                    <ValidationMessage For="@(() => appointment.Subject)" />
                    <div>
                        <SfDropDownList ID="Abteilung"
                                        DataSource="@Abteilungen"
                                        Placeholder="Abteilung"
                                        @bind-Value="@(appointment.Abteilung)"
                                        FloatLabelType="FloatLabelType.Always">
                            <DropDownListFieldSettings Value="Name"></DropDownListFieldSettings>
                        </SfDropDownList>
                        <ValidationMessage For="@(() => appointment.Abteilung)" />
                    </div>
                    <div>
                        <SfDateTimePicker Placeholder="Start"
                                          FloatLabelType="FloatLabelType.Always"
                                          @bind-Value="@(appointment.StartTime)"></SfDateTimePicker>
                        <ValidationMessage For="@(() => appointment.StartTime)" />
                    </div>
                    <div>
                        <SfDateTimePicker Placeholder="Ende"
                                          FloatLabelType="FloatLabelType.Always"
                                          @bind-Value="@(appointment.EndTime)"></SfDateTimePicker>
                        <ValidationMessage For="@(() => appointment.EndTime)" />
                    </div>
                    <div class="my-5 flex flex-col gap-4 md:flex-row">
                        <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                            <InputCheckbox @bind-Value="@appointment.IsAllDay" class="h-6 w-6" />
                            <span class="ml-2 mt-0.5">Ganzer Tag</span>
                        </label>
                    </div>
                    <div class="my-5 flex flex-col gap-4 md:flex-row">
                        <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                            <InputCheckbox @bind-Value="@appointment.AlternativeColor" class="h-6 w-6" />
                            <span class="ml-2 mt-0.5">Alternative Farbe verwenden</span>
                        </label>
                    </div>
                    <div class="my-5 flex flex-col gap-4 md:flex-row">
                        <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                            <InputCheckbox @bind-Value="@appointment.ShowInWeek" class="h-6 w-6" />
                            <span class="ml-2 mt-0.5">Wochenkalender</span>
                        </label>
                        <label class="font-ptsans tracking-[0.375rem] flexrow flex items-center text-sm font-normal leading-tight text-black">
                            <InputCheckbox @bind-Value="@appointment.ShowInMonth" class="h-6 w-6" />
                            <span class="ml-2 mt-0.5">Monatskalender</span>
                        </label>
                    </div>
                    @if (!string.IsNullOrEmpty(appointment.CustomErrorMessage))
                    {
                        <div class="text-error" role="alert">@appointment.CustomErrorMessage</div>
                    }
                    <div>
                        <SfTextBox Placeholder="Beschreibung"
                                   FloatLabelType="FloatLabelType.Always"
                                   Multiline="true"
                                   @bind-Value="@(appointment.Description)"></SfTextBox>
                        <ValidationMessage For="@(() => appointment.Description)" />
                    </div>
                    <div>
                        <SfRecurrenceEditor @bind-Value="@(appointment.RecurrenceRule)"></SfRecurrenceEditor>
                    </div>
                </div>
            </EditorTemplate>
            <DateHeaderTemplate>
                <div class="font-yuji hidden text-center text-base font-normal md:block">@(getDateHeaderTextDay((context as TemplateContext).Date))</div>
                <div class="font-yuji text-center text-base font-normal md:hidden">@(getShortDateHeaderTextDay((context as TemplateContext).Date))</div>
                <div class="font-yuji hidden text-center text-sm font-normal md:block">@(getDateHeaderTextNumber((context as TemplateContext).Date))</div>
                <div class="font-yuji text-center text-sm font-normal md:hidden">@(getShortDateHeaderTextNumber((context as TemplateContext).Date))</div>
            </DateHeaderTemplate>
            <MonthHeaderTemplate>
                <div class="font-yuji hidden text-center text-base font-normal md:block">@(getDateHeaderTextDay((context as TemplateContext).Date))</div>
                <div class="font-yuji text-center text-base font-normal md:hidden">@(getShortDateHeaderTextDay((context as TemplateContext).Date))</div>
            </MonthHeaderTemplate>
        </ScheduleTemplates>
    </SfSchedule>
</div>

