<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Info"
      internalLogFile="logs/internal-nlog.txt">

	<extensions>
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<targets>
		<target xsi:type="File"
				name="logfile"
				fileName="logs/budoshuren-${shortdate}.log"
				layout="${longdate}|${uppercase:${level}}|${logger}|${aspnet-traceidentifier}|${message}${onexception:inner=|${exception:format=tostring}}" />

		<target xsi:type="Console"
				name="console"
				layout="${longdate}|${uppercase:${level}}|${logger}|${aspnet-traceidentifier}|${message}${onexception:inner=|${exception:format=tostring}}" />

		<target xsi:type="Null" name="blackhole" />

	</targets>

	<rules>
		<logger name="Microsoft.EntityFrameworkCore*" maxlevel="Info" writeTo="blackhole" final="true" />
		<logger name="Microsoft.AspNetCore*" maxlevel="Info" writeTo="blackhole" final="true" />
		<!-- Startmeldungen wie "Now listening on: https://..." auf Konsole und Datei. VS Code (F5) und dotnet watch
		     warten auf diese Zeile, bevor sie den Browser öffnen. Muss vor der Microsoft.Hosting*-Regel stehen. -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="logfile,console" final="true" />
		<logger name="Microsoft.Hosting*" maxlevel="Info" writeTo="blackhole" final="true" />
		<!-- Health Checks: "eingeschränkt" (Warn) nicht bei jedem Abruf von /health loggen, "ungesund" (Error) schon -->
		<logger name="Microsoft.Extensions.Diagnostics.HealthChecks*" maxlevel="Warn" writeTo="blackhole" final="true" />
		<logger name="Microsoft.Extensions*" maxlevel="Info" writeTo="blackhole" final="true" />

		<!-- BetterStack hängt Program.cs als weiteres Ziel an (BetterStackProtokoll), wenn Token und Endpoint konfiguriert sind -->
		<logger name="*" minlevel="Information" writeTo="logfile,console" />
	</rules>
</nlog>