<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Info"
      internalLogFile="logs/internal-nlog.txt">

	<extensions>
		<add assembly="BetterStack.Logs.NLog" />
		<add assembly="NLog.Web.AspNetCore" />
	</extensions>

	<targets>
		<target xsi:type="File"
				name="logfile"
				fileName="logs/budoshuren-${shortdate}.log"
				layout="${longdate}|${uppercase:${level}}|${logger}|${aspnet-traceidentifier}|${message}${onexception:inner=|${exception:format=tostring}}" />

		<target xsi:type="Console"
				name="console"
				layout="${longdate}|${uppercase:${level}}|${logger}|${aspnet-traceidentifier}|${message}${onexception:inner=|${exception:format=tostring}}" />

		<target xsi:type="BetterStack.Logs"
				name="betterstack"
				layout="${uppercase:${level}}|${logger}|${aspnet-traceidentifier}|${message}${onexception:inner=|${exception:format=tostring}}"
				sourceToken="***ENTFERNT***"
				endpoint="***ENTFERNT***" />

		<target xsi:type="Null" name="blackhole" />

	</targets>

	<rules>
		<logger name="Microsoft.EntityFrameworkCore*" maxlevel="Info" writeTo="blackhole" final="true" />
		<logger name="Microsoft.AspNetCore*" maxlevel="Info" writeTo="blackhole" final="true" />
		<logger name="Microsoft.Hosting*" maxlevel="Info" writeTo="blackhole" final="true" />
		<logger name="Microsoft.Extensions*" maxlevel="Info" writeTo="blackhole" final="true" />

		<logger name="*" minlevel="Information" writeTo="logfile,console,betterstack" />
	</rules>
</nlog>